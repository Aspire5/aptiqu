{
  "name": "aptiqu-backend",
  "version": "0.0.1",
  "description": "Aptiqu AI Tutor Backend API",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "seed:curriculum": "tsx src/modules/lesson/scripts/seed-curriculum.ts",
    "sync:curriculum": "node dist/runtime/sync-curriculum.js",
    "test": "node --import tsx --test src/security/tests/stage1.unit.cjs src/security/tests/stage2.unit.cjs src/security/tests/stage3.unit.cjs src/security/tests/resource-telemetry.unit.cjs src/security/tests/content-recovery.unit.cjs src/security/tests/content-import.unit.cjs src/modules/practice/tests/*.test.cjs src/modules/pvp/tests/*.test.cjs src/modules/pvp/tests/ranked-foundation.test.ts src/modules/ai/luna/tests/*.test.cjs",
    "test:practice": "node --test src/modules/practice/tests/practice-selection.test.cjs src/modules/practice/tests/practice-generation.test.cjs src/modules/practice/tests/practice-session.test.cjs",
    "test:home": "node --import tsx --test src/modules/home/tests/*.test.ts",
    "test:achievements": "node --import tsx --test src/modules/achievements/tests/*.test.ts",
    "test:social": "node --import tsx --test src/modules/social/tests/*.test.ts",
    "test:pvp": "node --import tsx --test src/modules/pvp/tests/*.test.ts src/modules/pvp/tests/*.test.cjs",
    "test:pvp:postgres": "node --import tsx --test src/modules/pvp/tests/ranked-postgres.integration.cjs",
    "test:pvp:redis": "node --import tsx --test src/modules/pvp/tests/ranked-redis.integration.cjs",
    "test:hardening:local": "node --test src/security/tests/stage1.integration.cjs src/security/tests/stage2.integration.cjs src/security/tests/stage3.integration.cjs",
    "test:hardening:http": "node --test src/security/tests/stage1.http.cjs src/security/tests/stage3.http.cjs",
    "verify:artifact": "node scripts/verify-artifact.cjs",
    "test:luna": "node --import tsx --test src/modules/ai/luna/tests/*.test.cjs"
  },
  "keywords": [
    "aptiqu",
    "education",
    "ai",
    "gamification"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.3.11",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "google-auth-library": "^9.15.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "pdf-parse": "^2.4.5",
    "ws": "^8.22.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.13.10",
    "@types/node-cron": "^3.0.11",
    "@types/pdf-parse": "^1.1.5",
    "@types/ws": "^8.18.1",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": "^22.23.3 || ^24.22.0"
  },
  "files": [
    "dist",
    "!dist/**/tests/**",
    "!dist/**/scripts/**",
    "prisma/schema.prisma",
    "prisma/changes",
    "README.md",
    ".env.example",
    ".nvmrc"
  ]
}
