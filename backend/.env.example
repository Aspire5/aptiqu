PORT=5001
NODE_ENV=production
DATABASE_URL="postgresql://aptiqu_user:YOUR_STRONG_PASSWORD@127.0.0.1:5432/aptiqu_db?connection_limit=5&pool_timeout=10&connect_timeout=3"

JWT_ACCESS_SECRET="replace_with_a_random_32_byte_access_key"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

REDIS_URL="redis://127.0.0.1:6379"

GOOGLE_WEB_CLIENT_ID="your_google_web_client_id.apps.googleusercontent.com"
GOOGLE_WEB_CLIENT_SECRET="your_google_web_client_secret"
GOOGLE_ANDROID_CLIENT_ID="your_google_android_client_id.apps.googleusercontent.com"
GOOGLE_IOS_CLIENT_ID="your_google_ios_client_id.apps.googleusercontent.com"

# Admin Dashboard
ADMIN_USERNAME="replace_with_admin_username"
ADMIN_PASSWORD="replace_with_a_unique_admin_password"
ADMIN_JWT_SECRET="replace_with_a_distinct_random_32_byte_admin_key"

# Stage 1 token claims. Access/admin signing keys MUST differ.
JWT_ISSUER=aptiqu
JWT_AUDIENCE=aptiqu-mobile
ADMIN_JWT_EXPIRATION=24h
# Comma-separated trusted proxy IPs/CIDRs only. Empty means direct connections.
TRUST_PROXY=

# Shared AI admission limits; reservations use conservative token bounds, not a currency estimate.
AI_GENERATION_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_BUDGET=0
AI_MAX_CONCURRENT=2
AI_REQUESTS_PER_MINUTE=12
AI_TOKENS_PER_DAY=1000000
AI_MAX_OUTPUT_TOKENS=16384
AI_TIMEOUT_MS=120000

# Stage 3 runtime. A combined process remains single-instance; no cluster activation.
BACKEND_ROLE=combined
HOST=127.0.0.1
# Include every process and planned HTTP reload overlap. These are examples,
# not measurements of the target server's available PostgreSQL connections.
DATABASE_CONNECTION_BUDGET=20
DATABASE_PROCESS_COUNT=3
GOOGLE_AUTH_ENABLED=true
# Browser origins only, comma-separated. Empty denies browser cross-origin access.
CORS_ALLOWED_ORIGINS=https://admin.example.invalid
AUTH_JSON_LIMIT_BYTES=24576
MOBILE_JSON_LIMIT_BYTES=81920
ADMIN_JSON_LIMIT_BYTES=8388608
READINESS_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=30000
HTTP_REQUEST_TIMEOUT_MS=300000
CONTENT_WORKER_CONCURRENCY=2
SOCIAL_WORKER_CONCURRENCY=20
QUEUE_FAILED_RETENTION_COUNT=500
QUEUE_FAILED_RETENTION_SECONDS=604800
# Absolute private persistent directories OUTSIDE the release checkout in production.
# Provision them yourself; no files or DB storage paths are relocated by this change.
BOOK_STORAGE_ROOT=/var/lib/aptiqu/books
BOOK_TEMP_ROOT=/var/lib/aptiqu/uploads
BOOK_UPLOAD_MAX_BYTES=157286400
BOOK_MAX_PAGES=2000
BOOK_MAX_EXTRACTED_TEXT_BYTES=33554432
BOOK_TEMP_RETENTION_HOURS=24
# Explicit operator source import only; never imported automatically on startup.
CURRICULUM_SOURCE_ROOT=/path/to/aptiqu/books/SubTopics
# Only combined/jobs owners import missing repository lessons, in the background.
CURRICULUM_SYNC_ON_STARTUP=true
LOCAL_CACHE_MAX_ENTRIES=256
LOCAL_CACHE_MAX_BYTES=8388608
LOG_LEVEL=info

# Existing Ranked behavior stays default-off; choose no launch season here.
RANKED_ADMISSION_ENABLED=false
RANKED_LEAGUES_READ_ENABLED=false
RANKED_SKILL_MATCHMAKING_ENABLED=false
RANKED_ADMISSION_DRAIN=false
RANKED_LAUNCH_SEASON=
# Required, distinct 32+ byte key when Ranked reads are enabled; no access-key fallback.
RANKED_CURSOR_SECRET=
RANKED_QUEUE_NARROW_WINDOW=100
RANKED_QUEUE_EXPAND_INTERVAL_MS=15000
RANKED_QUEUE_EXPAND_BY=50
RANKED_QUEUE_MAXIMUM_WINDOW=600
