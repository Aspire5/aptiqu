    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "Loan ₹1000 at 10%. After year 1, first-year interest = ₹100. If ₹600 principal is repaid then, ₹400 remains for year 2 and earns ₹40. Final due = 400 + 100 + 40 = ₹540.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
