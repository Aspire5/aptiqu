    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "If ₹1040 is repaid by five monthly instalments of ₹220, let annual rate be R. At month 5: 1040 + S.I. on 1040 for 5 months = 1100 + S.I. on ₹220 for 1+2+3+4 = 10 months. Solving gives R=24%.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
