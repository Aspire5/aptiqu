    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "If the final amount A is known, think of a growth factor: A = P × (1 + RT/100). Under simple interest, that factor is linear, not compounded.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_5_step"
        }
