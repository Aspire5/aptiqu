{
  "schemaVersion": "1.0",
  "scriptId": "sint-05-changing-rates-across-periods",
  "sourceType": "MANUAL",
  "metadata": {
    "title": "Changing Rates and Principal Across Time",
    "description": "Split multi-stage simple-interest problems into clean time blocks when rates or the outstanding principal change.",
    "teachingApproach": "Use a timeline of blocks rather than one oversized formula. For each block, name the active principal, rate, and duration, compute that block's interest, then combine. Include same-principal comparisons where the principal cancels and rate-change questions where only the difference in rates matters.",
    "targetDurationMinutes": 30,
    "sourceScope": "R.S. Aggarwal, Quantitative Aptitude for Competitive Examinations, Chapter 22, Simple Interest (printed pp. 641–662). Approved scope: Cover piecewise rates for different year ranges, rates that change each year, principal added or withdrawn midway, equal-amount comparisons with different rate-time schedules, and the shortcut for extra interest caused by a rate increase. Teach that each block is still simple interest on the active principal for that block; the results are added, not compounded."
  },
  "startNodeId": "start",
  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Changing Rates and Principal Across Time\n\nSplit multi-stage simple-interest problems into clean time blocks when rates or the outstanding principal change.\n\nWe will build the idea with small numbers first, then move into the exam-style patterns from the chapter.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "If the rate changes over time, simple interest is still calculated on the same principal unless the principal itself changes. Treat each time block separately and add the interests.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "₹10000 at 5% for 2 years gives ₹1000, then at 8% for 3 years gives ₹2400. Total S.I. = ₹3400.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
