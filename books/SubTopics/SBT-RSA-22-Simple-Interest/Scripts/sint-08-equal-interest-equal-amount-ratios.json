{
  "schemaVersion": "1.0",
  "scriptId": "sint-08-equal-interest-equal-amount-ratios",
  "sourceType": "MANUAL",
  "metadata": {
    "title": "Equal Interest and Equal Amount Ratios",
    "description": "Use PRT products and amount factors to compare investments designed to produce equal interest or equal maturity values.",
    "teachingApproach": "Contrast equal interest with equal final amount so learners do not mix the two. Use inverse-product reasoning first, then amount-factor reasoning. Keep the algebra visual: what must be equal, and which factors can cancel?",
    "targetDurationMinutes": 30,
    "sourceScope": "R.S. Aggarwal, Quantitative Aptitude for Competitive Examinations, Chapter 22, Simple Interest (printed pp. 641–662). Approved scope: Teach P1R1T1=P2R2T2 for equal simple interest, inverse RT principal ratios, equal-sum interest differences, three-scheme equal-interest ratios, and equal-final-amount problems using amount factors 1+RT/100. Include the chapter's algebraic relation y²=xz when successive interests are calculated under the same rate and time. End with multi-part equal-interest allocations."
  },
  "startNodeId": "start",
  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Equal Interest and Equal Amount Ratios\n\nUse PRT products and amount factors to compare investments designed to produce equal interest or equal maturity values.\n\nWe will build the idea with small numbers first, then move into the exam-style patterns from the chapter.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "Equal simple interest means the products P×R×T are equal. This is the master equation for comparing different investments.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "If one investment is at 10% for 5 years and another at 9% for 6 years, equal interest requires P1:P2 = (9×6):(10×5) = 54:50 = 27:25.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
    "q_1": {
      "id": "q_1",
      "type": "CHOICE",
      "content": {
        "text": "Equal S.I. is earned at 10% for 5 years and 9% for 6 years. What is P1:P2?",
        "avatarPersona": "TUTOR"
      },
      "input": {
        "type": "CHOICE",
        "options": [
          {
            "id": "a",
            "label": "27 : 25"
          },
          {
            "id": "b",
            "label": "25 : 27"
          },
          {
            "id": "c",
            "label": "10 : 9"
          },
          {
            "id": "d",
            "label": "6 : 5"
          }
        ]
      },
