    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "At one fixed rate, required time is proportional to required interest. If doubling needs one P of interest, trebling needs two P, so it takes twice as long.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "If a sum doubles in 8 years, it trebles in 16 years and becomes four times in 24 years.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
