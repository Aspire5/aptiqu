{
  "schemaVersion": "1.0",
  "scriptId": "sint-03-amount-differences-constant-yearly-interest",
  "sourceType": "MANUAL",
  "metadata": {
    "title": "Amount Differences and Constant Yearly Interest",
    "description": "Exploit the fact that simple-interest amounts rise by the same rupee amount every year to solve two-date questions quickly.",
    "teachingApproach": "Use a staircase mental model: every year adds the same rupee step. Start with reading the step size from two amounts, then rewind to principal, infer rate, and project forward. Questions should reward spotting the constant difference rather than plugging everything into PRT/100.",
    "targetDurationMinutes": 30,
    "sourceScope": "R.S. Aggarwal, Quantitative Aptitude for Competitive Examinations, Chapter 22, Simple Interest (printed pp. 641–662). Approved scope: Teach the linear-growth nature of simple interest: the difference between amounts at two times equals the interest for the gap. Use this to find one-year interest, principal, rate, and amounts at new times without repeatedly applying the full formula. Include proportional scaling across time, scaling to a new principal under the same rate-time conditions, and two-amount capstones that recover both principal and rate."
  },
  "startNodeId": "start",
  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Amount Differences and Constant Yearly Interest\n\nExploit the fact that simple-interest amounts rise by the same rupee amount every year to solve two-date questions quickly.\n\nWe will build the idea with small numbers first, then move into the exam-style patterns from the chapter.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "Under simple interest, the amount rises by the same number of rupees every year. So the difference between two amounts is exactly the interest earned during the time gap.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "If an amount is ₹7600 after 2 years and ₹8500 after 5 years, the 3-year increase is ₹900. Therefore yearly interest = ₹300.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
    "q_1": {
      "id": "q_1",
      "type": "CHOICE",
      "content": {
