    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "With the same principal and rate, a time difference creates a proportional interest difference.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "₹6000 at 10% earns ₹600 per year. Five years minus three years is a two-year gap, so the interest difference is ₹1200.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
