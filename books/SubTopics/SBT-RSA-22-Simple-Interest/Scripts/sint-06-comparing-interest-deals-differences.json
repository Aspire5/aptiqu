      "id": "teach_5_step",
      "type": "CONTENT",
      "content": {
        "text": "Borrow ₹5000 at 4% and lend it at 7% for 2 years. Rate gap = 3%, so gain = 5000×3%×2 = ₹300.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_5"
        }
      ]
    },
    "q_5": {
