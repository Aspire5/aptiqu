{
  "schemaVersion": "1.0",
  "scriptId": "sint-06-comparing-interest-deals-differences",
  "sourceType": "MANUAL",
  "metadata": {
    "title": "Comparing Interest Deals and Difference Shortcuts",
    "description": "Compare rates, times, principals, and borrowing/lending deals using proportionality instead of restarting the full calculation each time.",
    "teachingApproach": "Frame each question as a comparison: what stayed the same and what changed? Use that to cancel common pieces before calculating. Distractors should reflect common mistakes such as comparing rates alone or forgetting that time is common.",
    "targetDurationMinutes": 30,
    "sourceScope": "R.S. Aggarwal, Quantitative Aptitude for Competitive Examinations, Chapter 22, Simple Interest (printed pp. 641–662). Approved scope: Teach interest differences caused by rate changes or time changes, equal-interest conditions across different rate-time or principal-rate-time combinations, borrowing at one rate and lending at another, and recovering principal from a change in yearly income. Emphasise comparing the product P×R×T and cancelling common factors whenever possible."
  },
  "startNodeId": "start",
  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Comparing Interest Deals and Difference Shortcuts\n\nCompare rates, times, principals, and borrowing/lending deals using proportionality instead of restarting the full calculation each time.\n\nWe will build the idea with small numbers first, then move into the exam-style patterns from the chapter.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "With the same principal and time, the difference in S.I. comes only from the difference in rates.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "On ₹10000 for 3 years, 10% earns ₹600 more than 8% because the rate gap is 2%: extra = 10000×2×3/100 = ₹600.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
