    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "Sometimes the total and the overall rate are known, while one component rate is missing. Total interest gives the missing piece directly.",
        "avatarPersona": "TUTOR"
      },
