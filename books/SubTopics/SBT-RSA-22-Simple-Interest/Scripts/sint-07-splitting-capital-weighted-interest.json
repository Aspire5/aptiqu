    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "For equal interest over the same time, amount invested is inversely proportional to rate. Higher rate needs less principal to earn the same rupees.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
