    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "A weighted average rate is just total yearly interest divided by total capital. The overall rate must lie between the two component rates.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "₹7500 at 11% and ₹2500 at 15% earn ₹825 + ₹375 = ₹1200 on ₹10000 total, so the weighted rate is 12%.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
