      "input": {
        "type": "CHOICE",
        "options": [
          {
            "id": "a",
            "label": "₹6000"
          },
          {
            "id": "b",
            "label": "₹4000"
          },
          {
            "id": "c",
            "label": "₹8000"
          },
          {
            "id": "d",
            "label": "₹9000"
          }
        ]
      },
