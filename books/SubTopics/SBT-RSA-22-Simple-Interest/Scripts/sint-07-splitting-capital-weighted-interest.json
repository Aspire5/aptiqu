{
  "schemaVersion": "1.0",
  "scriptId": "sint-07-splitting-capital-weighted-interest",
  "sourceType": "MANUAL",
  "metadata": {
    "title": "Splitting Capital and Weighted Interest",
    "description": "Divide a total investment across different rates and use weighted-average reasoning to recover missing parts or rates.",
    "teachingApproach": "Begin with x and Total−x, then show the faster weighted-average picture. Use concrete yearly-interest totals so learners can see where each rupee comes from. Build toward multi-part ratios and overall-rate capstones.",
    "targetDurationMinutes": 30,
    "sourceScope": "R.S. Aggarwal, Quantitative Aptitude for Competitive Examinations, Chapter 22, Simple Interest (printed pp. 641–662). Approved scope: Teach two-part and three-part investment splits, total yearly income equations, weighted average rate, equal-interest deposit ratios, fixed-fraction allocations, unknown component rates, and alligation-style shortcuts for an overall rate. Emphasise that an overall rate is a weighted average and must lie between the component rates."
  },
  "startNodeId": "start",
  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Splitting Capital and Weighted Interest\n\nDivide a total investment across different rates and use weighted-average reasoning to recover missing parts or rates.\n\nWe will build the idea with small numbers first, then move into the exam-style patterns from the chapter.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "When one total sum is split between two rates, let one part be x and the other be Total−x. The two yearly interests must add to the given total income.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "₹10000 split between 5% and 8% gives ₹620 yearly. 5%x + 8%(10000−x)=620, which gives x=₹6000 at 5% and ₹4000 at 8%.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
    "q_1": {
      "id": "q_1",
      "type": "CHOICE",
      "content": {
        "text": "₹12000 is split between 6% and 9%. Total yearly interest is ₹900. How much is at 6%?",
