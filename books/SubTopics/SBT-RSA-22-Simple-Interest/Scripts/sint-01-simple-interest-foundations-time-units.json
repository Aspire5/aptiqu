    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "The formula P × R × T / 100 is just the same yearly-interest idea packed into one line. Mentally, it is often faster to find R% of P first, then multiply by T.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "₹7200 at 7.5% earns ₹540 in one year because 7.5% = 3/40 and 7200 × 3/40 = 540. That ₹540 repeats every year under simple interest.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
