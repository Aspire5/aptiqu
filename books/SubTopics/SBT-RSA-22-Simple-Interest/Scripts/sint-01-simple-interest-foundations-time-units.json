      "type": "CONTENT",
      "content": {
        "text": "₹9000 at 8% earns ₹720 in a full year. For 9 months, take only 3/4 of that: 720 × 3/4 = ₹540.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
