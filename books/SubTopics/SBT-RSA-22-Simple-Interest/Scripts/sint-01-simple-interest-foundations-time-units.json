    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "When time is given in months, convert it to the fraction of a year. Nine months is 9/12 = 3/4 year. Six months is 1/2 year.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
