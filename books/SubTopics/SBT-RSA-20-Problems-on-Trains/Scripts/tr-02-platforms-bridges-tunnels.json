    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "A pole crossing can make platform questions much faster. Suppose the same train crosses a pole in 8 s and a 240 m platform in 20 s.\n\nThe train's own length is present in both events. The extra 12 s is caused only by the extra 240 m platform.",
        "avatarPersona": "TUTOR"
