    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "Sometimes the object length is described relative to the train. If a platform is twice the train length, crossing distance is not 2L — it is L + 2L = 3L.",
        "avatarPersona": "TUTOR"
