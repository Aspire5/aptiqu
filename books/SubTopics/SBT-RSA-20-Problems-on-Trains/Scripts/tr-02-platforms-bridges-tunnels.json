    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "The same equation can reveal the platform length.\n\nA 120 m train at 54 km/hr moves at 15 m/s. In 20 s it covers 300 m while crossing a platform.\n\n300 = train 120 + platform\nSo platform = 180 m.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Mental pattern:\nobject length = speed × crossing time − train length\n\nYou are not subtracting because of a formula; you are removing the part of the total crossing distance occupied by the train itself.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
