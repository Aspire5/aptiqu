    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "If the platform is known instead, the train length is the leftover part.\n\nA train at 90 km/hr = 25 m/s crosses a 250 m platform in 20 s.\nTotal crossing distance = 25 × 20 = 500 m.\nTrain length = 500 − 250 = 250 m.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "This is the same picture viewed from the other side:\ntrain length = speed × time − object length.\n\nAlways identify which piece is already known before subtracting.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
