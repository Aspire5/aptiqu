    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Crossing time can also reveal the second speed.\n\nTwo trains total 360 m and clear each other in 12 s, so their relative speed is 30 m/s = 108 km/hr. If one moves at 72 km/hr, the other contributes 36 km/hr.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "Opposite directions mean the relative speed is a sum.\n\nother speed = relative speed − known speed.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
