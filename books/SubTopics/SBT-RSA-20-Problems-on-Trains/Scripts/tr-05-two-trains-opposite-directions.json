    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "If one train length is unknown, crossing time gives the total length.\n\nA 200 m train at 72 km/hr crosses an opposite train at 54 km/hr in 12 s. Relative speed = 126 km/hr = 35 m/s.\nTotal length = 35 × 12 = 420 m.\nOther train = 220 m.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "The order matters:\n1. get relative speed;\n2. speed × time gives both lengths together;\n3. subtract the known length.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
