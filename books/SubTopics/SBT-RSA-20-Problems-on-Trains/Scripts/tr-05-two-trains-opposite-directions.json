    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "Equal trains make the symmetry obvious. Two 120 m trains cross in 12 s while moving oppositely at equal speeds.\n\nTogether they must cover 240 m at 20 m/s relative speed. If their speeds are equal, each contributes 10 m/s = 36 km/hr.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "The relative speed is split equally only because the question says the speeds are equal.\n\nWithout that condition, the sum alone cannot tell the two individual speeds.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
