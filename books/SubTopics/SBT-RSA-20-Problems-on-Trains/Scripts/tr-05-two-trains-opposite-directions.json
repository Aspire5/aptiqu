    "teach_7": {
      "id": "teach_7",
      "type": "CONTENT",
      "content": {
        "text": "Pole times can predict how equal-length trains cross each other. If both trains have length L, and they take 10 s and 15 s to cross poles, their speeds are L/10 and L/15.\n\nOpposite relative speed = L/10 + L/15 = L/6.\nDistance = 2L.\nTime = 2L ÷ (L/6) = 12 s.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_7_step"
        }
      ]
    },
    "teach_7_step": {
      "id": "teach_7_step",
      "type": "CONTENT",
      "content": {
        "text": "The unknown length cancels completely. This is a powerful pattern: if every term contains the same L, cancel it before inserting numbers.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_7"
        }
      ]
    },
