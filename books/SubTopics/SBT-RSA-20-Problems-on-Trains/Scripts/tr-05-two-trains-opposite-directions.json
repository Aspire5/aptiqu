    "teach_8": {
      "id": "teach_8",
      "type": "CONTENT",
      "content": {
        "text": "A final relative-distance idea: two opposite trains start 120 km apart. They meet after their relative motion covers 120 km. If they keep going until they are 120 km apart again, relative motion has covered another 120 km after the meeting.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_8_step"
        }
