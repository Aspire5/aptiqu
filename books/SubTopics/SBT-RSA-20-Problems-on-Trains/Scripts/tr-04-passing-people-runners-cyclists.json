    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Opposite directions make the train and person close the gap faster. Now relative speed is the sum.\n\nA 180 m train at 60 km/hr meets a runner at 12 km/hr coming the other way.\nRelative speed = 72 km/hr = 20 m/s, so time = 9 s.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Memory hook:\nsame direction → subtract\nopposite direction → add\n\nThe distance for a point-like person is still just the train length.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
