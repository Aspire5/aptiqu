    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "For opposite motion, reverse the sum.\n\nA 240 m train passes a runner coming toward it in 12 s. Relative speed = 20 m/s = 72 km/hr. If the runner moves at 8 km/hr, then train speed = 72 − 8 = 64 km/hr.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "A useful sanity check: the train's own speed must be lower than the opposite-direction relative speed because the runner contributes part of that closing speed.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
