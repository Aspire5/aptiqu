    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "A crossing time can reveal the train speed.\n\nA 150 m train passes a walker at 6 km/hr in the same direction in 10 s. Relative speed = 150/10 = 15 m/s = 54 km/hr.\nSo train speed = 54 + 6 = 60 km/hr.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "The direction tells you how to reverse the relative-speed equation.\n\nSame direction: train = relative + walker.\nOpposite direction: train = relative − walker.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
