    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "Full-route travel times can give a meeting time without knowing the distance. Suppose one train would cover the route alone in 2 hours and the other in 3 hours.\n\nIn one hour they cover 1/2 and 1/3 of the route. Together they close 5/6 of the route per hour.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "Meeting time = 1 ÷ (5/6) = 6/5 h = 1 h 12 min.\n\nThis is the same closing-speed idea measured in 'routes per hour' instead of km/hr.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
