    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "A delayed start creates a head start. Train A leaves at 7 a.m. at 20 km/hr; train B leaves the opposite station at 8 a.m. at 25 km/hr. The stations are 110 km apart.\n\nBy 8 a.m., A has already covered 20 km, so only 90 km remains between them.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "From 8 a.m. onward they close at 20 + 25 = 45 km/hr.\n90/45 = 2 hours.\nSo they meet at 10 a.m.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
