    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Equal-length trains create another clean cancellation. Suppose train A crosses a pole in 6 s and train B in 9 s. Let each length be L.\n\nSpeeds are L/6 and L/9. Opposite crossing distance is 2L, so time = 2L ÷ (L/6 + L/9).\n",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "L cancels:\n2 ÷ (1/6 + 1/9) = 2 ÷ (5/18) = 36/5 = 7.2 s.\n\nThe actual train length never matters.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
