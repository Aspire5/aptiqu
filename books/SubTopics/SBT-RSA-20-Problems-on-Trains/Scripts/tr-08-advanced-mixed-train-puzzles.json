      "id": "teach_8_step",
      "type": "CONTENT",
      "content": {
        "text": "If the train is then made 50% longer but keeps the same speed and crosses that same platform, new total distance is 1.5L + 2L = 3.5L.\nOriginal speed = L/15.\nNew time = 3.5L ÷ (L/15) = 52.5 s.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_8"
        }
      ]
    },
