    },
    "teach_7_step": {
      "id": "teach_7_step",
      "type": "CONTENT",
      "content": {
        "text": "speed sum / speed difference = 60/12 = 5.\nSo (u+v)/(u−v)=5, giving u:v=3:2.\n\nThis shortcut is pure structure: no lengths, no conversion, no extra data.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_7"
        }
      ]
    },
