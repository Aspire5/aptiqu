    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "Train length often scales with bogie count. If two identical 12-bogie trains cross in 120 s and one grows to 16 bogies, speeds stay the same but combined length changes from 24 bogies to 28 bogies.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "Crossing time scales with combined length:\nnew time = 120 × 28/24 = 140 s.\nExtra time = 20 s.\n\nNo individual bogie length is needed because it cancels.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
