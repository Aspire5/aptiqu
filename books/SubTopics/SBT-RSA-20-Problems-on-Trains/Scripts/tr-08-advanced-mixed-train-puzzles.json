    "teach_7": {
      "id": "teach_7",
      "type": "CONTENT",
      "content": {
        "text": "The same two trains may be tested in both directions. If they need 60 s to overtake in the same direction and 12 s to cross in opposite directions, the common sum of train lengths cancels.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_7_step"
        }
