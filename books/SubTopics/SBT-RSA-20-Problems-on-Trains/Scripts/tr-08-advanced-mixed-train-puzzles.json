    "teach_8": {
      "id": "teach_8",
      "type": "CONTENT",
      "content": {
        "text": "Final shortcut: same-speed events should make you compare times before calculating metres. Suppose a train crosses a pole in 15 s and a platform in 45 s. The whole platform event covers three train-lengths, so the platform itself is two train-lengths.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
