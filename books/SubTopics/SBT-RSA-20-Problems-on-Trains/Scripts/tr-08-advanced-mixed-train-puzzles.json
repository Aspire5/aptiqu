    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "A platform described as a multiple of train length can be handled in one ratio step.\n\nIf platform = 3L, then complete crossing distance = 4L. So platform-crossing time is four times pole-crossing time at the same speed.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "This works in reverse too. If a train takes 8 s at a pole and 32 s at a platform, total distance is 4L, so the platform must be 3L.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
