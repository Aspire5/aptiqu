    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Pole time gives the train length once speed is known.\n\nA train crosses a pole in 10 s and a 200 m platform in 20 s. Extra 200 m takes 10 s, so speed = 20 m/s.\nTrain length = 20 × 10 = 200 m.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "Notice the symmetry: if platform time is exactly double pole time, the platform length equals the train length.\n\nThat shortcut comes from equal extra time and original time at the same speed.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
