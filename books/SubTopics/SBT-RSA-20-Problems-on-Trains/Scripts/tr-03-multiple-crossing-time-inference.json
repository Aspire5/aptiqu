    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "A stationary train is just another long stationary object. Suppose train A is 180 m and crosses a pole in 9 s. Its speed is 20 m/s.\n\nIf A takes 21 s to cross stationary train B, total distance = 20 × 21 = 420 m.\nSo B = 420 − 180 = 240 m.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_5_step"
        }
      ]
    },
    "teach_5_step": {
      "id": "teach_5_step",
      "type": "CONTENT",
      "content": {
        "text": "The word 'stationary' matters. There is no relative-speed subtraction or addition; only train A is moving.\n\nTreat B exactly like a platform whose length you do not know.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_5"
        }
      ]
    },
