    "teach_8_step": {
      "id": "teach_8_step",
      "type": "CONTENT",
      "content": {
        "text": "Do not solve all unknowns at once. Let each observation unlock the next one:\npole + platform → speed\nspeed + pole → own length\nstationary-train time → other length.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_8"
        }
      ]
