    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Two platforms work the same way. Suppose crossing 100 m takes 15 s and crossing 220 m takes 21 s.\n\nThe train itself is unchanged. So the extra 120 m accounts for the extra 6 s: speed = 20 m/s.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Now the first event covered 15 × 20 = 300 m in total.\nTrain length = 300 − 100 = 200 m.\n\nThis is often faster than solving simultaneous equations.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
