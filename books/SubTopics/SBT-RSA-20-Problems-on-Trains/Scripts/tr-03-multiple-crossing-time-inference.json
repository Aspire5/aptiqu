    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "If the stationary train has the same length, the distance doubles.\n\nA train that crosses a pole in 8 s will take 16 s to cross a stationary train of equal length at the same speed.",
        "avatarPersona": "TUTOR"
