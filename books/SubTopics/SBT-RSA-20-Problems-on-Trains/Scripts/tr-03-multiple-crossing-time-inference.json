    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "Sometimes the question asks only for speed. Two platform observations can give it immediately.\n\nIf 160 m takes 18 s and 280 m takes 24 s, then 120 extra metres take 6 extra seconds.\nSpeed = 20 m/s = 72 km/hr.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "This is an elimination shortcut: the unknown train length appears in both total distances and cancels when you subtract.\n\nOnly convert to km/hr at the end.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
