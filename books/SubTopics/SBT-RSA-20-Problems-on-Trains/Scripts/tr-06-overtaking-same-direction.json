    "teach_7": {
      "id": "teach_7",
      "type": "CONTENT",
      "content": {
        "text": "The same pair of trains may be tested in both directions. Let total train length be S.\n\nIf same-direction crossing takes 60 s, speed difference = S/60.\nIf opposite-direction crossing takes 12 s, speed sum = S/12 = 5S/60.\nSo (u+v)/(u−v) = 5.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_7_step"
        }
      ]
    },
    "teach_7_step": {
      "id": "teach_7_step",
      "type": "CONTENT",
      "content": {
        "text": "Solve the ratio without ever knowing S:\nu + v = 5u − 5v\n4u = 6v\nu : v = 3 : 2.\n\nCommon distance cancels — only the time ratio matters.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_7"
        }
      ]
    },
