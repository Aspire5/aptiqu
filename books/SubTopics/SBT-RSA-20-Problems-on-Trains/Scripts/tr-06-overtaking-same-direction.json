    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "A head start is just extra distance to gain. Suppose the faster train's front is 250 m behind the slower train's rear. If the trains are 100 m and 150 m long, complete overtaking needs 250 + 100 + 150 = 500 m of relative gain.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_6_step"
        }
