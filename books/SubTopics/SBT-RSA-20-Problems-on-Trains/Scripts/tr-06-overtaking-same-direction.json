    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "If the faster speed is unknown, the crossing time gives the speed difference.\n\nTwo trains total 300 m and overtake in 20 s, so relative speed = 15 m/s = 54 km/hr. If the slower train is 54 km/hr, the faster is 108 km/hr.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Same direction reverses cleanly:\nfaster speed = slower speed + relative speed.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
