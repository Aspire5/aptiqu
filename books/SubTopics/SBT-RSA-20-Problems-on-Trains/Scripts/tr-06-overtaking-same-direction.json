          "targetNodeId": "teach_5_step"
        }
      ]
    },
    "teach_5_step": {
      "id": "teach_5_step",
      "type": "CONTENT",
      "content": {
        "text": "This is why 'start together' does not mean the faster train has already crossed. Complete crossing means its rear has cleared the slower train's front.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_5"
        }
      ]
    },
