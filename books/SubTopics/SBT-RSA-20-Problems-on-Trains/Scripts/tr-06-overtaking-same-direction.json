    },
    "teach_6_step": {
      "id": "teach_6_step",
      "type": "CONTENT",
      "content": {
        "text": "At a 10 m/s speed difference, that takes 50 s.\n\nThe phrase 'front is behind rear' makes the gap unambiguous: add the empty gap and both train lengths.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
        }
      ]
    },
