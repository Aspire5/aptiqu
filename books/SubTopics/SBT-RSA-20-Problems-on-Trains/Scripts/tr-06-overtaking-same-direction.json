    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "Equal train lengths can be recovered from overtaking time.\n\nIf equal trains differ in speed by 18 km/hr = 5 m/s and fully overtake in 40 s, total relative distance is 5 × 40 = 200 m.\nThat is two equal train lengths, so each train is 100 m.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "The sum-of-lengths rule still applies even when the lengths are equal. Equal simply lets you split the total in half.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
