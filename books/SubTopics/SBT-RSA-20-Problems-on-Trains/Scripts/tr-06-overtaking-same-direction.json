    "teach_8": {
      "id": "teach_8",
      "type": "CONTENT",
      "content": {
        "text": "A train overtaking two walkers gives two equations with the same train length. Suppose walkers move at 1 m/s and 2 m/s and the train passes them in 10 s and 12 s.\n\nL = 10(v−1) = 12(v−2).\nSo 10v−10 = 12v−24 → v = 7 m/s, and L = 60 m.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_8_step"
        }
      ]
    },
