    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "You can also find the slower speed.\n\nIf two trains total 300 m and the faster overtakes in 24 s, relative speed = 12.5 m/s = 45 km/hr.\nIf the faster train moves at 90 km/hr, slower = 90 − 45 = 45 km/hr.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "Sanity check: the slower train must be positive and lower than the faster one. If your subtraction gives the opposite, you have swapped the roles.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
