    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "If two trains start together from the same point, the faster one's front is not yet 'past' the slower train completely. It must gain both train lengths.\n\nTwo 150 m trains at 72 and 54 km/hr have relative speed 5 m/s and total gain needed 300 m, so complete overtaking takes 60 s.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
