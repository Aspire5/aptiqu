    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "A fast-looking number becomes simple after unit conversion.\n\n162 km/hr = 45 m/s.\nSo a 225 m train at that speed clears a pole in 225 ÷ 45 = 5 seconds.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_5_step"
        }
      ]
    },
    "teach_5_step": {
      "id": "teach_5_step",
      "type": "CONTENT",
      "content": {
        "text": "Mental shortcut: when the km/hr number is divisible by 18, divide first and multiply by 5.\n\n162 ÷ 18 = 9, and 9 × 5 = 45. That is much easier than multiplying 162 by 5 first.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_5"
        }
      ]
    },
