    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Train questions switch units constantly. The safest mental bridge is:\n\nkm/hr → m/s: multiply by 5/18\nm/s → km/hr: multiply by 18/5\n\nNotice 72 km/hr becomes 20 m/s because 72 ÷ 18 = 4, then 4 × 5 = 20.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "The conversion is not decoration. Lengths are usually in metres and crossing times in seconds, so the speed must usually be in m/s before you divide.\n\nA quick check: m/s should be a smaller number than the same speed in km/hr.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
