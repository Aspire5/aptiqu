    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "The reverse is just as direct. If a 150 m train clears a pole in 10 s, it covers 150 m in 10 s.\n\nSpeed = 150 ÷ 10 = 15 m/s\n= 15 × 18/5 = 54 km/hr.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "Keep the two stages separate:\n1. metres ÷ seconds gives m/s;\n2. only then convert to km/hr if the answer asks for it.\n\nThat prevents the common mistake of reporting 15 as 15 km/hr.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
