    "teach_7_step": {
      "id": "teach_7_step",
      "type": "CONTENT",
      "content": {
        "text": "Memory hook: gaps + 1 = posts, when you count the post at the start and the post at the end.\n\nThis is the same fence-post idea used in many aptitude questions.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_7"
        }
      ]
    },
