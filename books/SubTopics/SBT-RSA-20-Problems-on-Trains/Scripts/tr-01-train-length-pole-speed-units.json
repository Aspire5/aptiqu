    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Sometimes the time is given and the train length is hidden. The same picture works backwards.\n\nIf a train at 90 km/hr crosses a pole in 8 s, its speed is 25 m/s.\nIn 8 s it moves 25 × 8 = 200 m.\nThat movement is exactly its length.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "So for a pole crossing:\n\ntrain length = speed × crossing time\n\nThe useful habit is to convert speed first, then multiply. No extra formula is needed.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
