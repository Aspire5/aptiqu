    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "To find a total, write every age. Suppose three children are four years apart and the youngest is 6.\n\nTheir ages are 6, then 6 + 4 = 10, then 10 + 4 = 14.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Total = 6 + 10 + 14 = 30.\n\nCheck that the two gaps are 4 and 4. Avoid multiplying the youngest age by three: the children are not all the same age.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
