    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "A gap does not grow as two siblings grow. Suppose their ages today are 23 and 19.\n\nTheir gap is 23 − 19 = 4 years.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "Ten years later they will be 33 and 29.\n\nThe gap is still 33 − 29 = 4. Both gained ten, so the added years cancel when we subtract. Use this fact without needing their exact current ages.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
