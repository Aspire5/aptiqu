    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "An age can sit exactly halfway between two others. Suppose B is 16 and C is 40. A is as much older than B as C is older than A.\n\nSo the two gaps are equal: B → A → C.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "The whole gap is 40 − 16 = 24.\n\nEach half is 24 ÷ 2 = 12, so A = 16 + 12 = 28.\n\nCheck both sides: 28 − 16 = 12 and 40 − 28 = 12. A is the middle age.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
