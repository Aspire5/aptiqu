    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "Squaring can hide a negative solution. Suppose a person's age squared is 196.\n\nBoth 14 × 14 and (−14) × (−14) equal 196.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "The equation age² = 196 has two number solutions: 14 and −14.\n\nA present age cannot be negative, so the age is 14. When a quadratic gives two roots, use the story to decide which roots are possible.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
