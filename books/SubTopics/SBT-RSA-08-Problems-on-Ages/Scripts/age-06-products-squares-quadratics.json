    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "A gap can replace a sum. Suppose two ages differ by 3 and multiply to 180.\n\nCall the younger age x; the older is x + 3. Their product is x(x + 3) = 180.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Try nearby factors of 180: 12 and 15 differ by 3.\n\nSo x = 12 and x + 3 = 15.\nCheck: 12 × 15 = 180 and 15 − 12 = 3. In a written equation, x² + 3x − 180 = 0 gives the same pair; keep only a possible age.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
