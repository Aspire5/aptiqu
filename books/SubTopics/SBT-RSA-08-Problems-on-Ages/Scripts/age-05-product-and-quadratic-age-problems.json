    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "A fixed age gap plus a product also gives one variable.\n\nIf older is 8 years more than younger, let younger=x and older=x+8.\nProduct = x(x+8).",
        "avatarPersona": "TUTOR"
