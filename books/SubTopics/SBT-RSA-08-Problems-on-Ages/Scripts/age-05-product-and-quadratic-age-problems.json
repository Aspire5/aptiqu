    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "If you know the sum and product of two ages, look for factor pairs.\n\nSum = 35, product = 300.\nWhich pair multiplies to 300 and adds to 35?\n15 and 20.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "That mental factor-pair search is faster than building a full quadratic when the numbers are friendly.\n\nCheck both clues before choosing the pair.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
