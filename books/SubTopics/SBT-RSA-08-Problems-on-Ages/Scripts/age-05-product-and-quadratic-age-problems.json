    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "A dated product must use the ages at that date.\n\nToday a father and son total 50. Five years ago their age product was 144. Let father=x and son=50−x.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "Five years ago their ages were x−5 and 45−x. So:\n(x−5)(45−x)=144\nx²−50x+369=0\n(x−41)(x−9)=0\n\nThe present ages are 41 and 9. Check five years ago: 36×4=144. Shift the ages first, then multiply.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
