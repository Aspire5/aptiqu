{
  "schemaVersion": "1.0",
  "scriptId": "age-06-group-totals-intervals-multi-person",
  "sourceType": "MANUAL",
  "metadata": {
    "title": "Group Totals, Age Intervals, and Multi-Person Problems",
    "description": "Track several ages together using total-age shifts, equal birth intervals, past ratios, and staged group changes.",
    "teachingApproach": "Use short, connected phone-sized teaching screens with a concrete age situation before the equation, label every past/present/future date clearly, show the reason for each age shift, and check the result in the original clue. After each worked example, give a fresh near-transfer question. Wrong answers receive a misconception-specific correction and a parallel retry.",
    "targetDurationMinutes": 31,
    "sourceScope": "R.S. Aggarwal, Quantitative Aptitude for Competitive Examinations, Chapter 8, Problems on Ages. Approved scope: Teach multi-person age models by tracking total age. Show that for the same n people, a t-year shift changes the total by n×t. Use this to connect past totals with present ratios, solve ages spaced at equal birth intervals, interpret ratios stated at a past date, use midpoint language such as 'as much younger as older', and convert an average age into a total when a person joins. For multi-stage stories, update the original group first, then add or remove people at the correct date. Keep group membership and dates explicit throughout."
  },
  "startNodeId": "start",
  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "With three or more people, the easiest object to track is often the total age. Every birthday adds one year per person, so a group total moves in a predictable way.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "Three people are 12, 18, and 25. Their total age is 55.\n\nFour years later, each is 4 years older. The total rises by 3×4=12, becoming 67.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "Group rule:\n\nNew total = old total + (number of people × years)\n\nFor a past date, subtract that group increase instead.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
