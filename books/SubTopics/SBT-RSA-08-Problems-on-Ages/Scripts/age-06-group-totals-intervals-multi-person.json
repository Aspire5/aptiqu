    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "'As much younger as older' makes one age the midpoint.\n\nRahul is as much younger than Sagar as he is older than Purav.\nThat means:\nSagar − Rahul = Rahul − Purav.",
        "avatarPersona": "TUTOR"
