    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "A ratio of three present ages plus a past total is a two-step problem.\n\nSuppose A:B:C=2:3:5. Eight years ago their total was 56.\nToday’s total is 56 + 3×8 = 80.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
