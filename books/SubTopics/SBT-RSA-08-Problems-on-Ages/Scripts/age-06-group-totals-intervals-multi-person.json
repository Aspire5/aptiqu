    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "If their total is 50:\n5x + 30 = 50\n5x = 20\nx = 4\n\nThe youngest is 4. The fixed interval appears four times across the five ages.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
