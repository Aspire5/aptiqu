    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "A past group total can be moved to today.\n\nFour people totaled 80 years six years ago.\nToday those same four people total:\n80 + 4×6 = 104.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "The phrase 'same four people' matters. If someone joins, leaves, is born, or dies, the group count changes and must be handled in separate stages.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
