    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "Children born at equal intervals form an arithmetic age pattern.\n\nFive children are born 3 years apart. If the youngest is x, their ages are:\nx, x+3, x+6, x+9, x+12.",
        "avatarPersona": "TUTOR"
