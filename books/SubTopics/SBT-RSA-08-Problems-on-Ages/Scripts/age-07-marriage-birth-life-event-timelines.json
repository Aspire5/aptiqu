    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "A marriage-age ratio is a ratio at the wedding date, not today.\n\nSuppose today a couple is 32 and 24. If they married y years ago, their wedding ages were 32−y and 24−y.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_5_step"
        }
      ]
    },
    "teach_5_step": {
      "id": "teach_5_step",
