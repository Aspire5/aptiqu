    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "A parent’s age when a child was born gives a permanent age gap.\n\nIf a father was 38 when his daughter was born, he is always 38 years older than her.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "If the daughter is 12 today, father is 50 today.\n\nYou do not need to rebuild the timeline every time; the age difference stays fixed.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
