    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Birth gaps between siblings can connect the parents too.\n\nSuppose a father was 38 when an older child was born. A younger sibling is born 4 years later. At that second birth, the father is 42.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "If the mother was 36 at the younger sibling’s birth, the parents differ by 6 years.\n\nMove everyone to the same birth event before comparing.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
