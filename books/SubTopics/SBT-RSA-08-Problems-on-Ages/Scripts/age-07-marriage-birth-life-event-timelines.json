    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "Sometimes a child is born a fixed number of years after marriage.\n\nIf a couple married 8 years ago and their child was born 2 years after marriage, the child is 6 today.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "Marriage → 2 years pass → birth → 6 more years → today.\n\nBreak the timeline into intervals rather than mixing them into one equation.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
