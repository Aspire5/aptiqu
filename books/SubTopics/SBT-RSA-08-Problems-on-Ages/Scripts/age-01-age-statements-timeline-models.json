    "teach_6_step": {
      "id": "teach_6_step",
      "type": "CONTENT",
      "content": {
        "text": "Add the two expressions:\n\n(y + 3) + (y + 3) = 2y + 6\n\nThere are two copies of the three-year increase, so we add 6 in all. If y = 10, the later ages are 13 and 13; their total is 26, which matches 2(10) + 6.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
        }
      ]
    },
