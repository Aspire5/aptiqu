    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "One person was easy to move along the timeline. A future age works the same way for anyone.\n\nSara is 21 today. Four years later, four birthdays have passed, so she will be older.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Sara's age in four years:\n\n21 + 4 = 25\n\nCheck by moving back: 25 − 4 = 21.\n\nThe phrase “years hence” also means years from now. It asks you to move forward, not backward.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
