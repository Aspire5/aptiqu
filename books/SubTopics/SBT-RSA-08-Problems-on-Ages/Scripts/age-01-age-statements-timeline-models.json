    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "The same group idea works when an age is written with a letter.\n\nTwo people are each y years old today. Three years later, each one is y + 3. Their combined age is:\n\n(y + 3) + (y + 3)",
