    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "When a three-person ratio and a total are known, count all the parts. Suppose ages are 1:2:3 and total 60.\n\nThere are 1 + 2 + 3 = 6 equal parts.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "One part = 60 ÷ 6 = 10.\n\nThe ages are 10, 20, and 30. Check: 10 + 20 + 30 = 60. To find the youngest in the next question, multiply one part by the youngest ratio number.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
