    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "A past clue means subtract years from both ages. Suppose a mother is three times her daughter's age today.\n\nWrite daughter = x, mother = 3x. Five years ago they were x − 5 and 3x − 5.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "If mother was four times daughter then:\n3x − 5 = 4(x − 5)\n3x − 5 = 4x − 20\nx = 15.\n\nToday: daughter 15, mother 45. Five years ago: 10 and 40. Check 40 = 4 × 10. Keep the subtraction inside the brackets.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
