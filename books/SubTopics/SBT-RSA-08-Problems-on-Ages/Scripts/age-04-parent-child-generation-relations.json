    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "Sometimes we know both current ages and must find the time. A parent is 42 and a child is 14 today.\n\nIn t years their ages will be 42 + t and 14 + t.",
