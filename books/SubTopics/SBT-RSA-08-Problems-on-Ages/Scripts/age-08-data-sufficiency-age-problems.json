    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Either statement can sometimes solve the question on its own.\n\nQuestion: Find x.\nI: x−5=20.\nII: x/2=12.5.\n\nEach independently gives x=25.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "That is stronger than 'both together'. If I alone works and II alone also works, the correct sufficiency description is: either statement alone is sufficient.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
