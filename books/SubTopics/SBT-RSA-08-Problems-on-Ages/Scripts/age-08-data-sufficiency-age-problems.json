    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Sometimes one statement alone does fix the answer.\n\nQuestion: What is A’s age?\nI: A is 5 years older than B.\nII: A=24.\n\nStatement II alone directly answers the question.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Do not combine statements automatically. Test I alone, then II alone. If II already gives the unique answer, I is unnecessary.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
