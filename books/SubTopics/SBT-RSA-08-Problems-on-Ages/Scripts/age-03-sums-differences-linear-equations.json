    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "A total also changes when time passes. Suppose three people have a combined age of 72 today.\n\nFour years later, each person gains four years. The total gains 4 + 4 + 4 = 12 years.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "New total:\n72 + 3 × 4 = 84.\n\nCount the people before multiplying. Two people would add 8, while three add 12. Now try this with a different total and time.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
