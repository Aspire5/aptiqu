    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "A ratio can turn a total into individual ages. Suppose the older age is three times the younger, and together they total 64.\n\nCall the younger age one equal part. The older age is three such parts.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "Together there are 1 + 3 = 4 parts.\n\nOne part = 64 ÷ 4 = 16.\nYounger: 16\nOlder: 3 × 16 = 48\n\nCheck: 16 + 48 = 64. For the next question, find the size of one part before naming the age.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
