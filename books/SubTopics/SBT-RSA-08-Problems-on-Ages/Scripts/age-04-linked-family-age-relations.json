    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Once a three-person ratio is ready, a total fixes the size of one part.\n\nSuppose ages are 2:3:5 and total 50.\nTotal parts = 10, so one part = 50 ÷ 10 = 5.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "The ages are 10, 15, and 25.\n\nCheck: 10 + 15 + 25 = 50.\n\nRatio gives the shape; total gives the scale.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
