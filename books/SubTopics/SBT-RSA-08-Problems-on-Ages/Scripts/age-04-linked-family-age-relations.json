    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Two ratios can share a person.\n\nA : B = 3 : 5\nB : C = 2 : 3\n\nThe B-parts must match before we join them.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Make B equal to 10 parts.\n\nA : B = 6 : 10\nB : C = 10 : 15\n\nSo A : B : C = 6 : 10 : 15.\n\nThink of B as the bridge between the two ratios.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
