    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "A difference can fix the scale too.\n\nSuppose A:B:C = 3:6:7 and C is 12 years older than B.\nThe ratio gap is 1 part, so 1 part = 12 years.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "Then A=36, B=72, C=84.\n\nYou do not need the total when a known age gap matches a ratio gap.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
