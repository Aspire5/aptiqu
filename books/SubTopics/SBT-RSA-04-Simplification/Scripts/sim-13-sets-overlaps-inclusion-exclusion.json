      "content": {
        "text": "Let's learn sets, overlaps and inclusion-exclusion.\n\nThis lesson uses the methods and question patterns from the Simplification chapter.\n\nWe will keep each step small: understand one rule, see it with numbers, then try a similar question.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "concept_1"
        }
      ]
