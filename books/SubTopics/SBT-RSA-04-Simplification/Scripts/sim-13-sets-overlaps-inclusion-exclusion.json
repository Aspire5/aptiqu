    "concept_3": {
      "id": "concept_3",
      "type": "CONTENT",
      "content": {
        "text": "To find neither, first find the union, then subtract it from the total group.\n\nNeither = Total - n(A∪B).\n\nDo not subtract A and B separately without correcting the overlap.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
