    "concept_1": {
      "id": "concept_1",
      "type": "CONTENT",
      "content": {
        "text": "For two sets, the chapter gives:\n\nn(A∪B)=n(A)+n(B)-n(A∩B).\n\nWe subtract the overlap once because it was counted once in A and once again in B.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
