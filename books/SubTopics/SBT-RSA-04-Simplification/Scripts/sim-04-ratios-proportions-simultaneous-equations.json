    "concept_2": {
      "id": "concept_2",
      "type": "CONTENT",
      "content": {
        "text": "Chained ratios can be combined by multiplying the equal fractions.\n\nIf a/b = 4/5 and b/c = 15/16, then a/c = (4/5)(15/16)=3/4.\n\nThis avoids solving for b separately.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
