    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "The book mixes ratios with equations:\n\n3x/2y = 21/22 and 4x + 5y = 83\n\nClean the ratio first:\n\nx/y = 21/22 × 2/3 = 42/66 = 7/11",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
