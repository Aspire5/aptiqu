    "concept_4": {
      "id": "concept_4",
      "type": "CONTENT",
      "content": {
        "text": "Large squares or cubes may hide an identity.\n\nIf you see A^2-B^2, factor it. If you see A^3-B^3 over A^2+AB+B^2, cancel the matching factor.\n\nStructure is more important than size.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
