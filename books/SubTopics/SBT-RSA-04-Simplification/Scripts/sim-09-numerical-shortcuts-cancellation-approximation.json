    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Let's learn numerical shortcuts, cancellation and approximation.\n\nThis lesson uses the methods and question patterns from the Simplification chapter.\n\nWe will keep each step small: understand one rule, see it with numbers, then try a similar question.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "concept_1"
        }
      ]
    },
    "concept_1": {
      "id": "concept_1",
      "type": "CONTENT",
      "content": {
        "text": "Before multiplying large numbers, look for cancellation.\n\nExample:\n(84^2 ÷ 28 × 12) ÷ 24.\nCancel 84/28 and 12/24 before doing the remaining multiplication.\n\nSmaller numbers mean fewer errors.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
