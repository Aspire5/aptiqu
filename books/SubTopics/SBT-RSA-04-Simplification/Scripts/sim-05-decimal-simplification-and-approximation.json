    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "Here's a pro move from the book.\n\n5.25 ÷ 7/2 looks awkward — until you rewrite the decimal as a fraction:\n\n5.25 = 525/100 = 21/4",
