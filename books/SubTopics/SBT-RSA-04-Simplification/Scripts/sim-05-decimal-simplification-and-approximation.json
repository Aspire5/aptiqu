    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Multiplying decimals: ignore the points, multiply, then count the points back in.\n\n0.4 × 0.3\n\n4 × 3 = 12\nDecimal places: 1 + 1 = 2\nAnswer: 0.12",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "One more:\n\n2.5 × 0.08\n\n25 × 8 = 200\nPlaces: 1 + 2 = 3\nAnswer: 0.200 = 0.2\n\nThe place-count is the whole game. Estimate to confirm: 2.5 × a small number should be much smaller than 2.5 — 0.2 fits.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
