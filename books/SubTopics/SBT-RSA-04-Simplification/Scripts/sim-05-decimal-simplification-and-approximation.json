    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Subtraction uses the same fence:\n\n20 − 7.86\n\nWrite 20 as 20.00 so the columns exist:\n\n20.00 − 7.86 = 12.14\n\nBorrow across the point exactly like normal borrowing.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Quick check by adding back:\n\n12.14 + 7.86 = 20.00 ✓\n\nWhenever a decimal subtraction feels shaky, reverse it with addition.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
