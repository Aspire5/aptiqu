    "concept_4": {
      "id": "concept_4",
      "type": "CONTENT",
      "content": {
        "text": "Division by a fraction means multiply by its reciprocal.\n\n(a/b) ÷ (c/d) = (a/b) × (d/c).\n\nOnly the divisor is turned upside down. A common error is to flip both fractions.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
