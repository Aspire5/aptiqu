    "concept_6": {
      "id": "concept_6",
      "type": "CONTENT",
      "content": {
        "text": "To find what fraction one quantity is of another, divide the first by the second.\n\nExample: 3/8 is what part of 1/2?\n(3/8) ÷ (1/2) = 3/4.\n\nKeep the direction of the question: ‘A is what part of B?’ means A ÷ B.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
        }
      ]
    },
