    "concept_3": {
      "id": "concept_3",
      "type": "CONTENT",
      "content": {
        "text": "When multiplying fractions, cancel common factors before multiplying.\n\nExample:\n(6/7) × (14/15)\nCancel 14 with 7, and 6 with 15.\nThe smaller numbers reduce the chance of an arithmetic mistake.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
