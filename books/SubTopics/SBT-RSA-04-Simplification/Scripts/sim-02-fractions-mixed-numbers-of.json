    "concept_2": {
      "id": "concept_2",
      "type": "CONTENT",
      "content": {
        "text": "For addition or subtraction, first give the fractions a common denominator.\n\nExample:\n1/4 + 1/6\nLCM of 4 and 6 is 12.\n3/12 + 2/12 = 5/12.\n\nDo not add the denominators directly.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
