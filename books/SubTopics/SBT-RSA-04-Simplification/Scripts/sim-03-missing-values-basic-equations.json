    "concept_2": {
      "id": "concept_2",
      "type": "CONTENT",
      "content": {
        "text": "If the unknown is being subtracted, keep its sign.\n\nExample:\n700 - x = 460\nThen x = 700 - 460.\n\nA common mistake is to add 460 and 700 because the unknown is moved without thinking about the original subtraction.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
