    "concept_3": {
      "id": "concept_3",
      "type": "CONTENT",
      "content": {
        "text": "If x is a divisor, do not treat it like an addend.\n\nExample:\n360/x = 12\nThis means 12x = 360, so x = 30.\n\nCross-multiplying is simply undoing the division.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
