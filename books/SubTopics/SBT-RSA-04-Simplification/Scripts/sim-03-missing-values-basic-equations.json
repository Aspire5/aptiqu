    "concept_4": {
      "id": "concept_4",
      "type": "CONTENT",
      "content": {
        "text": "When the unknown is inside a bracket, undo the outside operations first.\n\nExample:\n(x-40) ÷ 5 = 12\nMultiply by 5: x-40=60.\nThen add 40: x=100.\n\nWork from the outside back toward x.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
