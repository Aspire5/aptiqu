    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "Add the two square identities and watch the middle terms cancel:\n\n(a + b)^2 + (a − b)^2 = 2(a^2 + b^2)\n\nTry a = 8, b = 3:\n\n11^2 + 5^2 = 121 + 25 = 146\n2(64 + 9) = 2 × 73 = 146 ✓",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
