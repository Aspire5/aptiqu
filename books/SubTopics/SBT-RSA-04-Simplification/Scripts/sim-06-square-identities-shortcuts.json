    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "Identities also run backwards.\n\nGiven: x + y = 23 and xy = 126. Find x^2 + y^2.\n\nSquare the sum you know:\n\n(x + y)^2 = 529\nx^2 + 2xy + y^2 = 529",
        "avatarPersona": "TUTOR"
