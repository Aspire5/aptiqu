    "retry_remedy_1": {
      "id": "retry_remedy_1",
      "type": "CONTENT",
      "content": {
        "text": "Let’s work through this one.\n\n99^2 = (100 − 1)^2 = 10000 − 200 + 1 = 9801. The middle term is subtracted because b has a minus sign.\n\nTry the question once more and check each clue.",
        "avatarPersona": "TUTOR"
      },
