    },
    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "The minus twin works the same way:\n\n(a − b)^2 = a^2 − 2ab + b^2\n\n97^2 = (100 − 3)^2\n= 10000 − 600 + 9\n= 9409",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Memory hook: the square terms are always positive.\nOnly the middle term carries the sign.\n\n(a + b)^2 → + 2ab\n(a − b)^2 → − 2ab\n\nb^2 never turns negative — a square is never below zero.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
