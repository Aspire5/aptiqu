    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "Sometimes the answer is negative. Nothing special happens — the order stays the same.\n\n−76 × 33 + 221\n\nMultiplication first:\n\n−76 × 33 = −2508\n\nThen the addition:\n\n−2508 + 221 = −2287",
