    "concept_6": {
      "id": "concept_6",
      "type": "CONTENT",
      "content": {
        "text": "For a long expression, use a rewrite line after every important step.\n\nA reliable check is to ask: did I finish every bracket, ‘of’, division and multiplication before the final addition or subtraction?\n\nThis habit prevents a correct idea from being ruined by one rushed operation.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
