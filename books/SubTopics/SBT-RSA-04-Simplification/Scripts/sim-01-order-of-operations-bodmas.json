    "teach_7": {
      "id": "teach_7",
      "type": "CONTENT",
      "content": {
        "text": "Many exam questions hide BODMAS inside an equation:\n\n13 × 252 ÷ 42 + 170 = ? + 47\n\nThe left side is a pure expression. Simplify it fully first.\n\n13 × 252 ÷ 42 = 13 × 6 = 78\n78 + 170 = 248",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
