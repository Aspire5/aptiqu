    "concept_5": {
      "id": "concept_5",
      "type": "CONTENT",
      "content": {
        "text": "Modulus means distance from zero, so the result is positive for the positive and negative examples used in the chapter.\n\n|5| = 5\n|-5| = 5\n\nWhen modulus appears in a fraction, simplify each modulus first. Also watch signs such as (-a) × (-b): two negative factors give a positive product.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_5"
        }
      ]
    },
