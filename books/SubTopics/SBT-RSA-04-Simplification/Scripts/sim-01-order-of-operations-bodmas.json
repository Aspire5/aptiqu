    "concept_4": {
      "id": "concept_4",
      "type": "CONTENT",
      "content": {
        "text": "A Virnaculum is a bar drawn over a part of an expression.\n\nThe chapter says to simplify the part under the bar before applying BODMAS to the rest.\n\nTreat the bar like a strong grouping sign: finish that small part, replace it by one number, then continue.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
