    "concept_2": {
      "id": "concept_2",
      "type": "CONTENT",
      "content": {
        "text": "Brackets are opened before the outside operations.\n\nWhen brackets are nested, start with the innermost round brackets, then move outward through { } and [ ].\n\nA minus sign outside a bracket changes the effect of what is inside, so rewrite each stage instead of doing it mentally.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
