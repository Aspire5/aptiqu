    "concept_3": {
      "id": "concept_3",
      "type": "CONTENT",
      "content": {
        "text": "The word ‘of’ means multiplication, but the chapter places it before division.\n\nExample:\n\n36 ÷ 3 of 4\n\nFirst: 3 of 4 = 12\nThen: 36 ÷ 12 = 3.\n\nThis is an important exam trap because reading from left to right too early gives a different result.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
