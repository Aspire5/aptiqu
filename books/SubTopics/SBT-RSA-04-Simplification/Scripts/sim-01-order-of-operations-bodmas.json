    },
    "teach_7_step": {
      "id": "teach_7_step",
      "type": "CONTENT",
      "content": {
        "text": "Now the equation reads:\n\n248 = ? + 47\n\nWhatever balances the scale: subtract 47 from both sides.\n\n? = 248 − 47 = 201\n\nCheck: 13 × 252 ÷ 42 + 170 = 248, and 201 + 47 = 248. Both sides match.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_7"
        }
      ]
    },
