    "concept_4": {
      "id": "concept_4",
      "type": "CONTENT",
      "content": {
        "text": "With two variables, x+y and xy are often enough.\n\nx^2+y^2=(x+y)^2-2xy.\n\nx^3+y^3=(x+y)^3-3xy(x+y).\n\nAgain, the individual values may not be needed.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
