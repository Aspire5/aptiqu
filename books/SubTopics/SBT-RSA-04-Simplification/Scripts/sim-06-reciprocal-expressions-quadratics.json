    "concept_3": {
      "id": "concept_3",
      "type": "CONTENT",
      "content": {
        "text": "For cubes, use the chapter's cube identities.\n\nIf p=x+1/x, then x^3+1/x^3 = p^3 - 3p.\n\nIf q=x-1/x, then x^3-1/x^3 = q^3 + 3q.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
