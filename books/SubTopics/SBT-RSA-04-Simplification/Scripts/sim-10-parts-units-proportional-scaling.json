    "concept_2": {
      "id": "concept_2",
      "type": "CONTENT",
      "content": {
        "text": "Successive fractions are often fractions of the remainder, not of the original whole.\n\nIf 1/4 is used, 3/4 remains. If then 1/3 of the remainder is used, that second use is 1/3 of 3/4, not 1/3 of the original.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
