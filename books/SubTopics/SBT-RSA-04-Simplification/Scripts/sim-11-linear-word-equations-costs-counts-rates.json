    "concept_2": {
      "id": "concept_2",
      "type": "CONTENT",
      "content": {
        "text": "In equal-distribution problems, total amount stays fixed.\n\nIf more people share the same total, each gets less.\n\nWrite total/old people - total/new people = stated difference.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
