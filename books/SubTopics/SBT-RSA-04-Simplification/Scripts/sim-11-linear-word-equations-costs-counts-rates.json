      "id": "concept_6",
      "type": "CONTENT",
      "content": {
        "text": "Simple catch-up problems compare equal totals.\n\nIf one reader starts earlier, first find the head start in pages. Then compare the difference in reading rates.\n\nTime to catch up = head start ÷ rate difference.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
        }
