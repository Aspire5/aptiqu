    "concept_3": {
      "id": "concept_3",
      "type": "CONTENT",
      "content": {
        "text": "Scoring questions use one count for correct answers and the rest for wrong answers.\n\nIf all N questions are attempted and x are correct, wrong answers = N-x.\n\nScore = reward×x - penalty×(N-x).",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
