    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "Only coffee means: coffee lovers minus the overlap.\n\n37 − 19 = 18\n\nOnly tea: 52 − 19 = 33",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step2"
        }
      ]
    },
    "teach_3_step2": {
      "id": "teach_3_step2",
      "type": "CONTENT",
      "content": {
        "text": "Check the full picture:\n\n18 + 33 + 19 = 70 ✓\n\n'Only A' = A − both.\n'A or B or both' = only A + only B + both.\n\nKeep the three regions separate in your working.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
