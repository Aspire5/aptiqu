    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Now suppose some people like NEITHER.\n\n50 students: 25 take Bengali, 16 take Hindi, 12 take no language.\n\nHow many take both?",
        "avatarPersona": "TUTOR"
