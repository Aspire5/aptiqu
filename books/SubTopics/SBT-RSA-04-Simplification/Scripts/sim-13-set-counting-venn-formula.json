    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "'Only' is the word to watch.\n\n70 people: 37 like coffee, 52 like tea, 19 like both.\n\nHow many like ONLY coffee?",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
