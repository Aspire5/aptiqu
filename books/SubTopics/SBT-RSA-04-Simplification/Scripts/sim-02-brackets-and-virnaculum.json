    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "Brackets work the same way with letters.\n\np − [p − (p + q)]\n\nOpen the innermost package:\n\n(p + q) stays a package\np − (p + q) = p − p − q = −q",
        "avatarPersona": "TUTOR"
