    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Chains of 'of' appear constantly:\n\n2/3 of 3/4 of 96\n\nWork from the right, or multiply the fractions first:\n\n2/3 × 3/4 = 6/12 = 1/2\n1/2 of 96 = 48",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "Watch the cancellation trick:\n\n2/3 × 3/4\nThe 3 on top cancels the 3 below.\nLeft with 2/4 = 1/2.\n\nCancelling before multiplying is the habit that makes fraction questions fast.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
