    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Numbers like 4 3/7 are called mixed numbers — a whole part plus a fraction.\n\nBefore any × or ÷, convert them to improper fractions:\n\n4 3/7 = (4 × 7 + 3)/7 = 31/7\n\nWhole × bottom + top, all over the bottom.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Going back is just division:\n\n31/7 = 4 remainder 3 → 4 3/7\n\nRule of thumb: mixed numbers are for reading answers, improper fractions are for doing the maths.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
