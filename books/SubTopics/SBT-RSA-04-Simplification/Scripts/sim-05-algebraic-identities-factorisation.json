    "concept_2": {
      "id": "concept_2",
      "type": "CONTENT",
      "content": {
        "text": "Difference of squares is one of the fastest chapter shortcuts:\n\na^2-b^2=(a+b)(a-b).\n\nIt is especially useful when two large numbers differ by a convenient amount.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
