    "q_1_remedy": {
      "id": "q_1_remedy",
      "type": "CONTENT",
      "content": {
        "text": "A common slip is to rush the operation or relationship before rewriting it.\n\nHere is the safe route for this exact question:\n\n(a+b)^2=a^2+b^2+2ab. So 100=a^2+b^2+42, giving 58.\n\nNow try a parallel example with fresh values.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
