            "id": "a",
            "label": "58"
          },
          {
            "id": "b",
            "label": "42"
          },
          {
            "id": "c",
            "label": "79"
          },
          {
            "id": "d",
            "label": "100"
          }
        ]
      },
      "content": {
        "text": "If a+b=10 and ab=21, find a^2+b^2.",
        "avatarPersona": "TUTOR"
