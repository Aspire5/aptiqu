    "concept_4": {
      "id": "concept_4",
      "type": "CONTENT",
      "content": {
        "text": "The three-term square identity is:\n\n(a+b+c)^2 = a^2+b^2+c^2 + 2(ab+bc+ca).\n\nIt lets you move between a total sum and the pair-products without finding a, b and c separately.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
