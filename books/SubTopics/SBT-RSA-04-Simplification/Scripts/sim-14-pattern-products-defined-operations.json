    "teach_6_step": {
      "id": "teach_6_step",
      "type": "CONTENT",
      "content": {
        "text": "Step I: 6 × 3 + 6^2 = 18 + 36 = 54\nStep II: 54 ÷ 5 + 6 = 10.8 + 6 = 16.8\nStep III: 16.8 ÷ 3 = 5.6, and 5.6^2 = 31.36",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_6_step2"
        }
