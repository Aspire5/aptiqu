      "type": "CONTENT",
      "content": {
        "text": "No choices to make — just follow the recipe literally, one step per line.\n\nThese questions test careful reading, not cleverness.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
