      "id": "concept_1",
      "type": "CONTENT",
      "content": {
        "text": "A custom symbol has no usual meaning. Use only the definition given in the question.\n\nIf x*y = 3x+2y, then 2*4 means 3×2+2×4=14.\n\nRewrite the custom operation as ordinary arithmetic immediately.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
