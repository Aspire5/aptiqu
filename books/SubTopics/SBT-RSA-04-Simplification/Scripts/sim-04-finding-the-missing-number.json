    "teach_6_step": {
      "id": "teach_6_step",
      "type": "CONTENT",
      "content": {
        "text": "3 and 5 fit: 3 × 5 = 15 and 3 + 5 = 8.\n\nSo x^2 − 8x + 15 = (x − 3)(x − 5) = 0\n\nA product is zero when either part is zero:\nx = 3 or x = 5\n\nBoth answers are reported — exams accept '3 or 5'.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
        }
      ]
    },
