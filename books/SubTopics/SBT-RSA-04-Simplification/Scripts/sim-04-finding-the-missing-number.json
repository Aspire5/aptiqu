    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "The book loves this shape — the same missing number twice, leading to a square:\n\nAfter simplifying, one question becomes:\n\nx^2 − 8x + 15 = 0\n\nx^2 means x × x. Don't panic — hunt for two numbers that:\nmultiply to 15 and add to 8.",
        "avatarPersona": "TUTOR"
