    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Exam versions just carry more luggage:\n\n4368 + 2158 − 596 − ? = 3421 + 1262\n\nCollect the knowns on each side.\n\nLeft knowns: 4368 + 2158 = 6526\nRight side: 3421 + 1262 = 4683",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Now the line reads:\n\n6526 − 596 − ? = 4683\n5930 − ? = 4683\n\nSo the ? is the gap:\n\n? = 5930 − 4683 = 1247\n\nCheck: 5930 − 1247 = 4683 ✓",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
