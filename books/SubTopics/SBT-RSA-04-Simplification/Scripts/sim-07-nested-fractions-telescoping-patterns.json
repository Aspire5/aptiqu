    "concept_2": {
      "id": "concept_2",
      "type": "CONTENT",
      "content": {
        "text": "If a continued fraction repeats forever, name the whole value x.\n\nFor x = 1 + 1/x, multiply by x to get x^2=x+1.\n\nThe self-similar tail becomes the same x. This is the key idea; do not cut the infinite expression at an arbitrary place.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
