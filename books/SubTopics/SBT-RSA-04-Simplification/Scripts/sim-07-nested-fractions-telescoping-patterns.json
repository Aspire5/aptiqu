    "concept_3": {
      "id": "concept_3",
      "type": "CONTENT",
      "content": {
        "text": "A telescoping product is built so most factors cancel.\n\nExample:\n(1-1/3)(1-1/4)...(1-1/10)\n= (2/3)(3/4)...(9/10).\n\nEverything in the middle cancels, leaving 2/10.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
