    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Let's learn nested fractions, continued fractions and telescoping patterns.\n\nThis lesson uses the methods and question patterns from the Simplification chapter.\n\nWe will keep each step small: understand one rule, see it with numbers, then try a similar question.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "concept_1"
        }
      ]
    },
    "concept_1": {
      "id": "concept_1",
      "type": "CONTENT",
      "content": {
        "text": "A continued fraction is safest when solved from the deepest part upward.\n\nExample:\n1 + 1/(2 + 1/3)\nFirst 2+1/3=7/3.\nThen 1 ÷ 7/3 = 3/7.\nFinally 1+3/7=10/7.\n\nNever try to flatten every level in one step.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
