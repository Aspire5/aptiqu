    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Let's learn sequential change, reverse working and repeated cycles.\n\nThis lesson uses the methods and question patterns from the Simplification chapter.\n\nWe will keep each step small: understand one rule, see it with numbers, then try a similar question.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "concept_1"
        }
      ]
    },
    "concept_1": {
      "id": "concept_1",
      "type": "CONTENT",
      "content": {
        "text": "When a quantity changes in stages, write each stage on a new line.\n\nIf the final value is known and each step is easy to reverse, work backward.\n\nReverse subtraction with addition, addition with subtraction, multiplication with division, and taking half with doubling.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
