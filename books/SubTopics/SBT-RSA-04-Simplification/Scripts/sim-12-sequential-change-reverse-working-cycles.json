    "concept_2": {
      "id": "concept_2",
      "type": "CONTENT",
      "content": {
        "text": "Repeated doubling is easiest backward when the final stage is known.\n\nIf a quantity doubles every period, one period earlier it was half as large. Two periods earlier it was one-quarter.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
