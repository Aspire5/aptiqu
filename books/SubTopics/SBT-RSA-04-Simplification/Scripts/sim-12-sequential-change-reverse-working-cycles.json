    "concept_3": {
      "id": "concept_3",
      "type": "CONTENT",
      "content": {
        "text": "In climb-and-slip or deposit-withdraw cycles, separate complete cycles from the final step.\n\nThe last climb may reach the target before the usual slip happens. Counting a slip after reaching the top gives an answer that is too large.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
