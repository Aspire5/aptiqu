    "concept_4": {
      "id": "concept_4",
      "type": "CONTENT",
      "content": {
        "text": "Objects placed at both ends create one fewer gaps than objects.\n\n26 trees make 25 equal intervals.\n\nDistance = number of gaps × gap size.\n\nThis endpoint idea appears in tree and fence-post questions.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
