    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "Multiplying by a power of 10 moves the decimal point but keeps the significant digits.\n\n4.2, 42, and 420 have common logs whose decimal parts are the same.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "Their logs differ only by integers because:\n\n42=4.2×10\n420=4.2×100.\n\nThe characteristic changes; the mantissa stays the same.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
