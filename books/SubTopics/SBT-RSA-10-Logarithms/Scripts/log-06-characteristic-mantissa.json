    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "A negative decimal log is rewritten so the mantissa stays positive.\n\n−3.153 = −4 + 0.847.\n\nSo the characteristic is −4 and the mantissa is 0.847.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_5_step"
        }
      ]
    },
    "teach_5_step": {
      "id": "teach_5_step",
      "type": "CONTENT",
      "content": {
        "text": "The trick is to borrow 1:\n\n−3.153\n= −4 + (1−0.153)\n= −4 + 0.847.\n\nThe book writes the negative characteristic with a bar.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_5"
        }
      ]
    },
