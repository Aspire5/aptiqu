    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Numbers from 1 up to 10 have characteristic 0.\n\nFor example, 7.32 lies between 10⁰ and 10¹.",
        "avatarPersona": "TUTOR"
