    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "For a number below 1, count the zeros after the decimal point before the first non-zero digit.\n\n0.0047 has two such zeros. Add 1 and make it negative: characteristic −3.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "This matches the size check:\n\n0.001 < 0.0047 < 0.01\n10^−3 < 0.0047 < 10^−2\n\nSo its log lies between −3 and −2.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
