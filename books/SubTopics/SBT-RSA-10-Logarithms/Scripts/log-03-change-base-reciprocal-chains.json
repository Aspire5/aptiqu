    },
    "remedy_1": {
      "id": "remedy_1",
      "type": "CONTENT",
      "content": {
        "text": "Let's check this one.\n\nThe two common logs form a quotient, not a difference.\n\nChange of base gives 0.9030/0.3010=3.\n\nNow use the same idea with fresh values.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "retry_1"
        }
      ]
    },
