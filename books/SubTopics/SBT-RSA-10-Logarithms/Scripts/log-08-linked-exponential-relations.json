    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Changing both a base and an argument to their reciprocals keeps the log value the same.\n\nIf log_a m=x, then:\nlog_(1/a)(1/m)=x.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "Why? a^x=m. Taking reciprocals gives (1/a)^x=1/m. The exponent x has not changed.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
