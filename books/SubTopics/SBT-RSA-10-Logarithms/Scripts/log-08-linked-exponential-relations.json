    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "A chain such as a=b²=c³=d⁴ lets every letter be written as a power of a.\n\nb=a^(1/2), c=a^(1/3), d=a^(1/4).",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_5_step"
        }
      ]
    },
    "teach_5_step": {
      "id": "teach_5_step",
      "type": "CONTENT",
      "content": {
        "text": "Then:\nlog_a(abcd)=1+1/2+1/3+1/4\n=25/12.",
