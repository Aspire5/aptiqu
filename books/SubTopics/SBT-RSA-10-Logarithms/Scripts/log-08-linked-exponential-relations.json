    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "From log_a(ab)=x, we found log_a b=x−1.\n\nChange base to find log_b(ab):\nlog_b(ab)=log_a(ab)/log_a b = x/(x−1).",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "This is a good example of solving only what the question asks. You do not need numerical values of a or b.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
