    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "Now link three exponential relations:\n\na=b^x, b=c^y, c=a^z.\n\nSubstitute them around the loop.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "a=(c^y)^x=c^(xy)=(a^z)^(xy)=a^(xyz).\n\nFor a nontrivial positive base, the exponents match: xyz=1.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
