    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "A denominator like log_a(bc)+1 has a hidden product.\n\nBecause 1=log_a a:\nlog_a(bc)+1=log_a(abc).",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "Therefore:\n1/[log_a(bc)+1]=log_(abc) a.\n\nAdding the cyclic versions gives log_(abc)(abc)=1.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
