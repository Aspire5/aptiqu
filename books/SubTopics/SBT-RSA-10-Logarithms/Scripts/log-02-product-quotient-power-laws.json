    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "The laws can make an awkward pair become a power of 10.\n\nlog 2 + log 50 = log(100)=2.\n\nNo table is needed because the product is familiar.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "Look for a product that becomes 10, 100, 1000, or another easy power.\n\nThe law is useful because it changes the shape of the numbers before you calculate.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
