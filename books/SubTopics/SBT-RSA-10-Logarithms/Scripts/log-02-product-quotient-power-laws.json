    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "Coefficients can stay symbolic too.\n\n2 log_a x − log_a y\n= log_a(x^2) − log_a y\n= log_a(x^2/y).",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_5_step"
        }
      ]
    },
    "teach_5_step": {
      "id": "teach_5_step",
      "type": "CONTENT",
      "content": {
        "text": "This is a useful exam habit: simplify the log structure first.\n\nYou often do not need the values of x, y, or the base at all.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
