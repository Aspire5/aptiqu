    "teach_7": {
      "id": "teach_7",
      "type": "CONTENT",
      "content": {
        "text": "There is one tempting rule that is false.\n\nlog(x+y) is NOT log x + log y.\n\nFor example, log(2+3)=log5, while log2+log3=log6.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_7_step"
        }
      ]
    },
    "teach_7_step": {
      "id": "teach_7_step",
      "type": "CONTENT",
      "content": {
        "text": "The laws only turn:\n\nproducts ↔ sums of logs\nquotients ↔ differences of logs\npowers ↔ coefficients\n\nOrdinary addition inside the argument stays ordinary addition.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_7"
        }
      ]
    },
