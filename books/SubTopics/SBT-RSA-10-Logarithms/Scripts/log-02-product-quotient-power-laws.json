    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Now divide instead of multiply.\n\nlog₂64 − log₂8 = 6 − 3 = 3.\nAnd 64÷8=8, so log₂8=3.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "That gives the quotient law:\n\nlog_a(x/y)=log_a x − log_a y\n\nSubtraction of logs becomes division inside one log.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
