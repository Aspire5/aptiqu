    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "If equal logarithms have the same valid base, their arguments are equal.\n\nlog₅(2x+1)=log₅11\nmeans\n2x+1=11.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Then 2x=10 and x=5.\n\nThe common base lets you remove the log layer, but only after both sides are logs of that same base.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
