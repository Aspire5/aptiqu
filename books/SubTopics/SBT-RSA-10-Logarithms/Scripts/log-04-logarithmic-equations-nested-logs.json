    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "When logs are added, combine them before solving.\n\nlog x + log 5 = 2\nbecomes\nlog(5x)=2.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "Because the base is 10:\n\n5x=10^2=100\nso x=20.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
