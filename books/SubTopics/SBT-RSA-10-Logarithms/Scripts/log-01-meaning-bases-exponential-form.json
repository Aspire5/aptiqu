    "remedy_3": {
      "id": "remedy_3",
      "type": "CONTENT",
      "content": {
        "text": "Let's check this one.\n\nCounting decimal places directly can mislead; compare exponents of the same base.\n\n0.01=10^−2 and 0.000001=10^−6. Thus −2x=−6, so x=3.\n\nNow use the same idea with fresh values.",
        "avatarPersona": "TUTOR"
