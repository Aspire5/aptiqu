    "teach_7_step": {
      "id": "teach_7_step",
      "type": "CONTENT",
      "content": {
        "text": "The same idea handles small decimals:\n\nlog 0.01 = −2\nbecause 0.01=10^−2.\n\nSo an omitted base is not missing information here; it means 10.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
