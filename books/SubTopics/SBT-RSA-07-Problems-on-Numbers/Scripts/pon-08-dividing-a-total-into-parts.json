    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "Percentage-removal stories are easier if you track what remains.\n\nSuppose 10% of some eggs are rotten. That leaves 90% = 0.9 of the original.",
        "avatarPersona": "TUTOR"
