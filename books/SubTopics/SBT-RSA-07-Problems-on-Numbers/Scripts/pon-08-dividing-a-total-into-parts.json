    "concept_3": {
      "id": "concept_3",
      "type": "CONTENT",
      "content": {
        "text": "Chained ratios must share the middle term.\n\nIf A:B=2:3 and B:C=4:5, make B the same in both ratios.\n2:3 becomes 8:12, and 4:5 becomes 12:15.\nSo A:B:C=8:12:15.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
