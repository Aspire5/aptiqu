    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Let's split a total into parts without guessing.\n\nA known total can reduce the number of unknowns immediately: if one part is x, the other is Total−x.\n\nFor three or more parts, ratios often make the structure clearer.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "concept_1"
        }
      ]
    },
    "concept_1": {
      "id": "concept_1",
      "type": "CONTENT",
      "content": {
        "text": "When a total T is split into two parts, one clean model is x and T−x.\n\nThen a weighted condition becomes one equation.\n\nThis avoids carrying two unknowns when the total is already known.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
