      "id": "teach_5_step",
      "type": "CONTENT",
      "content": {
        "text": "Then the original parts are:\nfirst=k−3\nsecond=k+3\nthird=k/3\nfourth=3k\n\nAdd these expressions and use the known total. One common value k controls all four parts.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_5"
        }
      ]
    },
