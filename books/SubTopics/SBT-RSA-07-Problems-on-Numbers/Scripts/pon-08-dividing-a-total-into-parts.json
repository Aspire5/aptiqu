    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Equal fractional parts create a ratio immediately.\n\nSuppose half of the first part, one-third of the second, and one-fourth of the third are equal.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "Call that common value k.\n\nFirst/2=k → first=2k\nSecond/3=k → second=3k\nThird/4=k → third=4k\n\nSo the parts are in ratio 2:3:4.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
