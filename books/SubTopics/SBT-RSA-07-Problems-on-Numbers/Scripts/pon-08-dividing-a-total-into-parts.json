      "type": "CONTENT",
      "content": {
        "text": "If 80% of the remainder is given away, 20% of the remainder stays.\n\nFinal fraction = 0.9 × 0.2 = 0.18 of the original.\n\nIf 36 eggs remain, original = 36/0.18 = 200.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
        }
      ]
    },
