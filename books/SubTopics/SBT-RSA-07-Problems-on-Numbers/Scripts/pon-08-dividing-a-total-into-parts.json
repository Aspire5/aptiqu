    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "A reciprocal-sum condition still starts with the same two parts.\n\nIf 50 is split into x and 50−x and their reciprocal sum is 1/12:",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "1/x + 1/(50−x) = 1/12\n\nThe left side combines to:\n50/[x(50−x)] = 1/12\n\nx(50−x)=600\nThe parts are 20 and 30.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
