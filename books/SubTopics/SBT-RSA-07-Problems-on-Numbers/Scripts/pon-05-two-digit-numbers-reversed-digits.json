    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Let's turn digit puzzles into place-value equations.\n\nA two-digit number is not x+y. If x is the tens digit and y is the units digit, the number is 10x+y.\n\nThat one idea explains most reversal questions in this chapter.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "concept_1"
        }
      ]
    },
    "concept_1": {
      "id": "concept_1",
      "type": "CONTENT",
      "content": {
        "text": "Let the tens digit be x and the units digit be y.\n\nThe number is 10x+y.\nThe reversed number is 10y+x.\nThe digit sum is x+y.\n\nThese three expressions are the foundation of almost every two-digit puzzle in the chapter.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
