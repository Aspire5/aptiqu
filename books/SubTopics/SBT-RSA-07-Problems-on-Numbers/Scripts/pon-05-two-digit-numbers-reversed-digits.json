    "teach_8": {
      "id": "teach_8",
      "type": "CONTENT",
      "content": {
        "text": "Capstone: nonlinear digit clues still use the same place-value model.\n\nSuppose the units digit is the square of the tens digit, and the reverse exceeds the original by 54.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_8_step"
        }
      ]
    },
    "teach_8_step": {
      "id": "teach_8_step",
      "type": "CONTENT",
      "content": {
        "text": "Let tens=x, units=x².\n\nReverse−original = 9(x²−x)=54\nx²−x=6\n(x−3)(x+2)=0\n\nDigit x=3, so units=9 and original=39.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_8"
        }
      ]
    },
