    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "Sometimes the digit product supplies the second clue.\n\nSuppose the digits multiply to 18 and the reverse is 27 greater than the original.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_6_step"
