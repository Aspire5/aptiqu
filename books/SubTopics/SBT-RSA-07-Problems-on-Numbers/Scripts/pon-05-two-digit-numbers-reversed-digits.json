    "concept_3": {
      "id": "concept_3",
      "type": "CONTENT",
      "content": {
        "text": "Adding a number and its reverse is also simple:\n\n(10x+y)+(10y+x)=11(x+y).\n\nSo the sum is always divisible by 11. This can answer some questions without knowing the digits separately.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
