            "label": "6+3"
          },
          {
            "id": "b",
            "label": "10×6 + 3"
          },
          {
            "id": "c",
            "label": "10×3 + 6"
          },
          {
            "id": "d",
            "label": "6×3"
          }
        ]
      },
