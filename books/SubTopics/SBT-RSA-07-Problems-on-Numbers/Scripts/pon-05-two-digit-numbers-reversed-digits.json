    "teach_7": {
      "id": "teach_7",
      "type": "CONTENT",
      "content": {
        "text": "A reversal difference alone may not identify a unique number.\n\nIf original−reverse=27, then x−y=3.\n\nPossible numbers include 41, 52, 63, 74, 85 and 96.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
