    "teach_6_step": {
      "id": "teach_6_step",
      "type": "CONTENT",
      "content": {
        "text": "Reverse−original = 27 gives y−x=3.\n\nDigit pairs with product 18 are 2 and 9, 3 and 6. Only 3 and 6 differ by 3.\n\nSo original=36, reverse=63.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
        }
      ]
