    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "A fixed reversal change plus a digit sum usually pins down the exact number.\n\nSuppose the digits sum to 11 and the original number is 27 greater than its reverse.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_5_step"
        }
      ]
    },
    "teach_5_step": {
      "id": "teach_5_step",
      "type": "CONTENT",
      "content": {
        "text": "x+y=11\n9(x−y)=27, so x−y=3\n\nAdd the two equations:\n2x=14\nx=7, y=4\nNumber=74\n\nDigit sum and digit gap work like sum-and-difference of two numbers.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_5"
        }
      ]
    },
