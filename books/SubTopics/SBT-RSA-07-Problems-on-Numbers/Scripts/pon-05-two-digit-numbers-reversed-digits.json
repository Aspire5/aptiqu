    "concept_2": {
      "id": "concept_2",
      "type": "CONTENT",
      "content": {
        "text": "Subtracting a reversed number gives a useful shortcut:\n\n(10x+y)−(10y+x)=9(x−y).\n\nSo a reversal difference is always a multiple of 9. It tells you the digit difference directly.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
