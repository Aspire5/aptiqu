    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Now subtract a number from its reverse.\n\nOriginal: 10x+y\nReverse: 10y+x",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Original − reverse\n= 10x+y−10y−x\n= 9x−9y\n= 9(x−y)\n\nSo a reversal difference is always a multiple of 9. It tells you the digit difference, not automatically the exact digits.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
