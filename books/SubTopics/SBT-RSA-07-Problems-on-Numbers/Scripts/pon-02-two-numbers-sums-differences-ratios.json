      "content": {
        "text": "Let's solve puzzles with two unknown numbers.\n\nThe important step is not guessing the numbers. It is turning each condition into a useful equation.\n\nTwo independent conditions usually let us determine the pair.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "concept_1"
        }
      ]
    },
