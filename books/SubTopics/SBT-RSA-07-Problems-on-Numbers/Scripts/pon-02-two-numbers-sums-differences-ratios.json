    "teach_8": {
      "id": "teach_8",
      "type": "CONTENT",
      "content": {
        "text": "Capstone: two clues may use different forms, but they must describe the same pair.\n\nSuppose two numbers sum to 88 and their ratio is 5:3.\n\nRatio gives 8 parts; total gives each part as 11. So the numbers are 55 and 33.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
