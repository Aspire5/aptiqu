          "targetNodeId": "teach_8_step"
        }
      ]
    },
    "teach_8_step": {
      "id": "teach_8_step",
      "type": "CONTENT",
      "content": {
        "text": "Now add a second kind of check.\n\nDifference = 22\n22 is 40% of 55.\n\nA strong solution can satisfy the sum, ratio and any extra relation without changing the pair.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_8"
        }
      ]
    },
