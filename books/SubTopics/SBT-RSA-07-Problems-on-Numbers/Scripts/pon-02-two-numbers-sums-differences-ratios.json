    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "Two fraction clues can also connect the same pair.\n\nSuppose x+y=60, and one-third of x is 6 more than one-fourth of y.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "x/3 − y/4 = 6\nMultiply by 12:\n4x − 3y = 72\n\nUse y=60−x:\n4x−3(60−x)=72\n7x=252\nx=36, y=24\n\nBoth clues now check.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
