    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Fractions in the sentence still refer to the same whole number.\n\nSuppose a number is 50 more than three-fifths of itself.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
