    "concept_4": {
      "id": "concept_4",
      "type": "CONTENT",
      "content": {
        "text": "Nested fractions are read from the inside out.\n\n'One-third of one-fourth of x' means\n\n(1/3)×(1/4)×x = x/12.\n\nDo not add the denominators. Multiply the fractions.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
