    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "Let the number be x.\n\nx − 3x/5 = 50\n2x/5 = 50\nx = 125\n\nThe key is that both x and 3x/5 describe the same number.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
