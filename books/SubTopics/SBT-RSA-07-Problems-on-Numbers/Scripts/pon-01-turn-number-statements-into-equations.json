    "concept_3": {
      "id": "concept_3",
      "type": "CONTENT",
      "content": {
        "text": "A fractional part of x is just multiplication.\n\nThree-fifths of x = (3/5)x.\n\nSo if the difference between x and three-fifths of x is 36:\n\nx − (3/5)x = 36.\n\nThe left side is (2/5)x.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
