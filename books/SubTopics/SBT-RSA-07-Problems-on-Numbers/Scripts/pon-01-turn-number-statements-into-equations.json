    "concept_2": {
      "id": "concept_2",
      "type": "CONTENT",
      "content": {
        "text": "Words such as 'times', 'more than' and 'less than' decide the equation.\n\nIf 7 times a number, minus 12, equals 8 more than 3 times the number:\n\n7x − 12 = 3x + 8.\n\nOnly after writing this should you solve.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
