    "concept_3": {
      "id": "concept_3",
      "type": "CONTENT",
      "content": {
        "text": "Sometimes only one of the statements is sufficient.\n\nA digit-sum statement may leave several numbers, while an equation for the whole number may determine it directly.\n\nThe sufficient statement need not look more detailed; it only needs to fix the target.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
