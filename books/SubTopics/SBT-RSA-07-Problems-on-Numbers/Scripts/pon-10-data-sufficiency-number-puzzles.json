    "concept_2": {
      "id": "concept_2",
      "type": "CONTENT",
      "content": {
        "text": "A statement can be sufficient by itself.\n\nIf the target is four-fifths of a number and a statement uniquely gives the number, you are done.\n\nDo not demand extra information once the requested target is fixed.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
