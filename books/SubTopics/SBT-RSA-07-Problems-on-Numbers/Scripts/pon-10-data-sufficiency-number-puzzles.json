    "concept_4": {
      "id": "concept_4",
      "type": "CONTENT",
      "content": {
        "text": "Two statements may be required together.\n\nOne can give a sum and the other a difference. Neither fixes both numbers alone, but together they do.\n\nThis is the standard 'both together' case.",
        "avatarPersona": "TUTOR"
