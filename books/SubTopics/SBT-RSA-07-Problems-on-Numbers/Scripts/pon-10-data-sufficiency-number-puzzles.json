    "concept_6": {
      "id": "concept_6",
      "type": "CONTENT",
      "content": {
        "text": "A later statement may repeat information already contained in another.\n\nFor two digits x and y, 'original−reverse=18' means x−y=2. A separate statement 'the tens digit exceeds the units digit by 2' says the same thing.\n\nRepeated information does not create a new equation.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
        }
      ]
    },
