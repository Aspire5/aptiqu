    "concept_5": {
      "id": "concept_5",
      "type": "CONTENT",
      "content": {
        "text": "Even two statements can be insufficient.\n\nExample: digit difference 2 plus digit sum 4 gives digits 3 and 1, but if the question does not say which is the tens digit, both 31 and 13 remain possible.\n\nUnique digits are not always a unique number.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_5"
        }
      ]
    },
