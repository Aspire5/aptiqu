    "concept_3": {
      "id": "concept_3",
      "type": "CONTENT",
      "content": {
        "text": "If a three-digit number is fully reversed, the tens digit cancels in the difference.\n\n(100u+10t+h) − (100h+10t+u) = 99(u−h).\n\nThis gives a fast link between the first and last digits.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
