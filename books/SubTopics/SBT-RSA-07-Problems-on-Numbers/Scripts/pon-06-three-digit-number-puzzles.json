    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "If the hundreds and units digits are equal, call both of them h.\n\nThen a digit sum of 8 gives:\n2h + t = 8",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_6_step"
        }
