    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Now reverse the hundreds and units digits. The tens digit stays where it is.\n\nOriginal: 100h+10t+u\nReverse: 100u+10t+h",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
