    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "Reverse − original\n= 99u−99h\n= 99(u−h)\n\nThat is why full three-digit reversal changes come in multiples of 99.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
