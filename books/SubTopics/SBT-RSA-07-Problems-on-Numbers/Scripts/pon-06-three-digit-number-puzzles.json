    "teach_6_step": {
      "id": "teach_6_step",
      "type": "CONTENT",
      "content": {
        "text": "Now count valid digit pairs with h=1 to 4, because h cannot be 0 and t must stay from 0 to 9:\nh=1 → t=6\nh=2 → t=4\nh=3 → t=2\nh=4 → t=0\n\nSo there are 4 valid numbers.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
        }
      ]
    },
