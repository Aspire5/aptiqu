    "teach_8": {
      "id": "teach_8",
      "type": "CONTENT",
      "content": {
        "text": "A full-reversal clue can finish a digit-sum puzzle.\n\nSuppose the digits sum to 11, the middle digit is 5, and the reverse is 198 greater than the original.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_8_step"
        }
      ]
    },
    "teach_8_step": {
      "id": "teach_8_step",
      "type": "CONTENT",
      "content": {
        "text": "Then h+u=6.\nReverse−original = 99(u−h)=198, so u−h=2.\n\nSolve:\nh+u=6\nu−h=2\n\nu=4, h=2\nNumber=254.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_8"
        }
      ]
    },
