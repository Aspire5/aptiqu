    "concept_2": {
      "id": "concept_2",
      "type": "CONTENT",
      "content": {
        "text": "If you swap only the tens and units digits, the hundreds digit stays fixed.\n\nNew − old = 9(u−t).\n\nSo a change of 27 means the units digit was 3 more than the tens digit.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
