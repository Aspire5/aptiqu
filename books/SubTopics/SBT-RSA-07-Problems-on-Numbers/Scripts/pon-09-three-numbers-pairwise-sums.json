    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "The identity for three numbers works like the two-number square identity:\n\n(a+b+c)² = a²+b²+c² + 2(ab+bc+ca)",
        "avatarPersona": "TUTOR"
