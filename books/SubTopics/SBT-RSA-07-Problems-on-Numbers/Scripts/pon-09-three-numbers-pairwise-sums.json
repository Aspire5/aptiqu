    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "Linked equations do not always arrive as all three pair sums.\n\nSuppose x+y=30, y+z=34 and 3x+z=52.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "From x+y=30, y=30−x.\nFrom y+z=34, z=34−y=4+x.\n\nPut into 3x+z=52:\n3x+x+4=52\n4x=48\nx=12\n\nThen y=18 and z=16. Each value comes from the same linked clues.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
