    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "Average-of-pairs language is just pairwise sums with a divide-by-2 wrapper.\n\nIf average of x and y is 12, then x+y=24.\nIf average of y and z is 15, then y+z=30.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_6_step"
        }
      ]
    },
    "teach_6_step": {
      "id": "teach_6_step",
      "type": "CONTENT",
      "content": {
        "text": "Now compare the two:\n(x+y)−(y+z)=24−30\nx−z=−6\n\nSo z is 6 larger than x. The middle number y cancels.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
        }
      ]
    },
