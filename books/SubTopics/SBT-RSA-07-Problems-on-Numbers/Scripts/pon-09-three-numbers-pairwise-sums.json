    "teach_7": {
      "id": "teach_7",
      "type": "CONTENT",
      "content": {
        "text": "Pairwise sums can recover each number with a one-line formula.\n\nIf S=x+y+z, then:\nx=S−(y+z)\ny=S−(x+z)\nz=S−(x+y)",
        "avatarPersona": "TUTOR"
