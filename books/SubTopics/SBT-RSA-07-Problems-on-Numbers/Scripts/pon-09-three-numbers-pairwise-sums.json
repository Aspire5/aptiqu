    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "A total plus simple multiples can reduce three numbers to one scale.\n\nSuppose first=2×second and third=one-third of first.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Let second=3k so the third stays integral.\nFirst=6k\nSecond=3k\nThird=2k\n\nIf total=121, then 11k=121 and k=11.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
