    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Chained ratios work the same way here as in part-splitting.\n\nIf A:B=2:3 and B:C=4:5, make B match.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "A:B = 8:12\nB:C = 12:15\nSo A:B:C = 8:12:15\n\nIf the total is 140, one ratio unit is 4, giving 32,48,60.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
