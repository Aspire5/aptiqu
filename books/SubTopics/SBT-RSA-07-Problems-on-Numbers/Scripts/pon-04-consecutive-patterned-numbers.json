    "concept_5": {
      "id": "concept_5",
      "type": "CONTENT",
      "content": {
        "text": "A difference of squares can avoid expanding.\n\nFor consecutive even numbers x and x+2:\n(x+2)²−x² = [(x+2)−x][(x+2)+x].\n\nThat becomes 2(2x+2).",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_5"
        }
      ]
    },
