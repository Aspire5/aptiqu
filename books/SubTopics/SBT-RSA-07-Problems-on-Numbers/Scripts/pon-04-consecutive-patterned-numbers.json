    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "An even count has no single middle term. The average sits halfway between the two centre values.\n\nFor 18,19,20,21:\ncentre values are 19 and 20\naverage = 19.5",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "The same is true using the endpoints:\n(18+21)/2 = 19.5\n\nThis midpoint idea works for any equally spaced list, not just step 1.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
