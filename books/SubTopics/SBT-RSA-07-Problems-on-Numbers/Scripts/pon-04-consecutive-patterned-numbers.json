    "teach_7": {
      "id": "teach_7",
      "type": "CONTENT",
      "content": {
        "text": "Squares can identify a consecutive pattern too.\n\nFor three consecutive odd numbers x, x+2, x+4, a sum-of-squares clue becomes a quadratic in x.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_7_step"
        }
      ]
    },
    "teach_7_step": {
      "id": "teach_7_step",
      "type": "CONTENT",
      "content": {
        "text": "Example: 11²+13²+15² = 121+169+225 = 515.\n\nThe middle term is often the fastest thing to test because the three numbers are symmetric around it.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_7"
        }
      ]
    },
