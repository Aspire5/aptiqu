    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Let's learn how consecutive-number puzzles work.\n\nThe spacing tells us how to write the numbers: +1 for consecutive integers, +2 for consecutive odd/even numbers, and +k for consecutive multiples of k.\n\nOnce the pattern is written correctly, the equation becomes much easier.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "concept_1"
        }
      ]
    },
    "concept_1": {
      "id": "concept_1",
      "type": "CONTENT",
      "content": {
        "text": "Consecutive natural numbers differ by 1.\n\nSeven consecutive numbers can be written\nx, x+1, ..., x+6.\n\nWith an odd count, the middle number is also the average of the list.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
