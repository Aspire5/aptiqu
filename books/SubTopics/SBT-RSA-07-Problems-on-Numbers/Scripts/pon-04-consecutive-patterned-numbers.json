    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "Products of consecutive numbers create a simple quadratic.\n\nIf two consecutive positive integers multiply to 870, let them be x and x+1.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_6_step"
        }
      ]
    },
    "teach_6_step": {
      "id": "teach_6_step",
      "type": "CONTENT",
      "content": {
        "text": "x(x+1)=870\nx²+x−870=0\n\n29×30=870, so the numbers are 29 and 30.\n\nFor exam speed, nearby factor pairs are often easier to spot than expanding mechanically.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
        }
      ]
    },
