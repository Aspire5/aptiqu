    "teach_8": {
      "id": "teach_8",
      "type": "CONTENT",
      "content": {
        "text": "Capstone: a difference of squares can collapse a consecutive-number problem.\n\nFor consecutive even numbers a and a+2:\n(a+2)²−a² = 4a+4 = 4(a+1)",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_8_step"
        }
      ]
    },
    "teach_8_step": {
      "id": "teach_8_step",
      "type": "CONTENT",
      "content": {
        "text": "If the difference of their squares is 100:\n4(a+1)=100\na+1=25\na=24\n\nThe numbers are 24 and 26, sum 50.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_8"
        }
      ]
    },
