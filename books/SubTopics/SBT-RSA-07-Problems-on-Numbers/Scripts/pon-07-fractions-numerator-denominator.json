    "concept_3": {
      "id": "concept_3",
      "type": "CONTENT",
      "content": {
        "text": "Be precise about where the change happens.\n\n'Add 1 to the denominator' means x/(y+1).\n'Add 1 to the numerator' means (x+1)/y.\n\nThese are not the same as adding 1 to the value of the whole fraction.",
        "avatarPersona": "TUTOR"
