    "teach_7_step": {
      "id": "teach_7_step",
      "type": "CONTENT",
      "content": {
        "text": "If AB = 1, then:\n(9/4)B² = 1\nB² = 4/9\nB=2/3 for positive fractions\nA=3/2\n\nThe quotient gives their ratio; the product gives their scale.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_7"
        }
      ]
    },
