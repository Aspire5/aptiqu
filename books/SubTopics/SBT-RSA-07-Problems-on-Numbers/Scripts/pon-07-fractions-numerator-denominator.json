    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "Percentage changes act on the numerator and denominator separately.\n\nIf the numerator increases by 200%, it becomes 3x—not 2x.\nIf the denominator increases by 300%, it becomes 4y.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_5_step"
        }
      ]
    },
    "teach_5_step": {
      "id": "teach_5_step",
      "type": "CONTENT",
      "content": {
        "text": "So a new fraction after those changes is 3x/4y = 3/4 of the original fraction x/y.\n\nPercent increase means original plus the stated percent of original.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_5"
        }
      ]
    },
