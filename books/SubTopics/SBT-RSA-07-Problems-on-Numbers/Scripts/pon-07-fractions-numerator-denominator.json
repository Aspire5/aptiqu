      "id": "teach_8_step",
      "type": "CONTENT",
      "content": {
        "text": "Suppose subtracting 4 from the numerator makes the fraction half its original value:\n(2k−4)/(3k) = (1/2)(2/3)=1/3\n\n3(2k−4)=3k\n6k−12=3k\nk=4\nOriginal fraction=8/12.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_8"
        }
      ]
    },
