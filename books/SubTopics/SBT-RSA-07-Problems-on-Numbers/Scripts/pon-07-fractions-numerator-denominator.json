    "teach_7": {
      "id": "teach_7",
      "type": "CONTENT",
      "content": {
        "text": "Two fractions can be recovered from product and quotient.\n\nIf A/B = 9/4, then A = (9/4)B.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
