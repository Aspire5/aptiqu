    "concept_2": {
      "id": "concept_2",
      "type": "CONTENT",
      "content": {
        "text": "If the denominator is a fixed amount larger, use one variable.\n\nFor example, if denominator = numerator+4, let the numerator be x.\nThe fraction is x/(x+4).\n\nNow a change to both parts creates one equation in x.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
