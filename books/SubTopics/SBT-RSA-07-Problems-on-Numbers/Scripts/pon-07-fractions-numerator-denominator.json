    "teach_8": {
      "id": "teach_8",
      "type": "CONTENT",
      "content": {
        "text": "Capstone: the cleanest setup often uses a ratio before any equation.\n\nIf numerator:denominator = 2:3, let them be 2k and 3k.",
        "avatarPersona": "TUTOR"
