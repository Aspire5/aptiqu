    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "Reciprocal-minus-fraction clues create a quadratic.\n\nFor a positive proper fraction r, suppose 1/r − r = 3/4.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_6_step"
        }
      ]
    },
    "teach_6_step": {
      "id": "teach_6_step",
      "type": "CONTENT",
      "content": {
        "text": "Multiply by 4r:\n4 − 4r² = 3r\n4r² + 3r − 4 = 0\n\nThen keep the positive root between 0 and 1, because the question says proper fraction.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
        }
      ]
    },
