    "concept_5": {
      "id": "concept_5",
      "type": "CONTENT",
      "content": {
        "text": "For two fractions, product and quotient can identify each one.\n\nIf ab=P and a/b=Q, then dividing the product by the quotient gives b²=P/Q.\nOr multiplying them gives a²=PQ.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_5"
        }
      ]
