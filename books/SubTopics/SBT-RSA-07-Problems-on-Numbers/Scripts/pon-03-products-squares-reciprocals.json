    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "If the sum and the sum of squares are known, the hidden quantity is often the product.\n\nSuppose x+y=18 and x²+y²=170.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "(x+y)² = x²+y²+2xy\n324 = 170 + 2xy\n2xy = 154\nxy = 77\n\nNo need to solve x and y first.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
