    "teach_8": {
      "id": "teach_8",
      "type": "CONTENT",
      "content": {
        "text": "Capstone: product plus sum of squares can reveal the sum.\n\nSuppose xy=84 and x²+y²=193.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_8_step"
        }
      ]
    },
    "teach_8_step": {
      "id": "teach_8_step",
      "type": "CONTENT",
      "content": {
        "text": "(x+y)² = x²+y²+2xy\n= 193 + 168\n= 361\n\nFor positive numbers, x+y=19.\nThen the pair is 12 and 7 because their product is 84.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_8"
        }
      ]
    },
