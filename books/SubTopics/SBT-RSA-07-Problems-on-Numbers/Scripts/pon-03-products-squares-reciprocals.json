    "concept_6": {
      "id": "concept_6",
      "type": "CONTENT",
      "content": {
        "text": "A reciprocal equation in one number can become a quadratic.\n\nFor x+1/x = c, multiply by x first.\n\nExample: x+1/x=10/3 gives\n3x²−10x+3=0.\nThe two roots are reciprocals of each other.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
        }
      ]
    },
