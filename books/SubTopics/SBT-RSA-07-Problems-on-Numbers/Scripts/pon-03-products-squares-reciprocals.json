    "concept_2": {
      "id": "concept_2",
      "type": "CONTENT",
      "content": {
        "text": "A reciprocal sum turns into a sum-product relation.\n\n1/x + 1/y = (x+y)/xy.\n\nSo if x+y is known, the reciprocal sum can reveal xy.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
