    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "Sum and difference also give the product directly.\n\nIf x+y=25 and x−y=7:",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "4xy = (x+y)² − (x−y)²\n= 25² − 7²\n= 625 − 49\n= 576\n\nxy = 144\n\nThis is faster than solving both numbers first.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
