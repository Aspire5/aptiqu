        "type": "CHOICE",
        "options": [
          {
            "id": "a",
            "label": "2"
          },
          {
            "id": "b",
            "label": "4"
          },
          {
            "id": "c",
            "label": "8"
          },
          {
            "id": "d",
            "label": "16"
          }
        ]
      },
