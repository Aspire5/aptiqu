    "recap": {
      "id": "recap",
      "type": "CONTENT",
      "content": {
        "text": "Use identities instead of expanding blindly: (x−y)²=(x+y)²−4xy; (x+y)²=x²+y²+2xy; x²−y²=(x−y)(x+y); and 1/x+1/y=(x+y)/xy. Ratios turn two numbers into one scale factor.",
        "avatarPersona": "TUTOR"
      },
