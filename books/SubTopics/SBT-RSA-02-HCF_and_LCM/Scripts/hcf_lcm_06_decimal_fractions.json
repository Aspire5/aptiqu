            "value": false,
            "operator": "EQUALS"
          },
          "targetNodeId": "hcf_63_start"
        }
      ],
      "questionReference": {
        "mode": "INLINE",
        "inlineData": {
          "xp": 10,
          "hints": [
            "Look for the greatest number of decimal places in the given numbers.",
            "The book writes 2.1 as 2.10."
          ],
          "prompt": "Which is the correctly equalized form of 0.63, 1.05 and 2.1?",
          "options": [
            {
              "id": "a",
              "label": "0.63, 1.05, 2.1"
            },
            {
              "id": "b",
              "label": "0.63, 1.05, 2.01"
