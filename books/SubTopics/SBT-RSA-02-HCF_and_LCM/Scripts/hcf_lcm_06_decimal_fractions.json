    "hcf_63_restore_remedy": {
      "id": "hcf_63_restore_remedy",
      "type": "CONTENT",
      "content": {
        "text": "Remember the full chain:\\n\\n0.63, 1.05, 2.10\\n→ 63, 105, 210\\n→ H.C.F. = 21\\n→ restore 2 decimal places\\n→ 0.21\\n\\nThe final answer must be in the same decimal scale used for the equalized numbers.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "lcm_63_start"
        }
      ]
    },
    "lcm_63_start": {
      "id": "lcm_63_start",
      "type": "CONTENT",
      "content": {
        "text": "The exact same preparation works for L.C.M.\\n\\nFor 0.63, 1.05 and 2.1:\\n\\n0.63, 1.05, 2.10\\n→ 63, 105, 210\\n\\nNow find the L.C.M. of 63, 105 and 210. The book gives 630.\\n\\nThen restore the 2 decimal places.",
        "avatarPersona": "TUTOR"
