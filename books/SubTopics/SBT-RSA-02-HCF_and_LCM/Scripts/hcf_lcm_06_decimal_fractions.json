    "lcm_63_remedy": {
      "id": "lcm_63_remedy",
      "type": "CONTENT",
      "content": {
        "text": "Check the multiples.\\n\\n630 ÷ 63 = 10\\n630 ÷ 105 = 6\\n630 ÷ 210 = 3\\n\\nSo 630 is exactly divisible by all three. It is the required L.C.M. of the whole-number forms.",
        "avatarPersona": "TUTOR"
