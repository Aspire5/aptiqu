    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Alternating work is not a new formula. It is a repeating pattern.\n\nA works day 1, B day 2, then the same 2-day cycle repeats.\n\nFind one cycle's work first. Then count cycles and handle the leftover in the correct turn.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "A takes 12 days, B 18. If A works day 1 and B day 2, one 2-day cycle does 1/12+1/18 = 5/36.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "Six cycles = 12 days and do 30/36 = 5/6. On day 13 A works, then day 14 B, and so on.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
