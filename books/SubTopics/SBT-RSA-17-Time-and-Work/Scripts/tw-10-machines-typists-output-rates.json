    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Time and Work is not only about people.\n\nA typist has pages/hour.\nA conveyor has tonnes/minute.\nA machine has batches/hour.\n\nOnce the unit is clear, the same rule applies: rates add.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "George types 50 pages in 8 hours, so his rate is 50/8 = 6.25 pages/hour.\nSonia types 50 in 5 hours = 10 pages/hour.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "Together they type 16.25 pages/hour. Output time = pages ÷ combined rate.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
