    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Now let everyone start together and one worker leave.\n\nA=12 days, B=18 days. They work 4 days together: 4×5/36 = 5/9 done.\nIf A leaves, B handles the remaining 4/9.",
