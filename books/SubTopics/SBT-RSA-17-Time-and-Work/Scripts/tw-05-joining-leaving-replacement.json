  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "When someone joins or leaves, the job does not restart.\n\nThe clean method is a timeline:\nStage 1 → work done.\nStage 2 → new team, remaining work.\n\nCarry the fraction forward every time the team changes.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "A takes 20 days, B takes 30. A works alone for 4 days.\nA completes 4/20 = 1/5, so 4/5 remains.\nThen A+B rate = 1/12.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "The remaining 4/5 takes (4/5) ÷ (1/12) = 48/5 = 9.6 days. Total = 13.6 days.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
