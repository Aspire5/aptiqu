    "teach_7": {
      "id": "teach_7",
      "type": "CONTENT",
      "content": {
        "text": "If a worker's contribution is known as a fraction of team work, rate ratios appear immediately.\n\nIf A does 2/3 of what the team completes, B does the remaining 1/3. So A:B = 2:1.",
