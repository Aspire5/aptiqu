    "complete": {
      "id": "complete",
      "type": "CONTENT",
      "content": {
        "text": "You can now recover a hidden worker from a team.\n\nTeam rate = sum of individual rates.\nMissing rate = team rate − known rates.\n\nKeep the result as a rate until the end, then take its reciprocal to get the worker's solo time.",
        "avatarPersona": "TUTOR"
      },
