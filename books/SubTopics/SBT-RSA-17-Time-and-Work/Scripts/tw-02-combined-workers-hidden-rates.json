    "teach_8": {
      "id": "teach_8",
      "type": "CONTENT",
      "content": {
        "text": "Capstone: hidden-rate problems are subtraction problems in disguise.\n\nDo not subtract times. Subtract rates.\n\nA+B time 12 days and B time 20 days does not mean A takes 8 days. It means A rate = 1/12−1/20.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_8_step"
        }
      ]
    },
    "teach_8_step": {
      "id": "teach_8_step",
      "type": "CONTENT",
      "content": {
        "text": "That distinction prevents one of the most common Time and Work errors.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_8"
        }
      ]
    },
