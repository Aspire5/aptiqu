    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "Question: How long does A take alone?\nI. A+B finish in 10 days.\nII. B alone takes 15 days.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "Neither statement alone gives A. Together they give A rate =1/10−1/15=1/30.\nSo both are necessary.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
