    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Efficiency tells us how much work someone does in the same time.\n\nIf A is twice as efficient as B, A's rate is 2:1—but A's completion time is 1:2.\n\nRate ratios and time ratios point in opposite directions.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "A is twice as efficient as B. In one day A does twice B's work.\n\nSo if B needs 18 days, A needs only 9 days.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "Efficiency ratio A:B = 2:1.\nTime ratio A:B = 1:2.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
