    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "When every worker has the same efficiency, there is a faster unit than fractions: worker-days.\n\n20 workers for 6 days = 120 worker-days of work.\n\nIf the team size changes, keep counting worker-days stage by stage.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "If 12 workers finish a job in 20 days, the job requires 12×20 = 240 worker-days.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "With 15 equal workers, time = 240/15 = 16 days.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
