  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "A headcount only helps when everyone works at the same speed.\n\nIf men, women, and boys have different efficiencies, first convert them to a common worker unit.\n\nThen the problem becomes ordinary Time and Work again.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "If 8 men finish a job in 20 days, one man's rate is 1/(8×20)=1/160 job/day.\nIf 8 women need 32 days, one woman's rate is 1/256.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "So a man is 256/160 = 1.6 times as efficient as a woman.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
