{
  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Treat the whole job as exactly 1.\n\nIf A finishes it in 8 days, A does 1/8 of the job each day.\n\nThat single move—time ↔ rate—is the engine behind Time and Work.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "A worker finishes one job in 10 days. Imagine the job cut into 10 equal pieces.\n\nOne day removes one piece: 1/10 of the job.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "Completion time and daily rate are reciprocals.\n\n10 days → 1/10 per day.\n5 days → 1/5 per day.\nA faster worker has a larger daily fraction.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
