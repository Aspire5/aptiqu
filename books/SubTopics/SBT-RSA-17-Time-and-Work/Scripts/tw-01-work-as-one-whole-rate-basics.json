    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Once the daily rate is known, several days of work is just multiplication.\n\nIf A's rate is 1/12, then in 3 days A completes 3/12 = 1/4 of the job.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "The mental check is useful: 3 days is one quarter of a 12-day schedule, so one quarter of the job should be done.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
