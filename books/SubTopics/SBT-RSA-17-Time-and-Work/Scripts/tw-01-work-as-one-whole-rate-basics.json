    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "Sometimes the story gives only part of the job.\n\nIf A completes 2/5 of a job in 6 days, then 1/5 takes 3 days, so the whole job takes 15 days.",
