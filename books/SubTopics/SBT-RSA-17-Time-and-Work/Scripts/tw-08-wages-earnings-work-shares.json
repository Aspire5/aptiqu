    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "A fixed payment for a job should follow the work done.\n\nIf A does twice as much of the job as B, A should receive twice as much of the job payment.\n\nSo the first task is always: find each person's work contribution.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "A takes 8 days, B 12 days. If they work together throughout, their work-rate ratio is 1/8:1/12 = 3:2.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
