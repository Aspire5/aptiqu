    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "A total daily earning can be unpacked from pair sums.\n\nIf A+B+C earn ₹300/day, A+C ₹188 and B+C ₹152:\nB=300−188=112, A=300−152=148, so C=40.",
