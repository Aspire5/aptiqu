    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Pair rates can also identify the fastest worker.\n\nA = ABC−BC, B = ABC−AC, C = ABC−AB.\nLarger rate means smaller solo time.",
