    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Sometimes nobody's solo time is given. Instead you get pairs: A+B, B+C, A+C.\n\nThat is still enough.\n\nAdd all three pair rates and every worker appears exactly twice.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "Suppose AB take 12 days, BC 15, AC 20.\nPair rates are 1/12, 1/15, 1/20.\nTheir sum is 1/5 = twice the ABC rate.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "So ABC rate = 1/10, and all three together take 10 days.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
