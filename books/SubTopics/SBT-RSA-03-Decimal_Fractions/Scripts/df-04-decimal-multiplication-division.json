    "powers_of_ten": {
      "id": "powers_of_ten",
      "type": "CONTENT",
      "content": {
        "text": "Multiplying by 10ⁿ shifts a decimal point n places to the right; dividing by 10ⁿ shifts it n places left. If the digits run out, use zero placeholders. The direction follows the size change: multiplication by a positive power makes a positive value larger, division makes it smaller.\n\nFor 0.069 × 10,000, move four places right: 0.0690 → 690. Count the exponent's places, not just the displayed nonzero digits.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_powers_of_ten"
        }
      ]
    },
