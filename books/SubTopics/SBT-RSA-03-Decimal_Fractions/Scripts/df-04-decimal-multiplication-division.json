    "divide_counting_number": {
      "id": "divide_counting_number",
      "type": "CONTENT",
      "content": {
        "text": "When dividing a decimal by a counting number, divide as usual while keeping the dividend's place-value scale. The quotient is not assigned an arbitrary number of decimal places; the actual division determines its digits. Check by multiplying the quotient by the divisor.\n\nFor 0.0204 ÷ 17, note 204 ÷ 17 = 12. The original dividend is 204 ten-thousandths; dividing by 17 gives 12 ten-thousandths, or 0.0012. Multiplication verifies 0.0012 × 17 = 0.0204.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_divide_counting_number"
        }
      ]
    },
