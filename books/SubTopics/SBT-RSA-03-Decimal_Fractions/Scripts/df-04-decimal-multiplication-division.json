    "decimal_divisor_scaling": {
      "id": "decimal_divisor_scaling",
      "type": "CONTENT",
      "content": {
        "text": "To divide by a decimal, multiply both the dividend and divisor by the same power of ten until the divisor is a whole number. This is valid because multiplying numerator and denominator of a quotient by the same nonzero value does not change the quotient.\n\nFor 0.00066 ÷ 0.006, multiply both by 1,000: 0.66 ÷ 6 = 0.11. The divisor becomes 6, and the quotient is unchanged. Never shift only one number; that changes the value of the division.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_decimal_divisor_scaling"
        }
      ]
    },
