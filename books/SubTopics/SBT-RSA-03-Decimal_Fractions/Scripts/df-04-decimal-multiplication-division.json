    "brackets_and_mixed_forms": {
      "id": "brackets_and_mixed_forms",
      "type": "CONTENT",
      "content": {
        "text": "Brackets make a grouping explicit and must be evaluated before outside operations. A decimal and a fraction can appear together; use an equivalent form only when it helps, and preserve exact values when possible.\n\nFor 0.5 × 5.6 ÷ 0.5 × 12, multiplication and division have equal precedence and are evaluated left to right: 2.8 ÷ 0.5 × 12 = 5.6 × 12 = 67.2. If a different grouping is intended, parentheses must show it. This is why writing the order is part of the solution, not decoration.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_brackets_and_mixed_forms"
        }
      ]
