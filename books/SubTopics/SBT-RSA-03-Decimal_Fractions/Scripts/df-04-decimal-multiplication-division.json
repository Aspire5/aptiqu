    "multiple_factor_scale": {
      "id": "multiple_factor_scale",
      "type": "CONTENT",
      "content": {
        "text": "For several decimal factors, add the number of places in every factor before placing the point. A whole-number factor contributes zero decimal places. Leading zeroes may be needed to fill the product to the required length.\n\nFor 0.4 × 0.04 × 0.004 × 40, the whole-number digit product is 4 × 4 × 4 × 40 = 2,560. The factors contribute six decimal places, so the product is 0.002560, equal to 0.00256. The small result is sensible because three factors are below 1.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_multiple_factor_scale"
        }
      ]
    },
