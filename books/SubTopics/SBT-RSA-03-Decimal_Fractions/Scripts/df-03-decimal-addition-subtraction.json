    "subtraction_borrowing": {
      "id": "subtraction_borrowing",
      "type": "CONTENT",
      "content": {
        "text": "Subtraction needs the same alignment. If a top digit is too small, regroup from the next place, even when zeroes lie between. Each borrowed unit is one tenth, hundredth, or another place unit according to its column.\n\nFor 31.004 − 17.2386, write 31.0040 − 17.2386 and borrow through the zero columns. The difference is 13.7654. The estimate 31 − 17 ≈ 14 supports its magnitude.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_subtraction_borrowing"
        }
      ]
    },
