    "multiple_subtractions": {
      "id": "multiple_subtractions",
      "type": "CONTENT",
      "content": {
        "text": "In a − b − c − d, the subtrahends can be added first because subtracting them in sequence is equivalent to subtracting their sum. Keep signs and grouping explicit.\n\nFor 58.621 − 13.829 − 7.302 − 1.214, the removed amounts total 22.345. Then 58.621 − 22.345 = 36.276. Grouping reduces repeated borrowing without changing the expression.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_multiple_subtractions"
        }
      ]
    },
