    "complementary_grouping": {
      "id": "complementary_grouping",
      "type": "CONTENT",
      "content": {
        "text": "Regroup terms when their decimal parts make a round value. In 10.0001 + 9.9999 − 8.9995, the first two add to exactly 20; subtracting 8.9995 leaves 11.0005. Estimation near 11 checks the scale.\n\nRegrouping is safe only when each sign stays attached to its term. Two subtracted terms remain subtracted when combined.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_complementary_grouping"
        }
      ]
    },
