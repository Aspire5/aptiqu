    "addition_carrying": {
      "id": "addition_carrying",
      "type": "CONTENT",
      "content": {
        "text": "When a column total reaches ten units of that place, regroup into one unit of the next place. The decimal point does not move during addition. With several addends, align every point first and track each carry.\n\nFor 11.11 + 111.1 + 1,111.11, write 11.11 + 111.10 + 1,111.11. The total is 1,233.32. Estimating about 11 + 111 + 1,111 = 1,233 checks the scale.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_addition_carrying"
        }
      ]
    },
