    "pure_leading_zero_block": {
      "id": "pure_leading_zero_block",
      "type": "CONTENT",
      "content": {
        "text": "The block may begin with zeroes. Those zeroes are part of the period and must be counted when choosing how many 9s to use. For 0.(067), the period is 067, so write 67/999, not 67/99. The leading zero in the block does not change the numerator's integer value, but it does contribute to the block length and denominator.\n\nA quick check is to compare sizes: 67/999 is about 0.067, matching the first digits of the recurring decimal. A denominator of 99 would give about 0.677, a clear scale error.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_pure_leading_zero_block"
        }
      ]
    },
