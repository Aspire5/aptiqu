{
  "schemaVersion": "1.0",
  "scriptId": "rp-13-weighted-ratio-applications",
  "sourceType": "MANUAL",
  "metadata": {
    "title": "Weighted Ratio Applications",
    "description": "Combine ratios of counts with fares, wages, prices, marks, or profit rates to find weighted totals and overall effects.",
    "teachingApproach": "Teach contribution = count × rate as the core model. Every block pairs a quantity ratio with a second per-unit value, then combines the weighted contributions.",
    "targetDurationMinutes": 28,
    "sourceScope": "R.S. Aggarwal, Quantitative Aptitude for Competitive Examinations, Chapter 13, Ratio and Proportion. Approved scope: Teach that a ratio of people or units and a ratio/rate per person combine through multiplication. Cover weighted average charges when attendance differs, fare-class income, group wages, employee-count and wage changes, category expenditure with different price increases, weighted profit across product types, proportional marks with equal maximum marks, and linked old/new income ratios. Learners should compute contribution = count × rate before combining."
  },
  "startNodeId": "start",
  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "When groups have different counts and different rates, comparing only one ratio gives the wrong picture.\n\nWe’ll multiply the matching pieces first—people×wage, passengers×fare, quantity×price—then combine the results.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "Suppose attendance across three days is 2:3:5, while ticket prices are ₹12, ₹8, ₹4.\n\nUse 2k,3k,5k visitors.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "Revenue is 24k+24k+20k=68k.\nTotal visitors=10k.\nAverage charge=₹6.80.\n\nA simple average of 12,8,4 would ignore attendance.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
