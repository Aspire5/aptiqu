    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "A product gives k².\n\nRatio 2:3 -> numbers 2k, 3k.\nIf product=600, then 6k²=600 -> k²=100 -> k=10.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "For positive-number aptitude questions, take the positive k unless the problem says otherwise.\n\nThe numbers are 20 and 30.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
