    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "Difference of squares often collapses nicely.\n\nRatio 3:4 -> numbers 3k,4k.\nDifference of squares = 16k²−9k²=7k².",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "If that difference is 252, then 7k²=252 -> k²=36 -> k=6.\n\nThe numbers are 18 and 24.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
