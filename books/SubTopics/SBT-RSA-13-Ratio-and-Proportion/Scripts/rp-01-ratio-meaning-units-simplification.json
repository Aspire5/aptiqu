    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "Part-to-part and part-to-whole are different.\n\nIf boys : girls = 3 : 2, there are 5 equal parts altogether.\n\nGirls are 2/5 of the class = 40%.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_6_step"
        }
      ]
    },
    "teach_6_step": {
      "id": "teach_6_step",
      "type": "CONTENT",
      "content": {
        "text": "The denominator for a percentage of the whole is the sum of the ratio terms.\n\nA common mistake is to use 2/3, which compares girls only with boys, not with the whole class.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
        }
      ]
    },
