    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "Equivalent ratios are scaled copies.\n\nIf 7 : 9 = 35 : ?, the first term was multiplied by 5.\n\nThe second term must also be multiplied by 5: ? = 45.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "This is faster than cross-multiplying when you can see the scale directly.\n\nAlways ask: ‘What happened to one term?’ Then do the same to the other.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
