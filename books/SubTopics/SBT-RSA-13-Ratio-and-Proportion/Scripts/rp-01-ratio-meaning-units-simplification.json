    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Ratios can contain decimals too.\n\n1.5 : 2.25 looks awkward, so multiply both terms by 100:\n150 : 225 = 2 : 3.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "Scaling both terms is allowed because the comparison stays the same.\n\nFor fractions, a useful move is to multiply both terms by a common denominator until the ratio becomes whole numbers.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
