    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "A ratio only makes sense after the units match.\n\n₹3 and 50 paise cannot be compared as 3 : 50.\n\n₹3 = 300 paise, so the ratio is 300 : 50 = 6 : 1.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Think of unit conversion as putting both quantities on the same ruler.\n\nOnce the units match, the unit cancels and the ratio is just a number comparison.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
