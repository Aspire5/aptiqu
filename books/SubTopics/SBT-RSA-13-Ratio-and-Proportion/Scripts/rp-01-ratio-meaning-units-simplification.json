    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "To compare two ratios, compare the fractions behind them.\n\nWhich is larger: 7 : 12 or 5 : 9?\n\nCross-products: 7×9 = 63 and 5×12 = 60. So 7/12 is larger.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
