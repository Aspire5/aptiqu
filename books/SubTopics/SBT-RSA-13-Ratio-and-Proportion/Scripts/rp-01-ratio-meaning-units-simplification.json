    "remedy_1": {
      "id": "remedy_1",
      "type": "CONTENT",
      "content": {
        "text": "Let’s check this clue.\n\nFind a common factor of both terms.\n\n18 ÷ 6 = 3 and 30 ÷ 6 = 5, so 18 : 30 = 3 : 5.\n\nNow use the same idea on a fresh question.",
        "avatarPersona": "TUTOR"
