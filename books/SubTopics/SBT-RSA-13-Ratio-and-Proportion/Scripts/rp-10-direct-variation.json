    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "Sometimes the variable is under a square root.\n\nT∝√L.\nIf length becomes 4 times as large, √L becomes 2 times as large.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "For a pendulum-style relation, ratios are clean:\nT₂/T₁ = √(L₂/L₁).\n\nSquare both sides when solving for length.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
