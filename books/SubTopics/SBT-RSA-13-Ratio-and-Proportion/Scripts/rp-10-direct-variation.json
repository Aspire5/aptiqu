    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "A shifted direct variation looks like y∝(x+3), not y∝x.\n\nThe whole block x+3 is the changing quantity.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_5_step"
        }
      ]
    },
    "teach_5_step": {
      "id": "teach_5_step",
      "type": "CONTENT",
      "content": {
        "text": "If y=8 when x=1, then 8=k(4), so k=2.\nThus y=2(x+3).\nAt x=5, y=16.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_5"
        }
      ]
    },
    "q_5": {
      "id": "q_5",
      "type": "CHOICE",
