    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "If A and B are both directly proportional to the same C, then A/B stays constant.\n\nA=k₁C and B=k₂C, so A/B=k₁/k₂.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_6_step"
        }
      ]
    },
    "teach_6_step": {
      "id": "teach_6_step",
      "type": "CONTENT",
      "content": {
        "text": "That means changing C scales both, but their ratio does not change.\n\nThis is often faster than finding C itself.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
        }
      ]
    },
