    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Subtraction works the same way.\n\nRatio 5:8 -> 5k,8k.\nAfter subtracting 6 from both, suppose the ratio becomes 2:5.",
