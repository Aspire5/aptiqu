    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Equal multiples create inverse shares.\n\nIf 3A = 4B = 6C, then\nA:B:C = 1/3:1/4:1/6 = 4:3:2.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "If the total is ₹900, the 9 ratio parts are worth ₹100 each.\n\nSo A=400, B=300, C=200.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
