    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "Fraction relations also turn into ratios.\n\nIf A = 3/2 of B, then A:B = 3:2.\nIf B = 5/4 of C, then B:C = 5:4.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "Chain the two relations: A:B=3:2 and B:C=5:4.\nMatch B: 15:10 and 10:8 -> A:B:C = 15:10:8.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
