    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "The duplicate ratio means square both terms.\n\nDuplicate of 3:5 is 9:25.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "This is not 6:10.\n\n6:10 is merely an equivalent ratio. Duplicate ratio changes the comparison by squaring.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
