    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "Componendo and dividendo is a shortcut for sum and difference.\n\nIf a/b = c/d, then\n(a+b)/(a−b) = (c+d)/(c−d).",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
