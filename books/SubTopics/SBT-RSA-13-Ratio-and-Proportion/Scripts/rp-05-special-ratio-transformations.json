    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "The reciprocal ratio flips both terms.\n\nReciprocal of 4:9 is 1/4 : 1/9.\nMultiply by 36 -> 9:4.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_5_step"
        }
      ]
    },
    "teach_5_step": {
      "id": "teach_5_step",
      "type": "CONTENT",
      "content": {
        "text": "So for a two-term ratio, taking reciprocals simply reverses the order.\n\nThis is why 1/x : 1/y = y:x.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_5"
        }
      ]
    },
