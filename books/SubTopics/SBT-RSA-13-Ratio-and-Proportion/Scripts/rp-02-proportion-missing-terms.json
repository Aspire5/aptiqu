  "schemaVersion": "1.0",
  "scriptId": "rp-02-proportion-missing-terms",
  "sourceType": "MANUAL",
  "metadata": {
    "title": "Proportion and Missing Terms",
    "description": "Use equal ratios and cross-products to solve missing-term, third-, fourth-, and mean-proportional questions.",
    "teachingApproach": "Begin by balancing two equivalent recipes so the learner sees why cross-products match. Then move from one missing term to named proportionals, decimals, expressions, and a capstone that connects percentage equality to a ratio.",
    "targetDurationMinutes": 28,
    "sourceScope": "R.S. Aggarwal, Quantitative Aptitude for Competitive Examinations, Chapter 13, Ratio and Proportion. Approved scope: Teach proportion as equality of two ratios and derive the cross-product rule: in a:b = c:d, ad = bc. Use it to find a missing term in integer, decimal and fractional proportions. Cover fourth proportional, third proportional, mean proportional sqrt(ab), continued proportion, and simple proportion equations with an expression such as (x+1):8 = 3:4. Emphasize preserving term order and checking by comparing the two final ratios."
  },
  "startNodeId": "start",
  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "A proportion is two ratios claiming to describe the same comparison.\n\nOnce that idea is clear, missing terms, third proportionals, fourth proportionals, and mean proportionals all come from one relationship.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "A proportion says two ratios describe the same comparison.\n\n2 : 3 = 8 : 12\n\nBoth reduce to 2/3.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "Cross-multiply the fraction form:\n2/3 = 8/12\n\n2×12 = 3×8 = 24.\n\nThat is why, in a:b = c:d, the product of the extremes equals the product of the means.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
    "q_1": {
      "id": "q_1",
      "type": "CHOICE",
      "content": {
        "text": "Which equation must be true if 4 : 7 = 12 : 21?",
        "avatarPersona": "TUTOR"
      },
      "input": {
        "type": "CHOICE",
        "options": [
          {
            "id": "a",
            "label": "4×21 = 7×12"
          },
          {
            "id": "b",
            "label": "4×12 = 7×21"
          },
          {
            "id": "c",
            "label": "4+21 = 7+12"
          },
          {
            "id": "d",
            "label": "4×7 = 12×21"
          }
        ]
      },
