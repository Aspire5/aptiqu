    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "A third proportional repeats the middle term.\n\nFor 10 and 15, find c so that\n10 : 15 = 15 : c.\n\n10c = 225, so c = 22.5.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
