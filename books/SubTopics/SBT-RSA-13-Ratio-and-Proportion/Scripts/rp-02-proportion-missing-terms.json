    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "Decimals do not change the idea.\n\n0.4 : 0.6 = 1.2 : x\n\n0.4x = 0.72, so x = 1.8.",
