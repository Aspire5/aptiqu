    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "The mean proportional sits between two numbers:\na : m = m : b.\n\nSo m² = ab and m = √(ab).",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_5_step"
        }
      ]
    },
    "teach_5_step": {
      "id": "teach_5_step",
      "type": "CONTENT",
      "content": {
        "text": "Example: between 8 and 18,\nm = √(8×18) = √144 = 12.\n\nThe mean proportional is a geometric mean, not the ordinary average.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_5"
        }
      ]
    },
