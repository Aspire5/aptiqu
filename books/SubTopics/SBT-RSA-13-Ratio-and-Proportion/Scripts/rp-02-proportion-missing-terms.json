    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Now let one term be unknown.\n\n7 : x = 14 : 18\n\n7×18 = 14x, so x = 9.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Keep the order exactly as written.\n\nA ratio is directional: 7:x is not the same as x:7. After solving, check that 7/9 and 14/18 simplify to the same value.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
