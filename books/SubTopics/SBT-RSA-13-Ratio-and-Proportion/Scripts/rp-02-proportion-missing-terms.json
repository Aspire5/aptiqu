    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "A fourth proportional completes a proportion.\n\nFor 6, 9, 14, find d so that\n6 : 9 = 14 : d.\n\n6d = 126, so d = 21.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "The name sounds special, but the work is just one missing term in a proportion.\n\nOrder matters: a, b, c, d means a:b = c:d.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
