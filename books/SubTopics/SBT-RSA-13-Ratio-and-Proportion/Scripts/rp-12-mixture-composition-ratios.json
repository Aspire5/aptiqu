    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "To hit a target mixture, compare how far each source is from the target.\n\nMix 20% and 50% to get 30%.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "The 20% source is 10 points below target; 50% is 20 above.\nSo quantities are inverse distances: high:low = 10:20 = 1:2.\n\nMore of the weaker mixture is needed.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
