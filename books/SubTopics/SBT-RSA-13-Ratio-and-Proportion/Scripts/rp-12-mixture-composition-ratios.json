{
  "schemaVersion": "1.0",
  "scriptId": "rp-12-mixture-composition-ratios",
  "sourceType": "MANUAL",
  "metadata": {
    "title": "Mixture and Composition Ratios",
    "description": "Track component fractions through mixing, strengthening, dilution, evaporation, and repeated replacement.",
    "teachingApproach": "Keep the component amount visible. Start with converting a ratio to fractions of a mixture, then mix equal and unequal quantities, solve a target concentration, and finish with the chapter’s repeated-replacement formula.",
    "targetDurationMinutes": 28,
    "sourceScope": "R.S. Aggarwal, Quantitative Aptitude for Competitive Examinations, Chapter 13, Ratio and Proportion. Approved scope: Teach component ratio -> component fraction first. Cover equal-volume mixtures, unequal quantities, target mixtures solved by alligation-style reasoning, adding a pure component, adding water, evaporation where solute stays fixed, mixing alloys or teas with different compositions/prices, and the repeated replacement rule x(1-y/x)^n. Keep the invariant component visible and end with a repeated milk-water replacement capstone."
  },
  "startNodeId": "start",
  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Mixture questions feel messy when you track only percentages. They become cleaner when you track the actual amount of each component.\n\nWe’ll use that idea for mixing, strengthening, evaporation, removal-and-replacement, and repeated replacement.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "Milk:water = 3:2 means 5 total parts.\n\nMilk is 3/5 of the mixture; water is 2/5.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "In 25 L, milk=15 L and water=10 L.\n\nAlways convert the ratio to component fractions before adding mixtures.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
