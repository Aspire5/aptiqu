    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "If quantities are unequal, weight each fraction by its volume.\n\n10 L at 60% milk contributes 6 L milk.\n20 L at 30% contributes 6 L milk.",
        "avatarPersona": "TUTOR"
