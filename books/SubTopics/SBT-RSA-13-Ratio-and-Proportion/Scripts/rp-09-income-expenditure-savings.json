      "type": "CONTENT",
      "content": {
        "text": "Officer salary = 240/0.03 = ₹8,000.\nOne ratio part = 8,000/5 = ₹1,600.\nClerk salary = 3×1,600 = ₹4,800.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
