    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Two people can have different income and expense ratios but the same savings.\n\nIncome A:B=7:3 -> 7x,3x.\nExpense A:B=5:2 -> 5y,2y.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Equal savings gives\n7x−5y = 3x−2y.\n\nThat equation links the two scales x and y. Then one known saving fixes the actual values.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
    "q_2": {
      "id": "q_2",
      "type": "CHOICE",
      "content": {
        "text": "A:B incomes=5:4, expenses=3:2, and each saves ₹6,000. If A=5x,B=4x and expenses=3y,2y, what relation follows?",
        "avatarPersona": "TUTOR"
      },
      "input": {
        "type": "CHOICE",
        "options": [
          {
            "id": "a",
            "label": "2x = y"
          },
          {
            "id": "b",
            "label": "x = y"
          },
          {
            "id": "c",
            "label": "x = 2y"
          },
          {
            "id": "d",
            "label": "3x = 2y"
          }
        ]
      },
      "questionReference": {
        "mode": "INLINE",
        "inlineData": {
          "questionType": "PRACTICE",
