    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Savings ratios may be easier than salaries themselves.\n\nSuppose incomes A:B=3:4 and expenses A:B=2:3.\nLet incomes 3x,4x and expenses 2y,3y.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "If A saves one-third of income, then 3x−2y=x.\nSo 2x=2y -> x=y.\nThen savings A:B = x:(4x−3x)=1:1.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
