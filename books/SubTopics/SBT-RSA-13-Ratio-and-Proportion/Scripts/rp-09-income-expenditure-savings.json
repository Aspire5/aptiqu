{
  "schemaVersion": "1.0",
  "scriptId": "rp-09-income-expenditure-savings",
  "sourceType": "MANUAL",
  "metadata": {
    "title": "Income, Expenditure, and Savings Ratios",
    "description": "Use Income = Expenditure + Savings as the bridge between salary ratios, spending ratios, and percentage changes.",
    "teachingApproach": "Anchor the lesson in a simple monthly budget. Keep income and expenditure on separate ratio scales until one condition links them, then use savings to connect the scales.",
    "targetDurationMinutes": 28,
    "sourceScope": "R.S. Aggarwal, Quantitative Aptitude for Competitive Examinations, Chapter 13, Ratio and Proportion. Approved scope: Teach Income = Expenditure + Savings inside ratio problems. Cover income and expenditure ratios with equal savings, finding savings ratios, salaries linked by a given ratio plus a percentage contribution or allowance, two-year income and expense ratios, and three-person cases where saved percentages convert income ratios into savings ratios. Use common multipliers instead of guessing actual salaries until one absolute amount fixes the scale."
  },
  "startNodeId": "start",
  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Income questions become much easier when one identity stays visible: Income = Expenditure + Savings.\n\nWe’ll use that bridge to connect salary ratios, spending ratios, saving percentages, allowances, and year-to-year changes.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "A monthly budget has three pieces:\nIncome = Expenditure + Savings.\n\nIf income:expenditure = 11:9, savings are the missing 2 parts.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "So savings are 2/11 of income.\n\nIf income is ₹44,000, one part is ₹4,000 and savings are ₹8,000.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
