    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "A salary ratio plus one percentage amount fixes both salaries.\n\nClerk:officer salary=3:5. Officer contributes 3% and that equals ₹240.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
