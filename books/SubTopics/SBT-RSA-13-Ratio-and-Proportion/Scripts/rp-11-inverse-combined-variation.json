    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "Combined variation uses more than one factor.\n\nResistance R is directly proportional to length L and inversely proportional to radius²:\nR = kL/r².",
        "avatarPersona": "TUTOR"
