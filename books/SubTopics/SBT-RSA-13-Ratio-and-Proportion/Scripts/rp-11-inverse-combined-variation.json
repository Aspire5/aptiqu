    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "Inverse-square variation changes faster.\n\nIntensity ∝ 1/d².\nMove 3 times farther away and intensity becomes 1/9 as large.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_5_step"
        }
      ]
    },
    "teach_5_step": {
      "id": "teach_5_step",
      "type": "CONTENT",
      "content": {
        "text": "The scale factor is squared before taking the reciprocal.\n\nThis is why ‘three times farther’ does not mean ‘one-third as bright’ in an inverse-square law.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_5"
        }
      ]
    },
