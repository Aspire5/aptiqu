      "type": "CONTENT",
      "content": {
        "text": "If two wires have equal R, then L/r² must match.\n\nSo L₁/L₂ = r₁²/r₂². That can solve length without finding k.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
        }
      ]
    },
