{
  "schemaVersion": "1.0",
  "scriptId": "rp-11-inverse-combined-variation",
  "sourceType": "MANUAL",
  "metadata": {
    "title": "Inverse and Combined Variation",
    "description": "Use constant products and combined proportionality for speed-time, gears, inverse-square laws, and mixed direct/inverse relations.",
    "teachingApproach": "Contrast direct and inverse motion first: one rises while the other falls. Then use constant products, powers, and combined factors. Finish with a y=ax+b/x relation that needs two observations.",
    "targetDurationMinutes": 28,
    "sourceScope": "R.S. Aggarwal, Quantitative Aptitude for Competitive Examinations, Chapter 13, Ratio and Proportion. Approved scope: Teach inverse variation x ∝ 1/y -> xy=k and test possible pairs using the constant product. Cover equal-distance speed/time, gear revolutions versus number of cogs, inverse-square intensity, and combined forms such as resistance directly proportional to length and inversely proportional to radius squared. Include a relation made from one direct and one inverse term, y=ax+b/x, using two observations to determine constants."
  },
  "startNodeId": "start",
  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Inverse variation moves in the opposite direction: when one factor grows, the other must shrink to preserve the relationship.\n\nWe’ll use constant products, speed-time reversal, gears, inverse squares, and combined variation without memorising separate tricks.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "Inverse variation moves in opposite directions.\n\nIf y∝1/x, then xy=k.\nDouble x, and y must halve so the product stays fixed.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "If x=6 and y=8, k=48.\nAt x=12, y=48/12=4.\n\nThe constant product is the fastest check.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
