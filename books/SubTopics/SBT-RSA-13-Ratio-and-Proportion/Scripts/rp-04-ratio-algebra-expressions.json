    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "Fractions inside expressions often shrink after dividing by a common power.\n\nIf x:y=7:3, then\n(xy+y²)/(x²−y²).",
        "avatarPersona": "TUTOR"
