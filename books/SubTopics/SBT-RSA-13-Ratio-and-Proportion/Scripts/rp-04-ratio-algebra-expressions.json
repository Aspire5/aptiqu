    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "You can also solve backwards.\n\nIf (2x+3y):(3x+5y)=18:29, cross-multiply first.\n\n29(2x+3y)=18(3x+5y).",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "58x+87y=54x+90y\n4x=3y\n\nx:y = 3:4.\n\nNo individual value of x or y was needed.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
