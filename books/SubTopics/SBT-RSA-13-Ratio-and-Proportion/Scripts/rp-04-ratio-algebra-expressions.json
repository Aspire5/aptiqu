    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Squares still use the same substitution.\n\nIf x:y=3:2, then x²:y²=9:4.\n\nSo (2x²+3y²):(3x²−2y²) can be done with 9 and 4 directly.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "Numerator = 18+12=30.\nDenominator = 27−8=19.\n\nAnswer: 30:19.\n\nUse ratio parts first; avoid large algebra.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
