    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "A powerful property: if several pairs have the same ratio, any matching weighted sums keep that ratio.\n\nIf p:q=r:s=t:u=2:3, then\n(mp+nr+ot):(mq+ns+ou)=2:3.",
        "avatarPersona": "TUTOR"
