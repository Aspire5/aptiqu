        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "One clean result is:\nA:B:C = 8:12:15.\nC:D = 6:7 -> 15:17.5.\nMultiply all by 2: A:B:C:D = 16:24:30:35.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
