  "schemaVersion": "1.0",
  "scriptId": "rp-03-linking-chain-ratios",
  "sourceType": "MANUAL",
  "metadata": {
    "title": "Linking and Chaining Ratios",
    "description": "Combine pairwise ratios into one consistent multi-term ratio and then recover actual values when a total is given.",
    "teachingApproach": "Use a shared-middle story to show why pairwise ratios cannot simply be written side by side. Scale the common term, chain endpoints, interpret equal-multiple equations, and finish with a four-person total.",
    "targetDurationMinutes": 28,
    "sourceScope": "R.S. Aggarwal, Quantitative Aptitude for Competitive Examinations, Chapter 13, Ratio and Proportion. Approved scope: Teach how to combine A:B and B:C by making the shared term B equal, then extend to four quantities. Include pairwise ratios given as fractions, equations such as 2A=3B=4C, inverse-looking equalities, and chained relations across shares, ages or incomes. Show both the scale-to-common-middle method and the multiply-ratios shortcut for endpoints. End with using a chained ratio plus a total to recover actual values."
  },
  "startNodeId": "start",
  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Two ratio facts can look separate until you notice the shared term.\n\nWe’ll learn to make that shared term match, then build one clean chain such as A:B:C:D without guessing.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "Suppose A:B = 2:3 and B:C = 4:5.\n\nThe two B values must describe the same B, so make them equal.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "LCM of 3 and 4 is 12.\nA:B = 8:12\nB:C = 12:15\n\nSo A:B:C = 8:12:15.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
