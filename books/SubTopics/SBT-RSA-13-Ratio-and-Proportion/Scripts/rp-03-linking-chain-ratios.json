    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "If you only need the endpoints, you can multiply ratios.\n\nA/B = 3/4 and B/C = 5/7.\nThen A/C = (3/4)(5/7) = 15/28.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "The shared B cancels like a bridge.\n\nThis shortcut is excellent for A:C or A:D, but use common-middle scaling when you need every term together.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
