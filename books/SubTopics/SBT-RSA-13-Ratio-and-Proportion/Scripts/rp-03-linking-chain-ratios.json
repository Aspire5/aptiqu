    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "Equal-multiple equations are ratios in disguise.\n\n2A = 3B = 4C = k.\nThen A=k/2, B=k/3, C=k/4.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
