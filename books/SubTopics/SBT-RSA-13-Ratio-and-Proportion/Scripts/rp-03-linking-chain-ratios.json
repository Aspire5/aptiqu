    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "A four-link chain uses the same idea repeatedly.\n\nA:B=2:3, B:C=4:5, C:D=6:7.\nBuild A:B:C first, then match C with the third ratio.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
