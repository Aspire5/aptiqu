    "remedy_1": {
      "id": "remedy_1",
      "type": "CONTENT",
      "content": {
        "text": "A common slip here is to mix up which number is a price, quantity, or fraction.\n\nProfit = 20 on a cost of 80.\n\nProfit% = 20/80 ×100 = 25%.\n\nNow use the same idea on fresh values.",
        "avatarPersona": "TUTOR"
