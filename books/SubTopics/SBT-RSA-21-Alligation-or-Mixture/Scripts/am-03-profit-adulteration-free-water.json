    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "There is a quick result when a seller adds free water and sells at the pure milk cost.\n\nFor 25% profit, mixture cost must be 100/125 = 4/5 of milk cost.\n\nAlligation then gives water:milk = 1:4.",
        "avatarPersona": "TUTOR"
