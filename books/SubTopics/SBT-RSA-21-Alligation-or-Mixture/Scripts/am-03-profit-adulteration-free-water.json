      "type": "CONTENT",
      "content": {
        "text": "Let's rebuild this one from the quantities in the question.\n\n18/72 = 1/4, so profit = 25%.\n\nTry it again with that relationship in view.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "retry_1"
        }
