    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Water is a zero-cost ingredient.\n\nMilk costs ₹60, mixture must cost ₹50.\n\nWater : milk\n= (60−50):(50−0)\n= 10:50 = 1:5.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "So one part water joins five parts milk.\n\nThe mean is close to ₹60 because milk is most of the mixture.\n\nThis is ordinary alligation with one endpoint equal to zero.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
