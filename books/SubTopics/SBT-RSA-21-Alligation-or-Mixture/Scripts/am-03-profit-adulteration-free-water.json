    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "This is useful because some questions ask for ratio and others ask for percentage.\n\nratio a:b means first-component percentage = a/(a+b) ×100.\n\nDo not report the ratio-number itself as a percent.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
