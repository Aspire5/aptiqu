    "teach_5_step": {
      "id": "teach_5_step",
      "type": "CONTENT",
      "content": {
        "text": "So in this special setup:\nwater : milk = profit% : 100.\n\nAt 25% profit → 25:100 = 1:4.\nAt 20% profit → 20:100 = 1:5.\n\nUse it only when selling price equals the pure milk cost.",
        "avatarPersona": "TUTOR"
