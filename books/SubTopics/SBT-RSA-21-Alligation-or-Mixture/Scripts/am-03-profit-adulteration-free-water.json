    "teach_7": {
      "id": "teach_7",
      "type": "CONTENT",
      "content": {
        "text": "Profit rates themselves can be mixed.\n\nIf part of a stock earns 8% and the rest 18%, while the whole earns 14%, alligation gives:\n8%-part : 18%-part = 4:6 = 2:3.",
