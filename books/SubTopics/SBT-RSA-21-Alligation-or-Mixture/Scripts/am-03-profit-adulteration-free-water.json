    "teach_8": {
      "id": "teach_8",
      "type": "CONTENT",
      "content": {
        "text": "Capstone: do not mix the layers.\n\nFor a priced mixture sold at profit:\n1. Convert selling price to mixture cost.\n2. Use mixture cost as the mean in alligation.\n3. Convert the ratio to the quantity or percentage asked.\n\nEach step has one job.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_8_step"
        }
