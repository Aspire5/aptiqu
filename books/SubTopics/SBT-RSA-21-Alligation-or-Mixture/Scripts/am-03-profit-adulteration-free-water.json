    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Now reverse the profit.\n\nA mixture sells for ₹60 at 20% profit.\n\nSelling price = 120% of cost.\nSo mixture cost = 60×100/120 = ₹50.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "This reverse step must happen before alligation.\n\nIf pure milk costs ₹60 and water costs ₹0, then the target mean is ₹50 — not ₹60.\n\nUsing the selling price as the mean would hide the profit inside the mixture calculation.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
