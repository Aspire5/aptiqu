    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "A water:milk ratio can be turned into water percentage.\n\nIf water:milk = 1:4, total parts = 5.\nWater is 1/5 of the mixture = 20%.",
        "avatarPersona": "TUTOR"
