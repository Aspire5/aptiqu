        }
      ]
    },
    "teach_6_step": {
      "id": "teach_6_step",
      "type": "CONTENT",
      "content": {
        "text": "Alligation gives cheaper:dearer\n= (80−60):(60−50)\n= 20:10 = 2:1.\n\nThe profit step sets the target mean. The alligation step sets the ingredient ratio.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
        }
      ]
    },
