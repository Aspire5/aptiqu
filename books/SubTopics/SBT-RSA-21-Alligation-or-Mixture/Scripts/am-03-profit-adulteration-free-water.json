    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "Profit can be combined with two priced ingredients.\n\nSuppose a mixture sells for ₹72 at 20% profit.\nFirst recover mixture cost: 72×100/120 = ₹60.\n\nNow mix ingredients costing ₹50 and ₹80 to mean ₹60.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
