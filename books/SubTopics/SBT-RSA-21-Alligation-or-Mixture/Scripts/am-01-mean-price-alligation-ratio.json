    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "The direction of the ratio matters.\n\nFor ₹12 and ₹20 mixed to mean ₹18:\n\ncheaper : dearer = (20−18):(18−12)\n= 2:6 = 1:3.\n\nSo we use three times as much of the dearer item.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "A quick sense-check helps.\n\n₹18 is much closer to ₹20 than to ₹12.\nSo the mixture should contain more of the ₹20 ingredient.\n\nIf your ratio says more of the cheaper one, you probably read the cross-differences backwards.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
