    "teach_7": {
      "id": "teach_7",
      "type": "CONTENT",
      "content": {
        "text": "Alligation is not only about rupees. It works for any weighted value.\n\nMix a 20% solution with a 50% solution to get 30%.\n\nQuantity of 20% : quantity of 50%\n= (50−30):(30−20)\n= 20:10 = 2:1.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_7_step"
        }
      ]
    },
    "teach_7_step": {
      "id": "teach_7_step",
      "type": "CONTENT",
      "content": {
        "text": "The numbers can be prices, alcohol percentages, milk fractions, or profit rates.\n\nThe structure is the same: two endpoint values and one target mean between them.\n\nChoose one value to track and stay with it throughout.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_7"
        }
      ]
    },
