    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Now make the quantities unequal.\n\nMix 3 kg at ₹20/kg with 1 kg at ₹30/kg.\n\nTotal cost = 3×20 + 1×30 = ₹90.\nTotal quantity = 4 kg.\n\nMean price = 90 ÷ 4 = ₹22.50/kg.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Notice where ₹22.50 sits: much closer to ₹20 than to ₹30.\n\nWhy? Because there is more of the cheaper ingredient.\n\nA weighted mean is pulled toward the ingredient used in greater quantity.\n\nThis idea is exactly what alligation turns into a shortcut.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
