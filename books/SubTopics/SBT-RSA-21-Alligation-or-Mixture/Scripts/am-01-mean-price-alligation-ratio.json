    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Suppose we want a mixture worth ₹23/kg from ingredients costing ₹20 and ₹32.\n\nThe mean is ₹3 above the cheaper price and ₹9 below the dearer price.\n\nThose gaps tell us the opposite quantities:\ncheaper : dearer = 9 : 3 = 3 : 1.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "This is the alligation rule:\n\ncheaper : dearer\n= (dearer − mean) : (mean − cheaper)\n\nThe differences cross over.\n\nThe larger gap from ₹32 down to ₹23 gives the larger amount of the cheaper ingredient.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
