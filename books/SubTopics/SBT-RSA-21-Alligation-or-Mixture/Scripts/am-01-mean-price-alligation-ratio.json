    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "Sometimes one quantity is already given.\n\nIf cheaper : dearer = 3:5 and the dearer amount is 35 kg, then 5 parts = 35 kg.\n\nOne part = 7 kg.\nCheaper amount = 3×7 = 21 kg.",
