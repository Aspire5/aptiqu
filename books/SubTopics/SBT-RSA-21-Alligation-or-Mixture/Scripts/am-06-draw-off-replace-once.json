    "teach_8": {
      "id": "teach_8",
      "type": "CONTENT",
      "content": {
        "text": "Capstone: use direct bookkeeping when the story changes composition once.\n\nStart from actual component amounts, remove each component in proportion, add the refill, then form the requested ratio or percentage.\n\nThe algebra stays small when every line has a physical meaning.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_8_step"
        }
      ]
    },
