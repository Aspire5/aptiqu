    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "We can solve for the withdrawal needed.\n\nAn 8 L vessel has water:syrup = 3:5. Let x L be removed and replaced with water.\n\nRemoved water = 3x/8; removed syrup = 5x/8.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "Final water = 3−3x/8+x.\nFinal syrup = 5−5x/8.\n\nFor equal parts, set them equal.\nThis gives x = 8/5 L, which is 1/5 of the vessel.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
