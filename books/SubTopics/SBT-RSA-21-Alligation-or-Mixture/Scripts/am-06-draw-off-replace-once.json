    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Now replace the removed sample with pure water.\n\nStart with 25 L at milk:water=3:2 → milk 15, water 10.\nRemove 5 L → milk 3 and water 2 leave.\nRemaining: milk 12, water 8.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Add 5 L water back.\nFinal: milk 12, water 13.\n\nThe total returns to 25 L, but the composition changes because the replacement is pure water rather than the original mixture.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
