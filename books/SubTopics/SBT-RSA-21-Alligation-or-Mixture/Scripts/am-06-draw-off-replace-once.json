    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "Reverse questions often hide the original scale.\n\nSuppose a vessel starts with A:B=7:5, so quantities are 7x and 5x. Remove 9 L of mixture, then fill with B.\n\nThe 9 L sample removes A:B in 7:5.",
        "avatarPersona": "TUTOR"
