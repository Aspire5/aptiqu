          "targetNodeId": "teach_7_step"
        }
      ]
    },
    "teach_7_step": {
      "id": "teach_7_step",
      "type": "CONTENT",
      "content": {
        "text": "A good check is total volume.\n\nIf 8 L is removed and 8 L added, the vessel must finish at its original volume.\n\nIf your component totals add to something else, recheck the removal or refill.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_7"
        }
      ]
    },
