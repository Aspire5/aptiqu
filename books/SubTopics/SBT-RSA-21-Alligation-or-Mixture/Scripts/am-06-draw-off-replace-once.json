    "teach_7": {
      "id": "teach_7",
      "type": "CONTENT",
      "content": {
        "text": "One-operation replacement is a two-move story:\n\n1. Remove a sample in the vessel's current composition.\n2. Add the replacement in its own composition.\n\nSkipping either composition is the common trap.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
