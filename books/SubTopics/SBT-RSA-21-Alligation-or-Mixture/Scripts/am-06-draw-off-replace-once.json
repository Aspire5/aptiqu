    },
    "teach_6_step": {
      "id": "teach_6_step",
      "type": "CONTENT",
      "content": {
        "text": "For a 10 L replacement in a 50 L vessel:\nactive lost = 10×0.60 = 6 L\nactive added = 10×0.20 = 2 L\nnet active loss = 4 L.\n\nTrack the chosen component through both moves.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
        }
      ]
