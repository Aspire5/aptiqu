    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "Replacement can also be with another solution, not a pure component.\n\nIf the original is 60% active and the replacement is 20% active, then the removed sample takes out 60% active while the refill adds back only 20% active.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
