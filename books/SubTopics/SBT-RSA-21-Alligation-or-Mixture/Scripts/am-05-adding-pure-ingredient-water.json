      "id": "teach_8_step",
      "type": "CONTENT",
      "content": {
        "text": "The answer should also pass a direction check.\n\nAdding water cannot increase milk percentage. Adding milk cannot increase water percentage.\n\nThat simple logic catches many algebra slips instantly.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_8"
        }
      ]
    },
