    "teach_7_step": {
      "id": "teach_7_step",
      "type": "CONTENT",
      "content": {
        "text": "A quick check: adding water must lower the percentage of the other component; adding pure component must raise it.\n\nIf your result moves the percentage in the wrong direction, the setup is wrong even before you finish the arithmetic.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_7"
        }
      ]
    },
