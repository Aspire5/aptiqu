    "teach_8": {
      "id": "teach_8",
      "type": "CONTENT",
      "content": {
        "text": "Capstone: translate, anchor, solve, check.\n\n1. Convert ratio or percentage into actual component amounts.\n2. Identify the untouched component.\n3. Use the target composition to find the new amount of the changed component.\n4. Subtract to get what was added.",
        "avatarPersona": "TUTOR"
