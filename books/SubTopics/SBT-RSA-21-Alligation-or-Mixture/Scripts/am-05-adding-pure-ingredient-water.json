    "teach_7": {
      "id": "teach_7",
      "type": "CONTENT",
      "content": {
        "text": "If you add water, the amount of solute does not change. If you add pure solute, the amount of water does not change.\n\nThat sentence is more useful than memorising separate formulas.\n\nChoose the fixed component before touching the numbers.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_7_step"
        }
