    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Percentage targets are just ratios in another form.\n\nA 30 L mixture has 70% milk, so milk=21 L and water=9 L.\n\nAdd water until water becomes 40% of the final mixture.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "If water is 40%, milk is 60%.\nTarget milk:water = 60:40 = 3:2.\n\nMilk stays 21 L, so target water = 14 L.\nAdd 14−9 = 5 L water.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
