    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "You can solve many addition problems by preserving one component.\n\nIf milk stays fixed at M and target milk fraction is f, final total must be M/f.\n\nThen added water = final total − original total.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_6_step"
        }
      ]
    },
    "teach_6_step": {
      "id": "teach_6_step",
      "type": "CONTENT",
      "content": {
        "text": "Example: 36 L mixture is 2/3 milk. Milk=24 L. Want 60% milk.\n\nFinal total=24/0.60=40 L.\nSo add 4 L water.\n\nThis is a fast percentage shortcut built from the same anchor idea.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
        }
      ]
    },
