    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Adding the pure first component works the same way.\n\nMilk:water = 2:3 in 25 L means milk 10 L and water 15 L.\n\nAdd only milk, so water stays 15 L.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "To reach milk:water = 4:3 with water fixed at 15 L, milk must be 20 L.\n\nMilk currently 10 L, so add 10 L.\n\nAnchor the component that is not being added.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
