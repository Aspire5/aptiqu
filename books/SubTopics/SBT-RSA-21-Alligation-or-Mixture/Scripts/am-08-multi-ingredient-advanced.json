    "teach_7": {
      "id": "teach_7",
      "type": "CONTENT",
      "content": {
        "text": "Method choice matters more than formula choice.\n\nUse alligation when two endpoint values combine to a target mean.\nUse direct balance when components are physically added or removed.\nUse weighted-average algebra when quantities are already known or when one price is unknown.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_7_step"
        }
      ]
    },
    "teach_7_step": {
      "id": "teach_7_step",
      "type": "CONTENT",
      "content": {
        "text": "Before calculating, ask: what stays conserved?\n\nCost/value is conserved in price mixtures.\nComponent quantity is tracked in add/remove stories.\nTotal volume is restored in draw-and-replace.\n\nThat question points to the right model.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_7"
        }
      ]
    },
