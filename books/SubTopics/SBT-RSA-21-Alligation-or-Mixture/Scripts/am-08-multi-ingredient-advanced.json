    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "Profit percentages can be treated as mixture values too.\n\nSuppose one batch earns 8%, another 18%, and overall profit is 14%.\n\nThe batch ratio is 2:3 by alligation.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
