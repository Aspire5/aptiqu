      },
      "input": {
        "type": "CHOICE",
        "options": [
          {
            "id": "a",
            "label": "60 L"
          },
          {
            "id": "b",
            "label": "90 L"
          },
          {
            "id": "c",
            "label": "70 L"
          },
          {
            "id": "d",
            "label": "80 L"
          }
        ]
      },
