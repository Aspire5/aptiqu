    "teach_8": {
      "id": "teach_8",
      "type": "CONTENT",
      "content": {
        "text": "Capstone: hard mixture questions often combine two models, but only one at a time.\n\nYou might first use profit to recover mean cost, then alligation for a ratio. Or first remove a proportional sample, then use a component equation after adding pure ingredients.\n\nKeep the stages separate.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_8_step"
        }
      ]
    },
    "teach_8_step": {
      "id": "teach_8_step",
      "type": "CONTENT",
      "content": {
        "text": "A clear solution should let you say what every number means.\n\nIf a number is a price, do not suddenly use it as a quantity. If a ratio is a component ratio, do not treat its first term as a percentage.\n\nMeaning first, arithmetic second.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_8"
        }
      ]
    },
