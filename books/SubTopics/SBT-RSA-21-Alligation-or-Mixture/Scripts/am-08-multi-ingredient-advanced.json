          "targetNodeId": "teach_6_step"
        }
      ]
    },
    "teach_6_step": {
      "id": "teach_6_step",
      "type": "CONTENT",
      "content": {
        "text": "If total stock is 1000 kg, five parts make 1000 kg.\nOne part=200 kg.\n\nThe 18% batch is 3×200 = 600 kg.\n\nThis joins alligation with ratio-to-quantity scaling.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
        }
      ]
    },
