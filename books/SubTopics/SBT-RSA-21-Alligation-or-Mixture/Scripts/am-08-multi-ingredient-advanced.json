    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "If one ingredient quantity is known, target mean can reveal the other quantity.\n\n35 kg at ₹60 is mixed with x kg at ₹75 to make a ₹66 mixture.\n\n35×60 + 75x = 66(35+x).",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "2100 + 75x = 2310 + 66x\n9x = 210\nx = 23⅓ kg.\n\nAlligation could also give the ratio first; direct total-value algebra is often clearer when one quantity is already known.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
