    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "After removing a proportional sample, pure ingredients may be added back.\n\nStart 4x,6x,5x. Remove 15 L → remove 4,6,5.\nThen add 8 L grape and 2 L pineapple.\n\nNew grape = 4x−4+8 = 4x+4.\nNew pineapple = 6x−6+2 = 6x−4.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "If the story says pineapple ends 10 L above grape:\n(6x−4)−(4x+4)=10\n2x−8=10\nx=9.\n\nOriginal total = 15x = 135 L.\n\nEvery term has a clear component meaning.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
