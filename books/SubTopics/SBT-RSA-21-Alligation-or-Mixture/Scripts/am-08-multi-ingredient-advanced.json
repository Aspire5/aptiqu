    "teach_5_step": {
      "id": "teach_5_step",
      "type": "CONTENT",
      "content": {
        "text": "For costs ₹85 and ₹115 around mean ₹100:\ncheaper:dearer = 15:15 = 1:1.\n\nProfit determines the mean cost; alligation determines the ingredient relationship.",
        "avatarPersona": "TUTOR"
