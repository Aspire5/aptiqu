    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "If the mixing ratio is known, use ratio-parts as weights.\n\nPrices ₹14 and ₹26 are mixed in ratio 3:1.\n\nMean = (3×14 + 1×26) ÷ 4\n= (42+26)÷4\n= ₹17/kg.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "The actual kilograms do not matter.\n\nA 3:1 ratio could mean 3 kg and 1 kg, or 30 kg and 10 kg. The mean is the same because the weights stay proportional.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
