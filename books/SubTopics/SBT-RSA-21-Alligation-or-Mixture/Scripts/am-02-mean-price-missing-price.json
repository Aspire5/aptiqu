    "teach_8": {
      "id": "teach_8",
      "type": "CONTENT",
      "content": {
        "text": "Capstone: choose the shortest weighted-average route.\n\nIf two known varieties are equal, combine them first. If a ratio is already given, use ratio-parts as weights. If a quantity is missing, use target total value minus known value.\n\nAll three are the same idea seen from different sides.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_8_step"
        }
      ]
    },
    "teach_8_step": {
      "id": "teach_8_step",
      "type": "CONTENT",
      "content": {
        "text": "A good final check asks two questions:\n\n1. Does the mean sit between the component values?\n2. Is it closer to the component used more heavily?\n\nIf either fails, recheck the weights before doing more algebra.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_8"
        }
      ]
    },
