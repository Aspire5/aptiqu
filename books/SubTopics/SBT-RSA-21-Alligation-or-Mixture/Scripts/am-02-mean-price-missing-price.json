    "teach_5_step": {
      "id": "teach_5_step",
      "type": "CONTENT",
      "content": {
        "text": "Now the problem has only two effective components: ₹120 and ₹x, mixed 1:1.\n\nIf the final mean is ₹150, then (120+x)/2 = 150, so x = ₹180.\n\nCombining a balanced subgroup first can make a three-item question look like a two-item one.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_5"
        }
      ]
    },
