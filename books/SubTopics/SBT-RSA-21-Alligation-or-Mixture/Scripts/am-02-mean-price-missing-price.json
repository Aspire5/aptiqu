    "teach_7": {
      "id": "teach_7",
      "type": "CONTENT",
      "content": {
        "text": "Alligation can reverse that profit question too.\n\nIf one part earns 8%, another 18%, and the overall profit is 14%, then:\nfirst : second = (18−14):(14−8) = 4:6 = 2:3.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_7_step"
        }
      ]
    },
    "teach_7_step": {
      "id": "teach_7_step",
      "type": "CONTENT",
      "content": {
        "text": "This is exactly the same geometry as ingredient prices.\n\nThe overall profit 14% lies closer to 18%, so more stock must have been sold at 18% profit.\n\nAlligation is a weighted-average shortcut, not a chapter-specific trick.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_7"
        }
      ]
    },
