    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "Three varieties can often be simplified before solving.\n\nSuppose ₹100 and ₹140 teas are mixed equally, and that combined group is mixed with a third tea in an equal total quantity.\n\nThe first two together average to ₹120/kg.",
        "avatarPersona": "TUTOR"
