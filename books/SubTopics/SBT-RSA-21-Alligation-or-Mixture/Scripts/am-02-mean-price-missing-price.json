    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "Weighted averages also work for profit percentages.\n\nSuppose half a stock is sold at 10% profit and half at 20%.\n\nEqual amounts mean the overall profit is the simple average: 15%.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_6_step"
        }
      ]
    },
    "teach_6_step": {
      "id": "teach_6_step",
      "type": "CONTENT",
      "content": {
        "text": "If the amounts are unequal, weight the profit rates.\n\nFor 2 parts at 8% and 3 parts at 18%:\noverall profit = (2×8 + 3×18)÷5\n= 70÷5 = 14%.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
        }
      ]
    },
