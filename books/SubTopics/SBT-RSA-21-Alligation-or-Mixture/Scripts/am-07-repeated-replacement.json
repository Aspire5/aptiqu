    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Repeat the same 4 L operation on the 40 L vessel.\n\nAfter one round, milk is multiplied by 9/10.\nAfter two rounds, multiply by 9/10 again.\n\nMilk left = 40×(9/10)².",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "That gives 40×81/100 = 32.4 L.\n\nAfter n equal operations:\npure liquid left = x(1−y/x)^n.\n\nThe exponent n counts complete remove-and-refill rounds.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
