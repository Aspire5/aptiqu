    "teach_7": {
      "id": "teach_7",
      "type": "CONTENT",
      "content": {
        "text": "The standard shortcut assumes every round starts with the same total volume and removes the same amount y.\n\nIf the withdrawal changes from round to round, use a new retention factor each time instead of one exponent.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
