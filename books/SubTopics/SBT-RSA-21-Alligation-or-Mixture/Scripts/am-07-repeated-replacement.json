    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "For three operations, the factor is cubed.\n\n40 L, remove 4 L each time:\n40×(9/10)³\n= 40×729/1000\n= 29.16 L.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "The drop gets smaller each round because later samples contain some replacement water.\n\nThat is why subtracting 4 L of milk three times would be wrong. The sample is mixture, not pure milk, after the first refill.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
