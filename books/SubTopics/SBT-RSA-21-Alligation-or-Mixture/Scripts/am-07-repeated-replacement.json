    "teach_7_step": {
      "id": "teach_7_step",
      "type": "CONTENT",
      "content": {
        "text": "Example: 20 L vessel, remove 5 L first → retain 3/4. Then remove 4 L → retain 4/5.\n\nOriginal liquid left = 20×3/4×4/5 = 12 L.\n\nSame idea, different factors.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
