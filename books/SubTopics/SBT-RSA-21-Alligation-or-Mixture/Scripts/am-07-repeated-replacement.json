    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "Once we know original liquid left, replacement liquid is easy.\n\nThe vessel still contains its full capacity.\n\nreplacement liquid = total capacity − original liquid left.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
