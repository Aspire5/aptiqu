    "teach_8": {
      "id": "teach_8",
      "type": "CONTENT",
      "content": {
        "text": "Capstone: repeated replacement is repeated multiplication, not repeated subtraction.\n\nEach round keeps a fixed fraction of whatever original liquid is present at that moment.\n\nThat is why powers appear naturally.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_8_step"
        }
      ]
    },
    "teach_8_step": {
      "id": "teach_8_step",
      "type": "CONTENT",
      "content": {
        "text": "Final checklist:\n1. Find retained fraction per round.\n2. Raise it to number of equal rounds, or multiply changing factors.\n3. Multiply by capacity for original liquid left.\n4. Subtract from total for replacement liquid.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_8"
        }
      ]
    },
