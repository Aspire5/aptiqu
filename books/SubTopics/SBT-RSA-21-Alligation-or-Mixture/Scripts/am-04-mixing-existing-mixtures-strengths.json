    "remedy_1": {
      "id": "remedy_1",
      "type": "CONTENT",
      "content": {
        "text": "A common slip here is to mix up which number is a price, quantity, or fraction.\n\nTrack the same component in all three percentages.\n\n70%-mix : 40%-mix = (50−40):(70−50)=10:20=1:2.\n\nNow use the same idea on fresh values.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "retry_1"
        }
      ]
    },
    "retry_remedy_1": {
      "id": "retry_remedy_1",
      "type": "CONTENT",
      "content": {
        "text": "Let's rebuild this one from the quantities in the question.\n\n15:45 = 1:3.\n\nTry it again with that relationship in view.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "retry_1"
        }
      ]
