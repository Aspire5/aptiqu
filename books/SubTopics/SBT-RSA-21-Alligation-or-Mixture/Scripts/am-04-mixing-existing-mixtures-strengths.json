    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "Sometimes the target is given as a ratio, not a percentage.\n\nTarget milk:water = 7:3 means milk fraction = 7/10 = 70%.\n\nConvert that first, then alligate against the source strengths.",
