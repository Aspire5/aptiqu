    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "For sources at 80% and 50% milk:\nA:B = (70−50):(80−70) = 20:10 = 2:1.\n\nThe conversion is not extra work; it puts every mixture on one common scale.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
