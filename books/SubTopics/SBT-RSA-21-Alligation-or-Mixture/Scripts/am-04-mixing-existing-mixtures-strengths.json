    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Ratio form must be turned into a fraction first.\n\nMilk:water = 3:2 means milk is 3/(3+2) = 3/5 = 60% of the mixture.\n\nMilk:water = 1:3 means milk is 1/4 = 25%.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Now the two prepared mixtures can be compared on the same scale: milk percentage.\n\nDo not alligate the raw ratio-numbers 3 and 1. Their denominators are different, so they are not directly comparable strengths.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
