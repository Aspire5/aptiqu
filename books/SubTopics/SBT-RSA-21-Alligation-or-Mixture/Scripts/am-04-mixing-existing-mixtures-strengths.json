    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Now mix two ratio-based mixtures.\n\nA has milk:water = 3:1 → milk 75%.\nB has milk:water = 1:1 → milk 50%.\nTarget is milk:water = 3:2 → milk 60%.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "Alligation on milk percentage:\nA:B = (60−50):(75−60)\n= 10:15 = 2:3.\n\nThe target 60% is closer to B's 50%, so more of B is needed.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
