    "teach_7": {
      "id": "teach_7",
      "type": "CONTENT",
      "content": {
        "text": "The replaced fraction need not be one-half.\n\nStart 80%, replace with 20%, finish 65%.\n\nretained:added = (65−20):(80−65) = 45:15 = 3:1.\n\nSo replacement is 1 out of 4 total parts = 1/4 of the jar.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_7_step"
        }
      ]
    },
    "teach_7_step": {
      "id": "teach_7_step",
      "type": "CONTENT",
      "content": {
        "text": "Notice the language: alligation gives retained amount : replacement amount.\n\nThe fraction replaced is replacement parts divided by total parts.\n\nDo not report 1:3 as the fraction; convert the ratio to a part of the whole.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_7"
        }
      ]
    },
