    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "A replacement by a weaker solution is also a mixing problem.\n\nA jar starts at 50% alcohol. Part is replaced by 20% alcohol solution, and final strength is 35%.\n\nThe final jar is a weighted mix of retained 50% liquid and added 20% liquid.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_6_step"
        }
      ]
    },
    "teach_6_step": {
      "id": "teach_6_step",
      "type": "CONTENT",
      "content": {
        "text": "Alligation gives retained:replaced\n= (35−20):(50−35) = 15:15 = 1:1.\n\nSo half the jar was replaced.\n\nThis works because the final total volume is restored to the original level.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
        }
      ]
    },
