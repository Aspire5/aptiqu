    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "If the final amount is given, split it after finding the ratio.\n\nSuppose A:B = 2:3 and we need 25 litres total.\n\nFive parts make 25 litres, so one part is 5 litres.\nA = 10 litres, B = 15 litres.",
