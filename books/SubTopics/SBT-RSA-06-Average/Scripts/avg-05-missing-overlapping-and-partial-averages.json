    "recap": {
      "id": "recap",
      "type": "CONTENT",
      "content": {
        "text": "Partial-average problems are bookkeeping with totals.\n\nMark which observations belong to each subtotal.\nIf two groups overlap, their shared observations are counted twice when subtotals are added.\nFor data sufficiency, stop and ask whether the target is uniquely determined before doing extra arithmetic.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
