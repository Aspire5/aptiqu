    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "A remainder group works the same way.\n\nTwelve observations average 35, so total = 420. The first four average 29, so they total 116.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "The remaining eight total:\n420 − 116 = 304\n\nTheir average = 304 ÷ 8 = 38\n\nSubtract totals first; divide only after you know the remaining count.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
