    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "Shifted windows can cancel almost everything.\n\nDays 1–3 average 24, so their sum is 72. Days 2–4 average 20, so their sum is 60.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_6_step"
        }
      ]
