    "concept_1": {
      "id": "concept_1",
      "type": "CONTENT",
      "content": {
        "text": "Partial averages become partial totals.\n\nFive numbers average 30 → total 150.\nFirst two average 20 → total 40.\nLast two average 35 → total 70.\n\nThe middle number is 150−40−70=40.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
