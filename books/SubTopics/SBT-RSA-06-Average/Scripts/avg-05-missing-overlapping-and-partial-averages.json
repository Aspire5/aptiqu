    "concept_3": {
      "id": "concept_3",
      "type": "CONTENT",
      "content": {
        "text": "Pairwise averages can reveal individual values.\n\nIf average of A and B is 20, then A+B=40.\nIf B+C averages 19, B+C=38.\nIf A+C averages 21, A+C=42.\n\nAdd all three equations: 2(A+B+C)=120, so A+B+C=60. Then subtract a pair sum to get the remaining person.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
