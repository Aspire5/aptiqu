    "concept_6": {
      "id": "concept_6",
      "type": "CONTENT",
      "content": {
        "text": "Some objective questions ask whether the information is enough.\n\nTranslate each statement into sums, then ask: can the target be found uniquely?\n\nIf A+B+C is known and B+D+E is known, adding them gives A+C+D+E+2B. To find A+B+C+D+E, you still need B. Without it, the five-person average is not fixed.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
        }
      ]
    },
    "q_6": {
      "id": "q_6",
      "type": "CHOICE",
      "input": {
        "type": "CHOICE",
        "options": [
          {
            "id": "a",
            "label": "No"
          },
          {
            "id": "b",
            "label": "Yes, it is 270"
          },
          {
            "id": "c",
            "label": "Yes, it is 135"
          },
          {
            "id": "d",
            "label": "Only if A=C"
          }
        ]
      },
      "content": {
        "text": "You know A+B+C=150 and B+D+E=120. Can you determine A+B+C+D+E without knowing B?",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "condition": {
            "field": "isCorrect",
            "value": true,
            "operator": "EQUALS"
          },
          "targetNodeId": "recap"
