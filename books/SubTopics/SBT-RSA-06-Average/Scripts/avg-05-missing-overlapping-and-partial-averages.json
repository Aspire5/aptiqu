    "teach_8_step": {
      "id": "teach_8_step",
      "type": "CONTENT",
      "content": {
        "text": "The last three therefore total 156 − 88 = 68.\n\nIf the sixth is x, the seventh x+4 and the eighth x+7:\n\nx + (x+4) + (x+7) = 68\n3x + 11 = 68\nx = 19\n\nThe average information first creates the subtotal; the differences then split it.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_8"
        }
      ]
    },
