    "teach_8": {
      "id": "teach_8",
      "type": "CONTENT",
      "content": {
        "text": "Capstone: combine subset totals with a relationship among the last values.\n\nEight numbers average 19.5, so total = 156. The first two average 14, giving 28. The next three average 20, giving 60.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
