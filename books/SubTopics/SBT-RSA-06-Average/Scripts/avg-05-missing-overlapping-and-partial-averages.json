    "teach_6_step": {
      "id": "teach_6_step",
      "type": "CONTENT",
      "content": {
        "text": "Subtract the second window from the first:\n\n(day1 + day2 + day3) − (day2 + day3 + day4) = 72 − 60\nDay1 − Day4 = 12\n\nIf Day 4 is 15, Day 1 is 27. The shared middle days disappear automatically.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
        }
      ]
    },
