    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "Run rate is another average: runs ÷ overs.\n\nSuppose the first 10 overs run at 4.2 runs per over. Runs already scored = 10×4.2 = 42.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "If the target total is 242 in 50 overs, the remaining 40 overs need 200 runs.\n\nRequired run rate = 200 ÷ 40 = 5.\n\nAlways subtract runs already scored before dividing by overs left.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
