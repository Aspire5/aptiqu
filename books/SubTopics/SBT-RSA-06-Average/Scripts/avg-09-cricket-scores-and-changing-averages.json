    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Removing highest and lowest scores is also a total difference.\n\nTwenty innings average 50 → total 1000. Remove the highest and lowest, and the remaining 18 average 45 → total 810.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "Highest + lowest = 1000 − 810 = 190.\nIf highest exceeds lowest by 50:\nH + L = 190\nH − L = 50\n2H = 240\nH = 120.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
