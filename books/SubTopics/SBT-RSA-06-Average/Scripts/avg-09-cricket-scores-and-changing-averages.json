    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Sometimes the question tells you how much the average rises and asks for the new score.\n\nAfter 20 innings, average = 30. After the 21st, average = 32.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Old total = 20×30 = 600\nNew total = 21×32 = 672\n21st score = 672 − 600 = 72\n\nA 2-run rise in average across 21 innings needs far more than a 2-run innings.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
