    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "Bowling average means runs conceded per wicket.\n\nSuppose a bowler's average is 15 after x wickets. He then takes 4 wickets for 20 runs, and the average becomes 14.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_6_step"
        }
      ]
    },
    "teach_6_step": {
      "id": "teach_6_step",
      "type": "CONTENT",
      "content": {
        "text": "Old runs = 15x\nNew runs = 15x + 20\nNew wickets = x + 4\n\n(15x+20)/(x+4)=14\n15x+20=14x+56\nx=36 wickets.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
        }
      ]
    },
