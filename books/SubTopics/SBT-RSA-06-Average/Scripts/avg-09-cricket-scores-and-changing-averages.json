    "concept_1": {
      "id": "concept_1",
      "type": "CONTENT",
      "content": {
        "text": "A player's average after n innings represents a total score of n×average.\n\nIf the next innings changes the average, write old total + new score = new count × new average.\n\nThe chapter uses this pattern repeatedly.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
