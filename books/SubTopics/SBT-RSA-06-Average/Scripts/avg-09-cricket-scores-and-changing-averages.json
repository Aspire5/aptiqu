    "concept_3": {
      "id": "concept_3",
      "type": "CONTENT",
      "content": {
        "text": "If the highest and lowest scores are removed, compare totals.\n\nWhole total = all innings × whole average.\nMiddle total = remaining innings × remaining average.\n\nHighest + lowest = whole total − middle total.\nIf their difference is also known, solve the two equations.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
