  "schemaVersion": "1.0",
  "scriptId": "avg-09-cricket-scores-and-changing-averages",
  "sourceType": "MANUAL",
  "metadata": {
    "title": "Cricket, Scores and Changing Performance Averages",
    "description": "Turn innings, run rates, bowling figures and exam averages back into totals before making the next change.",
    "teachingApproach": "Use cricket as a repeated demonstration that an average hides a total. Build from adding a new innings to finding the score needed for a desired average, removing extremes, target run rates, captain-vs-teammate comparisons and bowling averages. Then transfer the same logic to exam-average changes and finish with a hypothetical team-score adjustment.",
    "targetDurationMinutes": 30,
    "sourceScope": "Teach performance averages through the same total-first habit. Cover a new innings changing a batting average, finding the required next score, removing highest and lowest scores, target run rate after completed overs, a captain scoring above the average of teammates, bowling average after new wickets, examination-paper averages changed by bonus marks, and a team-score capstone where one score is hypothetically changed. Always distinguish old count from new count."
  },
  "startNodeId": "start",
  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Let's learn the average questions where one new performance changes everything.\n\nRuns per innings, runs per over and runs per wicket all look different, but each one becomes manageable when we rebuild the old total before making the change.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "A batting average is total runs ÷ innings.\n\nAfter 10 innings, a batsman averages 40, so he has 400 runs. He then scores 62 in the 11th innings.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "New total = 462\nNew innings = 11\nNew average = 462 ÷ 11 = 42\n\nThe new score does not simply get averaged with the old average; the old average represents ten innings.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
    "q_1": {
      "id": "q_1",
      "type": "CHOICE",
