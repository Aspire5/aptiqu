  "schemaVersion": "1.0",
  "scriptId": "avg-02-consecutive-and-patterned-averages",
  "sourceType": "MANUAL",
  "metadata": {
    "title": "Consecutive and Patterned Averages",
    "description": "Use symmetry to average consecutive numbers, odd/even runs, natural numbers, multiples and filtered sequences without long addition.",
    "teachingApproach": "Start with a visually balanced five-number run, then generalise the centre/midpoint idea to even counts, larger equal gaps, odd/even sequences, first-n natural numbers, first-n multiples and filtered intervals. Finish by extending a consecutive run so the learner sees the mean move with the centre. Use symmetry before formulas, then connect the shortcut back to the chapter's sum method.",
    "targetDurationMinutes": 28,
    "sourceScope": "Teach the centre-of-a-balanced-list idea first: an odd equally spaced list averages to its middle term, while an even list averages to the midpoint of its two middle terms or endpoints. Extend this to consecutive integers, consecutive odd/even numbers, the first n natural numbers and the first n multiples of a number. Then handle numbers in an interval that satisfy a condition by identifying the correct list before averaging. End by showing how the average moves when the next terms of a consecutive sequence are appended."
  },
  "startNodeId": "start",
  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Let's make long-looking averages collapse to one glance.\n\nWhen numbers are evenly spaced, values below the centre pair with values above it. That balance is the shortcut we will use throughout this lesson.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "Look at five consecutive numbers:\n\n17, 18, 19, 20, 21\n\nThey balance perfectly around 19.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "Pair the ends:\n17 and 21 average 19.\n18 and 20 average 19.\nThe middle is already 19.\n\nSo the average of an odd number of consecutive values is the middle value.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
