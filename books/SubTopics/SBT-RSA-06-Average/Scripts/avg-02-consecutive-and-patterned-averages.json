    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "With an even number of consecutive values there is no single middle term.\n\n12, 13, 14, 15\n\nThe two middle terms are 13 and 14.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Their midpoint is:\n\n(13 + 14) ÷ 2 = 13.5\n\nThe same answer comes from averaging the endpoints: (12 + 15) ÷ 2 = 13.5.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
