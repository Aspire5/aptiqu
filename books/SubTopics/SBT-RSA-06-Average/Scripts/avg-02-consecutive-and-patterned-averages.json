    "concept_2": {
      "id": "concept_2",
      "type": "CONTENT",
      "content": {
        "text": "The first n multiples of k are:\nk, 2k, 3k, ..., nk.\n\nTheir total is k(1+2+...+n), so their average is:\n\nk(n+1)/2.\n\nThe chapter uses this for the first 20 multiples of 7.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
