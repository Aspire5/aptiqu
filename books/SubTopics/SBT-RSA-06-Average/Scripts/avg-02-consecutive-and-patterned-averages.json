    "teach_8": {
      "id": "teach_8",
      "type": "CONTENT",
      "content": {
        "text": "A consecutive list can grow while keeping its symmetry visible.\n\nFive consecutive numbers have average 30, so they are 28, 29, 30, 31, 32.",
