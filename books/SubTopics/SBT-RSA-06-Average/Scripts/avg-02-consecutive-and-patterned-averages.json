    "concept_3": {
      "id": "concept_3",
      "type": "CONTENT",
      "content": {
        "text": "For an odd number of consecutive integers, the average is the middle number.\n\nExample: 46,47,48,49,50.\nPairs around 48 have equal sums:\n46+50 = 47+49 = 96.\n\nSo the average is 48.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
