    "concept_2": {
      "id": "concept_2",
      "type": "CONTENT",
      "content": {
        "text": "The same rule works backward.\n\nAverage = Sum ÷ Count\n\nSo:\nSum = Average × Count.\n\nIf 7 scores have average 18, their total is 18×7=126.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
