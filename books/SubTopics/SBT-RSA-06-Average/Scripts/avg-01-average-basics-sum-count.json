    "recap": {
      "id": "recap",
      "type": "CONTENT",
      "content": {
        "text": "Average = Sum ÷ Count.\n\nTurn that around whenever useful:\nSum = Average × Count.\n\nFor a missing value, rebuild the required total and subtract the known subtotal.\nIf every observation gets the same +k, −k, ×c or ÷c change, the average gets the same transformation.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "finish"
