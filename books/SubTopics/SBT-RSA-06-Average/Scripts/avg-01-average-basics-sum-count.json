    "teach_7": {
      "id": "teach_7",
      "type": "CONTENT",
      "content": {
        "text": "What happens if every observation changes in the same way?\n\nIf a set has average 18 and every value rises by 5, the total rises by 5 for each observation. So the equal-share level also rises by 5.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_7_step"
        }
      ]
    },
    "teach_7_step": {
      "id": "teach_7_step",
      "type": "CONTENT",
      "content": {
        "text": "New average = 18 + 5 = 23.\n\nLikewise, if every value is multiplied by 3, the total and the average are both multiplied by 3. This shortcut works only when every observation gets the same change.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_7"
        }
      ]
    },
