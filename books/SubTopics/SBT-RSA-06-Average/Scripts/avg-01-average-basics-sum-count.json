    "q_1_remedy": {
      "id": "q_1_remedy",
      "type": "CONTENT",
      "content": {
        "text": "A common mistake is to stop at the sum.\n\nAverage needs two pieces:\n1. the total,\n2. the number of observations.\n\nHere the count is 4, so divide the sum by 4.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1_retry"
