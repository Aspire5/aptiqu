    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "The same rule can run backwards.\n\nIf 6 tests have an average score of 72, the total score must be:\n\n6 × 72 = 432",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "So keep the three forms together:\n\nAverage = Total ÷ Count\nTotal = Average × Count\nCount = Total ÷ Average\n\nMost average questions are just one of these three views.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
