    "concept_4": {
      "id": "concept_4",
      "type": "CONTENT",
      "content": {
        "text": "Average questions can use letters too.\n\nIf two numbers have average M, then their sum is 2M.\n\nSo if one number is x, the other is 2M−x.\nThe same idea works for any count.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
