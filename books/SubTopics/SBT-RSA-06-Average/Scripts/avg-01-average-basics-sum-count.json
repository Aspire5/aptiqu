    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "The missing number is the gap between the required total and the known total:\n\n120 − 92 = 28\n\nCheck: 18 + 22 + 25 + 27 + 28 = 120, and 120 ÷ 5 = 24.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
