    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Let's learn average as an equal share.\n\nIf 3 children have 6, 9 and 12 sweets, there are 27 sweets in total.\n\nIf we share 27 equally, each gets 9.\n\nThat equal share, 9, is the average.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "concept_1"
        }
      ]
    },
    "concept_1": {
      "id": "concept_1",
      "type": "CONTENT",
      "content": {
        "text": "An average is an equal share of a total.\n\nSuppose 4 friends have 8, 12, 10 and 14 marbles.\nTotal = 44 marbles.\n\nShare 44 equally among 4 people:\n44 ÷ 4 = 11.\n\nSo the average is 11.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
