    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "Sometimes the missing thing is the count.\n\nA set has total 540 and average 45.\n\nCount = Total ÷ Average = 540 ÷ 45 = 12.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
