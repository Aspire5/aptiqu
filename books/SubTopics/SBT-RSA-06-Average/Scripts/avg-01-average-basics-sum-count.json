    "q_5_retry_fix": {
      "id": "q_5_retry_fix",
      "type": "CONTENT",
      "content": {
        "text": "A common slip is to subtract 6 only once from the total without knowing the count. Think value-by-value: every observation is 6 lower, so the average is 6 lower.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
