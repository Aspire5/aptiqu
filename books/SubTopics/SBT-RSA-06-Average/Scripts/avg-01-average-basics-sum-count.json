    "concept_6": {
      "id": "concept_6",
      "type": "CONTENT",
      "content": {
        "text": "If every observation is multiplied by the same number, the average is multiplied by that number too.\n\nIf the old average is 7 and every value is multiplied by 4, the new average is 28.\n\nThis follows because both the total and each contribution scale by 4.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
        }
      ]
    },
