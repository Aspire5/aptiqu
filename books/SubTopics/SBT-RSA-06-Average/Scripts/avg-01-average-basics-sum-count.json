    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Now hide one value.\n\nFive numbers have average 24, so their total is:\n5 × 24 = 120\n\nFour known numbers are 18, 22, 25 and 27. Their sum is 92.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
