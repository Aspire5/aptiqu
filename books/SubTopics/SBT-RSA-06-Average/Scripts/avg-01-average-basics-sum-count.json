      "type": "CONTENT",
      "content": {
        "text": "A quick check is multiplication:\n\n12 equal shares of 45 make 540.\n\nIf the count you find does not rebuild the total, something went wrong.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
