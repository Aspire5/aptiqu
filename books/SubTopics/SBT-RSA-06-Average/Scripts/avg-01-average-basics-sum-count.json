    "concept_3": {
      "id": "concept_3",
      "type": "CONTENT",
      "content": {
        "text": "A missing value is easiest after you rebuild the required total.\n\nExample: 5 numbers average 20.\nRequired total = 5×20 = 100.\n\nIf four known numbers total 73, the missing number is 100−73=27.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
