    "concept_2": {
      "id": "concept_2",
      "type": "CONTENT",
      "content": {
        "text": "If the whole average and one subgroup are known, the other subgroup can be found by subtraction of totals.\n\nWhole total = whole average × whole count.\nKnown group total = group average × group count.\nThe difference belongs to the remaining group.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
    "q_2": {
