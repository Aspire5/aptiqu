    "concept_3": {
      "id": "concept_3",
      "type": "CONTENT",
      "content": {
        "text": "Sometimes the subgroup count is unknown.\n\nLet x be that count, write one total equation, and solve.\n\nExample: overall average 60; 10 people average 80; the rest average 50.\n60x = 10×80 + 50(x−10), where x is total people.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
