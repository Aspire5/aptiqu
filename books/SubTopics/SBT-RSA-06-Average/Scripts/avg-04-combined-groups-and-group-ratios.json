    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "Once you have a ratio, percentages are just parts of the same whole.\n\nIf boys:girls = 3:2, there are 5 total parts.\n\nBoys = 3/5 = 60%\nGirls = 2/5 = 40%",
        "avatarPersona": "TUTOR"
