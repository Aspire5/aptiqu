    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "That last pattern has a shortcut.\n\nSuppose one group averages 80, another 50, and together they average 62.\n\nThe combined mean is 12 above 50 and 18 below 80.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "Group-size ratio is the opposite gaps:\n\n80-group : 50-group\n= (62−50) : (80−62)\n= 12 : 18\n= 2 : 3\n\nThe group closer to the combined mean must be larger.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
