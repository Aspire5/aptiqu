    "concept_1": {
      "id": "concept_1",
      "type": "CONTENT",
      "content": {
        "text": "A combined average is built from group totals.\n\nGroup 1: 12 people, average 50 → total 600.\nGroup 2: 8 people, average 65 → total 520.\n\nCombined average = (600+520)/(12+8)=56.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
