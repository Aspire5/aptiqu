    "concept_4": {
      "id": "concept_4",
      "type": "CONTENT",
      "content": {
        "text": "A combined mean between two group means can reveal the ratio of group sizes.\n\nHigh mean H, low mean L, combined mean M.\n\nHigh-group : low-group\n= (M−L) : (H−M).\n\nThe differences are crossed because more weight on the high group pulls the combined mean upward.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
