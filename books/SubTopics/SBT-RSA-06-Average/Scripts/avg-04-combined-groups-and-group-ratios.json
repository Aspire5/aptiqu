    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Now hide one subgroup average.\n\nThirty people average 60, so together they total 1800. Eighteen of them average 55, contributing 990.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "The remaining 12 people contribute:\n1800 − 990 = 810\n\nTheir average = 810 ÷ 12 = 67.5",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
