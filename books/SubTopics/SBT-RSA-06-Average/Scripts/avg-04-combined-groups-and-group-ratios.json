    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Sometimes the unknown is the group size.\n\nTen technicians average 90. The rest average 60. The whole staff averages 70.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "Let the number in the 60-group be n.\n\n10×90 + 60n = 70(10+n)\n900 + 60n = 700 + 70n\n200 = 10n\nn = 20",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
