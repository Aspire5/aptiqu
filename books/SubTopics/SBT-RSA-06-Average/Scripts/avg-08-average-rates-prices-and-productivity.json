    "concept_3": {
      "id": "concept_3",
      "type": "CONTENT",
      "content": {
        "text": "Work-time questions often ask average output per worker per minute.\n\nIf a worker completes one unit in t minutes, that worker's rate is 1/t unit per minute.\n\nConvert every worker to output rate first, then average those rates when the question asks per worker per minute.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
