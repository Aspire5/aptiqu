    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Equal money is different from equal quantity.\n\nSpend ₹600 at ₹30/kg and another ₹600 at ₹60/kg.\n\nThe first purchase gets 20 kg; the second gets 10 kg.",
        "avatarPersona": "TUTOR"
