    "concept_2": {
      "id": "concept_2",
      "type": "CONTENT",
      "content": {
        "text": "Equal money spent at different prices per litre has the reverse shape.\n\nIf you spend ₹M at price p, litres bought = M/p.\nAdd litres across purchases.\n\nAverage cost per litre = total money ÷ total litres.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
