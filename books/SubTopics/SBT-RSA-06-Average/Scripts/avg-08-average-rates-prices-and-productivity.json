    "teach_5_step": {
      "id": "teach_5_step",
      "type": "CONTENT",
      "content": {
        "text": "Monthly visitors = 5×480 + 25×240 = 8400\n\nDaily average = 8400 ÷ 30 = 280\n\nThe day counts are the weights.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
