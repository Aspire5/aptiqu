    "q_5_retry_fix": {
      "id": "q_5_retry_fix",
      "type": "CONTENT",
      "content": {
        "text": "Subtract total-expense equations. The fixed cost cancels, leaving only the extra people's variable cost.",
        "avatarPersona": "TUTOR"
