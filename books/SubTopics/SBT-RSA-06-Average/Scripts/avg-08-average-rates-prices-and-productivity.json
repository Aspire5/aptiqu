    "concept_6": {
      "id": "concept_6",
      "type": "CONTENT",
      "content": {
        "text": "Average charge with different attendance is another weighted rate.\n\nIf ticket charges are ₹15, ₹7.50 and ₹2.50 and attendance ratio is 2:5:13, use those ratio parts as weights.\n\nTotal charge units ÷ total attendance units gives the average charge per visitor.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
        }
      ]
    },
