    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "Different kinds of days act like frequencies.\n\nA library gets 480 visitors on Sundays and 240 on other days. In a 30-day month beginning with Sunday, there are 5 Sundays and 25 other days.",
        "avatarPersona": "TUTOR"
