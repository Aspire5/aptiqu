    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Let's learn average rates, prices and productivity with a small example.\n\nWe will build the method one step at a time and check each answer.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "concept_1"
        }
      ]
    },
    "concept_1": {
      "id": "concept_1",
      "type": "CONTENT",
      "content": {
        "text": "A rate such as 'kg per rupee' is already a division.\n\nIf you buy the same quantity at different kg-per-rupee rates, you cannot safely average the displayed rates.\nFind actual money spent for each purchase, add the money, then use:\n\naverage kg per rupee = total kg ÷ total rupees.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
