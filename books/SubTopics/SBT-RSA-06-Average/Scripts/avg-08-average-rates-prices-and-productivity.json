    "recap": {
      "id": "recap",
      "type": "CONTENT",
      "content": {
        "text": "When a displayed quantity is itself a rate, convert it back to real totals first.\n\nCombine total quantity with total cost, total output with workers, or total visitors with days.\nThen form the requested rate from those combined totals.\nThis prevents the common mistake of averaging rates that have different hidden weights.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "finish"
        }
