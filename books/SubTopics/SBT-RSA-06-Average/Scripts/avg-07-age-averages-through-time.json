    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "The total-age method explains the same shortcut.\n\nFour family members averaged 24 ten years ago. Their total age then was 4×24 = 96.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Today those same four people have each gained 10 years, so the total gains 4×10 = 40.\n\nPresent total = 136\nPresent average = 136 ÷ 4 = 34\n\nAgain, the average rose by 10.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
