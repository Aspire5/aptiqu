      "type": "CONTENT",
      "content": {
        "text": "Let's learn age averages through time with a small example.\n\nWe will build the method one step at a time and check each answer.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "concept_1"
        }
      ]
    },
    "concept_1": {
      "id": "concept_1",
      "type": "CONTENT",
      "content": {
        "text": "Ages have one special feature: if the same people stay in the group, everyone gets older by the same amount.\n\nSo after 4 years, the group's average age also rises by 4 years.\n\nBut if someone joins, leaves, is born or dies, the group size changes and you must rebuild the total.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
    "q_1": {
