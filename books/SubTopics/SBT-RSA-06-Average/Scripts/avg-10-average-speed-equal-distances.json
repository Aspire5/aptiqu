    "recap": {
      "id": "recap",
      "type": "CONTENT",
      "content": {
        "text": "Average speed is always total distance ÷ total time.\n\nFor equal distances at speeds x and y, this becomes 2xy/(x+y).\nDo not replace it with (x+y)/2 unless the travel times, not distances, are equal.\nIf the distances differ, return to total distance and total time.",
        "avatarPersona": "TUTOR"
