    "concept_2": {
      "id": "concept_2",
      "type": "CONTENT",
      "content": {
        "text": "The chapter gives the equal-distance shortcut directly:\n\nAverage speed = 2xy/(x+y).\n\nHere x and y are the two speeds.\nThe distance itself cancels, so you do not need to know how long the route is as long as the two legs cover equal distances.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
