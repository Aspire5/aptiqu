    "concept_4": {
      "id": "concept_4",
      "type": "CONTENT",
      "content": {
        "text": "You can derive the formula so it is easier to remember.\n\nLet each leg be d km.\nTime out = d/x.\nTime back = d/y.\n\nAverage speed = 2d ÷ (d/x+d/y).\nThe d cancels, leaving 2xy/(x+y).",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
