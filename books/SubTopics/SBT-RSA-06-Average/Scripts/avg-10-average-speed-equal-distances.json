    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "The formula can run backwards too.\n\nSuppose the outward speed is 60 and the equal-distance round-trip average is 48. Let return speed be y.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "2×60×y/(60+y) = 48\n120y = 2880 + 48y\n72y = 2880\ny = 40 km/h\n\nThe return speed must be below 48 because the average sits between the two speeds.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
