    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "Sanity check before you trust a result.\n\nFor equal distances at 90 and 30, the simple mean is 60. The real average is:\n\n2×90×30/120 = 45.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_6_step"
        }
      ]
    },
    "teach_6_step": {
      "id": "teach_6_step",
      "type": "CONTENT",
      "content": {
        "text": "So the true average:\n• lies between the two speeds;\n• is below the arithmetic mean when the speeds differ;\n• equals the arithmetic mean only when the two speeds are the same.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
        }
      ]
    },
