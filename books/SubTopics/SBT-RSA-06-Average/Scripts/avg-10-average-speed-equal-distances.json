          {
            "id": "a",
            "label": "d/x + d/y"
          },
          {
            "id": "b",
            "label": "x/d + y/d"
          },
          {
            "id": "c",
            "label": "2d/(x+y)"
          },
          {
            "id": "d",
            "label": "d/(x+y)"
          }
        ]
      },
      "content": {
        "text": "If equal legs are d km at speeds x and y, which expression is total time?",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
