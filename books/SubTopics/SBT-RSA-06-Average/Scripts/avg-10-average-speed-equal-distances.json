    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "With friendly numbers, the formula becomes very quick.\n\nAt 50 km/h out and 30 km/h back:\n\nAverage = 2×50×30/(50+30)\n= 3000/80\n= 37.5 km/h",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "A useful check: 37.5 lies between 30 and 50, but below their arithmetic mean 40. For unequal speeds over equal distances, that pattern should always hold.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
