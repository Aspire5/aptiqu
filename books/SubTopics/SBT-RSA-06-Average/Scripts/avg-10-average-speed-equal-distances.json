    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "The book's shortcut comes directly from total distance ÷ total time. Let each leg be d km, with speeds x and y.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Total distance = 2d\nTotal time = d/x + d/y = d(x+y)/(xy)\n\nAverage speed = 2d ÷ [d(x+y)/(xy)]\n= 2xy/(x+y)\n\nThe distance cancels because the two legs are equal.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
