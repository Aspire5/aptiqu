    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Let's learn average speed for equal distances with a small example.\n\nWe will build the method one step at a time and check each answer.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "concept_1"
        }
      ]
    },
    "concept_1": {
      "id": "concept_1",
      "type": "CONTENT",
      "content": {
        "text": "Average speed is total distance ÷ total time.\n\nFor equal outward and return distances, the slower trip takes more time. That is why the simple average of the two speeds is usually wrong.\n\nExample: 60 km at 60 km/h takes 1 hour.\n60 km at 30 km/h takes 2 hours.\nTotal: 120 km in 3 hours → 40 km/h, not 45.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
    "q_1": {
      "id": "q_1",
      "type": "CHOICE",
      "input": {
        "type": "CHOICE",
        "options": [
          {
            "id": "a",
            "label": "45"
          },
          {
            "id": "b",
            "label": "40"
          },
          {
            "id": "c",
            "label": "30"
          },
          {
            "id": "d",
            "label": "90"
          }
        ]
      },
      "content": {
        "text": "A car travels equal distances at 60 km/h and 30 km/h. What is the average speed?",
        "avatarPersona": "TUTOR"
