    "concept_6": {
      "id": "concept_6",
      "type": "CONTENT",
      "content": {
        "text": "The shortcut has a condition: equal distances.\n\nIf one leg is longer than the other, do not force 2xy/(x+y).\nReturn to the definition:\n\naverage speed = total distance ÷ total time.\n\nThis boundary is part of using the chapter's formula correctly.",
        "avatarPersona": "TUTOR"
      },
