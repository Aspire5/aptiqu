  "schemaVersion": "1.0",
  "scriptId": "avg-06-add-remove-replace-and-correct",
  "sourceType": "MANUAL",
  "metadata": {
    "title": "Adding, Removing, Replacing and Correcting Observations",
    "description": "Track the total when members enter, leave, are replaced, or when a recorded value is corrected.",
    "teachingApproach": "Use the total as a running account balance. Add a joining value and count, subtract a leaving value and count, exploit the same-count replacement shortcut, scale up to groups, then repair one and two wrong entries. Finish with the classic replacement-and-average-shift shortcut where the outgoing value is recovered from total change.",
    "targetDurationMinutes": 30,
    "sourceScope": "Teach all membership changes through totals. For adding or removing a member, compare the old and new total. For a same-size replacement, show that change in total = number of observations × change in mean = new value − old value. Extend to groups entering or leaving. For wrong entries, repair the recorded total by subtracting the wrong value and adding the correct value, including two-error cases. Finish with the common replacement shortcut that recovers the outgoing member from the mean shift."
  },
  "startNodeId": "start",
  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Let's treat an average like a running total with a headcount attached.\n\nWhenever someone joins, leaves or is replaced, we will ask two questions: how did the total change, and did the count change?",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "A group of 10 people averages 40, so its total is 400. Add one person with value 55 and the new total becomes 455.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "The count also changes: 10 → 11.\n\nNew average = 455 ÷ 11 ≈ 41.36\n\nWhen someone joins, update both the total and the count.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
