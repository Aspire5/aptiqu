    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "Total rise = 8 × 2 = 16.\n\nSo the new person's value is 16 more than the old person's:\n50 + 16 = 66\n\nSame count means every 1-point mean change represents 8 total points.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
