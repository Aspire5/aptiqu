    "concept_3": {
      "id": "concept_3",
      "type": "CONTENT",
      "content": {
        "text": "Replacement keeps the count the same.\n\nIf n people have their average change by d, the total changes by n×d.\nThat total change equals:\nnew member − old member.\n\nThis is a fast form of the full-total method.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
