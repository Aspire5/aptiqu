    "recap": {
      "id": "recap",
      "type": "CONTENT",
      "content": {
        "text": "Average changes are easiest at the total level.\n\nJoin: new total − old total gives the entrant.\nLeave: old total − new total gives the leaver.\nReplacement with same count: count × change in average = new value − old value.\nCorrections: repair the recorded total, then divide.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
