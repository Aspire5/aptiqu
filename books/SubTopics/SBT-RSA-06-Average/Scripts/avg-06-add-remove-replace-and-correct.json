    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Replacement is faster because the count stays the same.\n\nEight people average 60. One person with value 50 is replaced, and the average rises by 2.",
        "avatarPersona": "TUTOR"
