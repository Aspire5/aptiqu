      "type": "CONTENT",
      "content": {
        "text": "Let's learn adding, removing, replacing and correcting observations with a small example.\n\nWe will build the method one step at a time and check each answer.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "concept_1"
        }
      ]
    },
    "concept_1": {
      "id": "concept_1",
      "type": "CONTENT",
      "content": {
        "text": "When one new member joins, both total and count change.\n\nOld group: n people, average A → total nA.\nNew group: n+1 people, average B → total (n+1)B.\n\nNew member's value = (n+1)B − nA.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
