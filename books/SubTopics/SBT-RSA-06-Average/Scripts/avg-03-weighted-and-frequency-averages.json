    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Let's learn weighted and frequency averages with a small example.\n\nWe will build the method one step at a time and check each answer.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "concept_1"
        }
      ]
    },
    "concept_1": {
      "id": "concept_1",
      "type": "CONTENT",
      "content": {
        "text": "When values occur different numbers of times, each value must carry its count.\n\nSuppose 2 students score 60 and 3 students score 80.\nTotal marks = 2×60 + 3×80 = 360.\nTotal students = 5.\n\nWeighted average = 360÷5 = 72.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
    "q_1": {
      "id": "q_1",
      "type": "CHOICE",
