    "concept_6": {
      "id": "concept_6",
      "type": "CONTENT",
      "content": {
        "text": "You can also work backward from a weighted average.\n\nIf two equal-weight tests have scores 70 and x and the weighted average is 80, then 70+x=160, so x=90.\n\nWith unequal weights, multiply by the weights before solving.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
