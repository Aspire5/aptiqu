    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "Weights can represent importance, not just frequency.\n\nSuppose monthly exam scores are 70, 80 and 90, each with weight 1, while the final score 85 has weight 2.",
