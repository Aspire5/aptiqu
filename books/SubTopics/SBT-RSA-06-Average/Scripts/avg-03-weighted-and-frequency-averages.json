    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Group averages behave the same way.\n\nEight students average 60 and twelve students average 70.\n\nGroup totals: 8×60 = 480 and 12×70 = 840.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Combined total = 1320\nCombined count = 20\nCombined average = 1320 ÷ 20 = 66\n\nThe larger group pulls the answer closer to 70.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
