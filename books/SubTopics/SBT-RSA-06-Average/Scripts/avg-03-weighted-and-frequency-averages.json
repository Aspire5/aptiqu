        "type": "CHOICE",
        "options": [
          {
            "id": "a",
            "label": "600"
          },
          {
            "id": "b",
            "label": "650"
          },
          {
            "id": "c",
            "label": "620"
          },
          {
            "id": "d",
            "label": "1200"
          }
        ]
      },
      "content": {
        "text": "4 workers earn ₹500 each and 6 workers earn ₹700 each. What is the average wage?",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "condition": {
