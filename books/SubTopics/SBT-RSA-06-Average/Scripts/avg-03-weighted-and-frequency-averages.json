    "recap": {
      "id": "recap",
      "type": "CONTENT",
      "content": {
        "text": "Weighted average = total weighted value ÷ total weight.\n\nFor each row or group, multiply value × weight first.\nThen add the weighted values and add the weights.\nA simple average of subgroup means is safe only when their weights are equal.",
        "avatarPersona": "TUTOR"
      },
