    "concept_2": {
      "id": "concept_2",
      "type": "CONTENT",
      "content": {
        "text": "A frequency table is the same idea.\n\nValue × frequency gives that row's contribution to the total.\nAdd all contributions, then divide by total frequency.\n\nThe chapter does this with working-hour intervals by using each interval's midpoint: 3–5 becomes 4 hours, 5–7 becomes 6 hours, and so on.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
