    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "Frequency tables sometimes group values into intervals. The book represents each interval by its midpoint.\n\nFor 0–10, 10–20 and 20–30, the midpoints are 5, 15 and 25.",
