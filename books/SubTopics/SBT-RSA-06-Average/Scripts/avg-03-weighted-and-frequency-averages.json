    "concept_3": {
      "id": "concept_3",
      "type": "CONTENT",
      "content": {
        "text": "Weights can also describe importance instead of headcount.\n\nIf monthly tests have weight 1 each and the final exam has weight 2, the final score counts twice in the weighted total and twice in the total weight.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
