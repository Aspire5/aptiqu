{
  "schemaVersion": "1.0",
  "scriptId": "pct-09-population-growth-depreciation",
  "sourceType": "MANUAL",
  "metadata": {
    "title": "Population Growth, Depreciation, and Repeated Annual Change",
    "description": "Apply percentage multipliers repeatedly across years to populations, salaries, investments, asset values, and decay.",
    "teachingApproach": "Make compounding visible as a year-by-year chain. Each year starts from the previous year’s value. Use forward and reverse multipliers, then extend to changing annual rates and unknown constant rates.",
    "targetDurationMinutes": 32,
    "sourceScope": "R.S. Aggarwal, Quantitative Aptitude for Competitive Examinations, Chapter 11, Percentage. Approved scope: Teach repeated annual growth P(1+R/100)^n and depreciation P(1−R/100)^n, including reversing to a value n years ago. Cover changing annual rates, one year up and another down, finding a constant annual rate from a multi-year multiplier, comparing appreciation with depreciation, and repeated halving/decay patterns. Explain that annual changes compound because each year starts from the previous year’s value. Include source-style population, salary, tree growth and machine-value contexts without requiring compound-interest terminology."
  },
  "startNodeId": "start",
  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Let's track repeated percentage change across years.\n\nIf a town grows 10% this year, next year’s 10% is calculated on the larger population. That is why annual percentage change compounds.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "Population 20,000 grows 5% for one year:\n20,000×1.05=21,000.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "After two years at the same rate:\n20,000×1.05×1.05.\n\nThe multiplier repeats once per year.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
