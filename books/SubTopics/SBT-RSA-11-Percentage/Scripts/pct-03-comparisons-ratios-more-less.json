    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "To compare B back to A, the gap is 20 on a base of 80:\n20/80×100=25%.\n\nSo B is 25% more than A.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
