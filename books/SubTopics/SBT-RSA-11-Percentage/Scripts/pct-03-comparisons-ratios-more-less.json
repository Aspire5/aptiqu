    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "The same asymmetry works for “less than.”\n\nIf A is 20% less than B, let B=100. Then A=80.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
