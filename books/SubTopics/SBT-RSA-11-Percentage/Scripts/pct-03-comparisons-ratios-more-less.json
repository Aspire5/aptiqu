  "schemaVersion": "1.0",
  "scriptId": "pct-03-comparisons-ratios-more-less",
  "sourceType": "MANUAL",
  "metadata": {
    "title": "Percentage Comparisons, Ratios, and “More/Less Than”",
    "description": "Translate statements such as “A is 25% more than B” into ratios and correctly reverse the comparison when the reference quantity changes.",
    "teachingApproach": "Keep the comparison base visible in every screen. Use ₹100 or 100 units as a temporary reference to show why reversing “more than” and “less than” changes the percentage, then extend that idea to ratio equations and chained comparisons.",
    "targetDurationMinutes": 30,
    "sourceScope": "R.S. Aggarwal, Quantitative Aptitude for Competitive Examinations, Chapter 11, Percentage. Approved scope: Teach that percentage comparisons depend on the reference quantity. Convert “A is R% more than B” to A:B=(100+R):100 and “A is R% less than B” to A:B=(100−R):100. Derive the reverse percentages rather than assuming they are equal. Cover relations such as x% of y = y% of x, p% of A=q% of B, ratios expressed as percentages, chained salary or quantity comparisons, and questions asking what percent one transformed quantity is of another. Include exact fraction answers for repeating percentages when useful. Learners should name the base of every “more than” or “less than” statement before calculating."
  },
  "startNodeId": "start",
  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Let's fix one of the most common percentage traps: “more than” and “less than” do not use the same base.\n\nIf B is ₹100 and A is 25% more, A is ₹125. Now compare back from A to B.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "If A is 25% more than B, let B=100.\nThen A=125.\n\nSo A:B=125:100=5:4.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "The percentage statement becomes a ratio immediately.\n\n“A is R% more than B” means A:B=(100+R):100.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
    "q_1": {
