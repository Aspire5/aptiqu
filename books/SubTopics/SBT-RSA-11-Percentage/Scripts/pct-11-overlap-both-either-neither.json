{
  "schemaVersion": "1.0",
  "scriptId": "pct-11-overlap-both-either-neither",
  "sourceType": "MANUAL",
  "metadata": {
    "title": "Overlapping Groups: Both, Either, and Neither",
    "description": "Use inclusion-exclusion with percentages or counts to solve two-group overlap questions such as subjects, sports, newspapers, or lunch choices.",
    "teachingApproach": "Use a 100-person picture before writing the inclusion-exclusion formula. Show why the overlap is counted twice, subtract it once, then use the same logic with actual counts and complements.",
    "targetDurationMinutes": 29,
    "sourceScope": "R.S. Aggarwal, Quantitative Aptitude for Competitive Examinations, Chapter 11, Percentage. Approved scope: Teach the two-set percentage formula: either A or B = A + B − both. Use it to find both when everyone belongs to at least one group, neither as 100−union, passed-both from failure percentages, totals when the count in neither is known, and “either but not both” as union−both. Include both percentages and actual counts. Learners should see why the overlap is subtracted once: it was counted twice when A and B were added."
  },
  "startNodeId": "start",
  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Let's solve percentage questions where people can belong to two groups at once.\n\nIf we add the tea group and the coffee group, anyone who likes both gets counted twice. That double count is the whole idea.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "Suppose 60% like tea, 50% like coffee, and 20% like both.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "Add tea and coffee: 60+50=110.\nThe 20% overlap was counted twice, so subtract it once:\nEither=60+50−20=90%.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
    "q_1": {
      "id": "q_1",
      "type": "CHOICE",
      "content": {
        "text": "55% like A, 45% like B, and 15% like both. What percent like at least one?",
        "avatarPersona": "TUTOR"
      },
      "input": {
        "type": "CHOICE",
        "options": [
          {
            "id": "a",
            "label": "100%"
          },
          {
            "id": "b",
            "label": "70%"
          },
          {
            "id": "c",
            "label": "85%"
          },
          {
            "id": "d",
            "label": "95%"
          }
        ]
      },
