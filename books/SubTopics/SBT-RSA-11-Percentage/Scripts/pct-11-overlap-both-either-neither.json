    "remedy_1": {
      "id": "remedy_1",
      "type": "CONTENT",
      "content": {
        "text": "Let’s check this one.\n\nThe overlap must be subtracted once because it was counted twice.\n\nAt least one=85%.\n\nNow use the same idea with fresh values.",
