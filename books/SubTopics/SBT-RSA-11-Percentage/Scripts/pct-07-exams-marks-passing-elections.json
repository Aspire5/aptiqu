    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "“Failed by” and “passed by” can reveal the maximum marks.\n\nSuppose 30% fails by 12 marks, while 40% is 18 marks above pass.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "The two scores differ by 10% of maximum, and the mark gap is 12+18=30.\nSo 10%=30, maximum=300.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
