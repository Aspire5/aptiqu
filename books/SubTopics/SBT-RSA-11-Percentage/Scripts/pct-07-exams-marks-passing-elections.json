    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "With different subject maxima, add marks and maxima before finding the aggregate percentage.\n\nDo not average the subject percentages unless the maxima are equal.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Example: 80/100 and 120/200.\nAggregate=200/300=66 2/3%, not the simple average of 80% and 60%=70%.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
