{
  "schemaVersion": "1.0",
  "scriptId": "pct-07-exams-marks-passing-elections",
  "sourceType": "MANUAL",
  "metadata": {
    "title": "Examinations, Marks, Passing, and Elections",
    "description": "Use percentages to solve marks, pass/fail, valid-vote, election-margin, and target-score problems.",
    "teachingApproach": "Use the denominator as the organising idea: maximum marks, total questions, enrolled voters, votes cast, or valid votes. Build each stage in order and never let a later percentage silently switch the base.",
    "targetDurationMinutes": 33,
    "sourceScope": "R.S. Aggarwal, Quantitative Aptitude for Competitive Examinations, Chapter 11, Percentage. Approved scope: Cover examination and election patterns from the chapter: convert marks to percentages, combine subjects with different maximum marks, recover maximum marks or pass marks from “failed by” and “passed by” clues, determine the extra marks needed to reach a target percentage, and solve group pass/fail counts. For elections, distinguish enrolled voters, votes cast, valid votes and candidate shares; solve two-candidate margin questions and invalid-vote chains. Include target questions where a student or team must improve a current percentage over the remaining questions/games. Learners should identify the correct denominator at each stage."
  },
  "startNodeId": "start",
  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Let's solve exam and election percentages by tracking the denominator.\n\nA score can be 60% of maximum marks, while a candidate can get 60% of valid votes. The number after “of” changes the whole calculation.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "Marks percentage = marks obtained / maximum marks ×100.\n\n360 out of 500 =72%.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "If the percentage is known, reverse it the same way.\n\n72% of 500=360.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
