{
  "schemaVersion": "1.0",
  "scriptId": "pct-10-mixtures-concentration-composition",
  "sourceType": "MANUAL",
  "metadata": {
    "title": "Mixtures, Concentration, and Changing Composition",
    "description": "Track the amount of a component while solution weight changes through mixing, adding pure material, adding water, evaporation, or replacement.",
    "teachingApproach": "Track the actual amount of the key component before touching the percentage. Mark what stays constant when water evaporates or is added, and what leaves when a mixed solution is removed. This keeps mixture questions inside ordinary percentage reasoning.",
    "targetDurationMinutes": 33,
    "sourceScope": "R.S. Aggarwal, Quantitative Aptitude for Competitive Examinations, Chapter 11, Percentage. Approved scope: Teach concentration as component amount/total mixture×100. Cover finding component amount in a solution, adding pure component, diluting by adding water, concentrating by evaporation, mixing two solutions of different strengths, removing and replacing part of a solution, repeated replacement, and “fresh versus dry” fruit problems where the non-water solid remains constant. Make the conserved component explicit before forming equations. Keep this within percentage reasoning rather than introducing a separate alligation method."
  },
  "startNodeId": "start",
  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Let's make mixture percentages concrete.\n\nA 20% salt solution means 20% of the total weight is salt. The fastest path is usually to track the salt itself while the total mixture changes around it.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "In 30 kg of a 20% salt solution:\nsalt=20% of 30=6 kg.\nwater=24 kg.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "The two amounts must add back to the total.\n\nThis simple component check is the base for every harder mixture question.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
