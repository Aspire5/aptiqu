  "schemaVersion": "1.0",
  "scriptId": "pct-06-income-savings-tax-commission",
  "sourceType": "MANUAL",
  "metadata": {
    "title": "Income, Expenditure, Savings, Tax, and Commission",
    "description": "Model percentage-based money flows involving salary, spending, savings, discounts, taxes, commissions, and slab-like payments.",
    "teachingApproach": "Use a money-flow model: income comes in, named percentages leave, and the remainder is savings or take-home amount. Distinguish “percent of salary” from “percent of what remains,” and keep slab or threshold calculations separated before combining.",
    "targetDurationMinutes": 32,
    "sourceScope": "R.S. Aggarwal, Quantitative Aptitude for Competitive Examinations, Chapter 11, Percentage. Approved scope: Teach income−expenditure=savings and calculate how separate percentage changes in income and expenditure affect savings. Cover sequential spending of a remaining balance, monthly/annual income conversions, commission as a percentage of sales including a fixed amount plus commission above a threshold, simple progressive/slab-style tax reasoning, surcharge on tax, rebate followed by sales tax, and reverse questions where a known investment or deduction is a percentage of salary. Emphasize that percentages taken “of the remaining amount” use a new base, while percentages explicitly stated “of salary” keep the original base."
  },
  "startNodeId": "start",
  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Let's turn money stories into clean flows.\n\nThe first anchor is simple:\n\nincome − expenditure = savings.\n\nThe important question is always: percentage of which amount?",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "Suppose income is ₹20,000 and expenditure is ₹15,000. Savings=₹5,000.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "If income rises 10%, new income=₹22,000.\nIf expenditure rises 8%, new expenditure=₹16,200.\nNew savings=₹5,800.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
