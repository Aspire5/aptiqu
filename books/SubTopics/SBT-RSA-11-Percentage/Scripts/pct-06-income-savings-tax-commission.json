    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "The percentage increase in savings uses the old savings as its base.\n\nOld savings ₹5,000, new savings ₹5,800: increase ₹800.",
        "avatarPersona": "TUTOR"
