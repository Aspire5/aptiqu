    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Same-money questions can be solved through quantity ratios.\n\nIf price falls 20%, each unit costs 80% as much, so the same money buys 1/0.8=1.25 times as many units.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
