    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "If price falls, the same budget buys more.\n\nA 20% fall makes price 80 instead of 100. With the same ₹10,000, quantity rises from 100 to 125.",
        "avatarPersona": "TUTOR"
