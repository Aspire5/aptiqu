{
  "schemaVersion": "1.0",
  "scriptId": "pct-02-find-part-whole-percentage",
  "sourceType": "MANUAL",
  "metadata": {
    "title": "Finding the Part, Whole, or Percentage",
    "description": "Solve the three basic percentage questions: find a percentage of a quantity, find what percent one quantity is of another, or recover the whole from a known part.",
    "teachingApproach": "Build one stable part–whole–percent relationship and reuse it in three directions. Keep units aligned before forming a fraction, and make the learner check whether the size of the result matches the story.",
    "targetDurationMinutes": 29,
    "sourceScope": "R.S. Aggarwal, Quantitative Aptitude for Competitive Examinations, Chapter 11, Percentage. Approved scope: Teach the part-whole-percent triangle through equations: part=(percent/100)×whole, percent=(part/whole)×100, whole=part÷(percent/100). Cover missing percentages, missing wholes, percentages of percentages, differences between two percentages of the same number, and unit conversions before comparing quantities such as grams with kilograms or minutes with hours. Include source-style question-mark equations and situations where the final request is a different percentage of the same recovered whole. Learners should check whether a part smaller than the whole gives a percentage below 100 and whether percentages above 100 are reasonable when the part exceeds the reference whole."
  },
  "startNodeId": "start",
  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Let's solve the three questions hiding inside almost every percentage problem.\n\nIf 30% of a box is 18 red balls, we might be asked for the red balls, the whole box, or the percentage. The same relationship answers all three.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "Start with the direct form:\n\npart = percent × whole.\n\n30% of 240 = 0.30×240 = 72.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "A quick check: 30% is less than one third, so the answer should be less than 80.\n\nThat size check catches many decimal mistakes.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
