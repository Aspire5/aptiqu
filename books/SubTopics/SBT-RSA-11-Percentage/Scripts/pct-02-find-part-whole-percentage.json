    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Units must match before you compare.\n\n150 g is what percent of 3 kg?\n3 kg=3000 g.\n150/3000×100=5%.",
        "avatarPersona": "TUTOR"
