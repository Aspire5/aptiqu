{
  "schemaVersion": "1.0",
  "scriptId": "pct-04-increase-decrease-successive-change",
  "sourceType": "MANUAL",
  "metadata": {
    "title": "Increase, Decrease, Reverse Percentage, and Successive Change",
    "description": "Use percentage multipliers to move forward or backward through increases and decreases, including successive changes and restoration to an original value.",
    "teachingApproach": "Treat every change as a multiplier. Show forward changes first, then reverse them, then combine multipliers for successive changes. Use ₹100 examples to expose why equal increases and decreases do not cancel.",
    "targetDurationMinutes": 31,
    "sourceScope": "R.S. Aggarwal, Quantitative Aptitude for Competitive Examinations, Chapter 11, Percentage. Approved scope: Teach multiplier thinking: +R% means multiply by (1+R/100), −R% means multiply by (1−R/100). Use it to find new values and to reverse from a final value to the original. Cover equal percentage increase/decrease giving a net loss, two successive increases, mixed successive increase/decrease, and the percentage needed to restore a reduced or increased value. Explain why +20% followed by −20% does not cancel: the second percentage uses a different base. Include percentage error as error/original×100 and simple multiplier questions such as the factor that represents a 29.7% increase."
  },
  "startNodeId": "start",
  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Let's make percentage change predictable.\n\nInstead of remembering many separate rules, we will turn every increase or decrease into a multiplier.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "An increase of 18% keeps the original 100% and adds 18%.\n\nNew value = 118% of old = 1.18×old.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "A decrease of 18% keeps 82%.\n\nNew value = 82% of old = 0.82×old.\n\nThe multiplier tells you exactly what fraction remains.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
