{
  "schemaVersion": "1.0",
  "scriptId": "pct-12-percentage-chains-remaining-effective-rates",
  "sourceType": "MANUAL",
  "metadata": {
    "title": "Percentage Chains, Remaining Quantities, and Effective Rates",
    "description": "Handle multi-stage percentage stories where each stage acts on what remains, and work backward from a final remainder when needed.",
    "teachingApproach": "Treat each stage as a survival factor. The amount after one stage becomes the base for the next. Work forward by multiplying remaining factors and backward by dividing them in reverse order. Finish by converting the survival factor into an effective total loss or rejection rate.",
    "targetDurationMinutes": 32,
    "sourceScope": "R.S. Aggarwal, Quantitative Aptitude for Competitive Examinations, Chapter 11, Percentage. Approved scope: Teach percentage chains as successive multipliers, especially when wording says “of the remaining.” Cover spending/distribution chains, successive rejection or selection stages, effective rejection across multiple quality checks, repeated sell/leave problems, reverse-working from a final remainder, and chains combining a percentage with a fixed amount. Distinguish percentages of the original from percentages of the current remainder. Include capstones where learners must multiply survival factors first and only then convert back to an effective loss or rejection percentage."
  },
  "startNodeId": "start",
  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Let's handle stories where percentages happen one after another.\n\nThe key phrase is often “of the remaining.” That means the base changes after every stage.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "Suppose you start with ₹100. Spend 30%, so ₹70 remains.\nThen spend 20% of the remaining ₹70, which is ₹14.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "Final amount=₹56.\n\nThe two spends are not 50% of the original. The second 20% acts on a smaller base.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
