    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "A decimal percentage is still divided by 100.\n\n0.6% = 0.6/100 = 0.006.\n\nNotice the difference between 0.6 and 0.6%.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "The percent sign makes the number one hundred times smaller.\n\n2.5% = 0.025, not 0.25.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
