    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "To go the other way, multiply by 100 and attach %.\n\n0.42 = 42%.\n\nThe whole decimal 1 equals 100%.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "That also means numbers larger than 1 can become percentages above 100%.\n\n1.6 = 160%.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
