    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "Mental benchmarks save time.\n\n50% means half.\n25% means one quarter.\n10% means one tenth.\n5% means half of 10%.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_5_step"
        }
      ]
    },
    "teach_5_step": {
      "id": "teach_5_step",
      "type": "CONTENT",
      "content": {
        "text": "For 360:\n10%=36\n5%=18\n25%=90\n50%=180\n\nBuild awkward percentages from easy pieces when possible.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_5"
        }
      ]
    },
