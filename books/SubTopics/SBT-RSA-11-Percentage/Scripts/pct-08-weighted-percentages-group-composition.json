{
  "schemaVersion": "1.0",
  "scriptId": "pct-08-weighted-percentages-group-composition",
  "sourceType": "MANUAL",
  "metadata": {
    "title": "Weighted Percentages and Group Composition",
    "description": "Combine percentages from groups of different sizes and recover subgroup counts when overall and subgroup percentages are given.",
    "teachingApproach": "Replace vague “average percentages” with actual contributions. Start with two unequal groups, compute how many in each group satisfy the condition, then divide by the combined total. Extend to subgroup reconstruction and conditional composition.",
    "targetDurationMinutes": 33,
    "sourceScope": "R.S. Aggarwal, Quantitative Aptitude for Competitive Examinations, Chapter 11, Percentage. Approved scope: Teach why percentages from unequal groups cannot be averaged directly. Use actual counts or weighted contributions to combine pass rates, defect rates, tax rates, literacy rates and other subgroup percentages. Cover male/female or skilled/unskilled splits, percentage composition after removing part of one subgroup, two shipments of different sizes, conditional composition such as capable/incapable candidates with different pass rates, and weighted average return/rate questions. Learners should convert each subgroup percentage into a contribution to the whole before combining."
  },
  "startNodeId": "start",
  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Let's combine percentages from groups of different sizes.\n\nIf one class has 20 students and another has 80, their percentages cannot be averaged as if the classes were equally large.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "Suppose 20 students have an 80% pass rate: 16 pass.\n80 students have a 50% pass rate: 40 pass.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "Together, 56 of 100 pass, so the combined pass rate is 56%.\n\nConvert each percentage to a count before combining.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
