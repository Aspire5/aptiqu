    "recap": {
      "id": "recap",
      "type": "CONTENT",
      "content": {
        "text": "Opposite-sign surd pairs multiply by a difference of squares.\n\nIf their product is 1, each is the reciprocal of the other.\nThen x+1/x often cancels the surd parts, while x-1/x often cancels the rational parts.\nSquaring those relations gives x^2+1/x^2.\n\nShow how you would verify that 2-√3 is really the reciprocal of 2+√3.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "finish"
        }
      ]
    },
