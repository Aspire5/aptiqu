    "teach_5_step": {
      "id": "teach_5_step",
      "type": "CONTENT",
      "content": {
        "text": "(x−1/x)^2 = x^2+1/x^2−2\nwhile (x+1/x)^2 = x^2+1/x^2+2.\n\nSo (x−1/x)^2=(x+1/x)^2−4.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_5"
        }
