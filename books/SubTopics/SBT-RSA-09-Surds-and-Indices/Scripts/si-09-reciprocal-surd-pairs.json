    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "If two numbers multiply to 1, they are reciprocals.\n\nSo from the previous result:\n1/(3+2√2)=3−2√2.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "No long division is needed. The conjugate already gives the reciprocal because their product is exactly 1.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
