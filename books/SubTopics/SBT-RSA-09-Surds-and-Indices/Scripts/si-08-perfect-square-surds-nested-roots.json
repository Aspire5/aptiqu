    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "A minus sign gives a difference.\n\n8−2√15 uses p+q=8 and pq=15, so p=5,q=3.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
