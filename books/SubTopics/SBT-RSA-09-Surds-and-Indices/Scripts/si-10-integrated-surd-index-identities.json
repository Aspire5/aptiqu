    "concept_3": {
      "id": "concept_3",
      "type": "CONTENT",
      "content": {
        "text": "Long products of powers often collapse because exponents cancel.\n\n(x^a/x^b)(x^b/x^c)(x^c/x^a)\n= x^(a-b+b-c+c-a)\n= x^0\n= 1.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
