    "concept_5": {
      "id": "concept_5",
      "type": "CONTENT",
      "content": {
        "text": "Repeated difference of squares can telescope.\n\n(2-1)(2+1)=2^2-1.\nMultiply by (2^2+1):\n(2^2-1)(2^2+1)=2^4-1.\n\nThe same pattern can continue with 2^4+1, 2^8+1, and so on.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_5"
        }
      ]
    },
