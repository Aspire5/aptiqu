    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "If a+b+c=0, the whole expression is 0.\n\nThat is why source-style exponent products with this exponent become x^0=1.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
