    "concept_2": {
      "id": "concept_2",
      "type": "CONTENT",
      "content": {
        "text": "Paired cube roots also have a useful structure.\n\nLet t=∛2+∛4.\nThen uv=∛8=2.\n\n(t)^3 = 2+4 + 3(2)t = 6+6t.\n\nSo t^3-6t=6.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
