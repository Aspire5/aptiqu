    "concept_2": {
      "id": "concept_2",
      "type": "CONTENT",
      "content": {
        "text": "Differences work the same way.\n\n5^(x+1) - 5^x\n= 5^x(5-1)\n= 4×5^x.\n\nThe subtraction happens in the bracket after the common power is removed.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
