    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Division removes matching factors.\n\n7^6 ÷ 7^2 has six 7s on top and two 7s below. Two pairs cancel.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Four 7s remain:\n\n7^6 ÷ 7^2 = 7^(6−2) = 7^4\n\nThe order matters: numerator exponent minus denominator exponent.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
