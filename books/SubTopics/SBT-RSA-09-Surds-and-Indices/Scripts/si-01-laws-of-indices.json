    "concept_2": {
      "id": "concept_2",
      "type": "CONTENT",
      "content": {
        "text": "When powers have the same base and are multiplied, join the repeated factors.\n\n2^3 × 2^2\n= (2×2×2)(2×2)\n= 2^5.\n\nSo a^m × a^n = a^(m+n). The base stays the same; the exponents add.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
