      "type": "COMPLETION",
      "content": {
        "text": "Nice work. On a fresh expression, first point to the base and exponent, then say which index law you are using. If you can name the law and check it with a small expansion, the rule is becoming reliable.",
        "avatarPersona": "TUTOR"
      },
      "transitions": []
