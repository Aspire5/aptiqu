    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Now put a power around another power.\n\n(5^2)^3 means three copies of 5^2 multiplied together.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
