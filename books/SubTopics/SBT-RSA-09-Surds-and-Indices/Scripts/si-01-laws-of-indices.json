    "recap": {
      "id": "recap",
      "type": "CONTENT",
      "content": {
        "text": "You can now read and combine ordinary indices.\n\nSame base, multiply → add exponents.\nSame base, divide → subtract exponents.\nPower of a power → multiply exponents.\nPower of a product/quotient → apply the power to every factor.\nFor the non-zero bases used here, a^0 = 1.\n\nBefore finishing, explain why 3^2 × 3^4 becomes 3^6 instead of 9^6.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "finish"
        }
      ]
    },
