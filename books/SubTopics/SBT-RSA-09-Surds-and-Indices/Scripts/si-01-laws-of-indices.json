    "concept_3": {
      "id": "concept_3",
      "type": "CONTENT",
      "content": {
        "text": "Division removes repeated factors.\n\n3^6 ÷ 3^2\n= (3×3×3×3×3×3)/(3×3)\n= 3^4.\n\nSo a^m ÷ a^n = a^(m-n) when the division is defined.",
        "avatarPersona": "TUTOR"
