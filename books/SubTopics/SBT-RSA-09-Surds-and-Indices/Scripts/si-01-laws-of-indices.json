    "q_6_remedy": {
      "id": "q_6_remedy",
      "type": "CONTENT",
      "content": {
        "text": "A common possible slip here is to use the right rule on the wrong structure.\n\nFor this question:\n\nWhat is 7^0 × 7^3?\n\nStart from this clue:\n7^0 = 1.\n\nThen follow the second clue and solve only after the expression is rewritten correctly.",
        "avatarPersona": "TUTOR"
