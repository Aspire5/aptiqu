    "concept_6": {
      "id": "concept_6",
      "type": "CONTENT",
      "content": {
        "text": "The chapter also uses a^0 = 1.\n\nExample:\n\n7^4 ÷ 7^4 = 7^(4-4) = 7^0.\n\nBut the left side is 1, so 7^0 = 1.\n\nThis is useful inside longer expressions.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
        }
      ]
    },
