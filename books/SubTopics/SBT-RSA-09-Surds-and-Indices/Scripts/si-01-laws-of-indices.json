    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "Each copy contributes two 5s, and there are three copies:\n\n(5^2)^3 = 5^(2×3) = 5^6\n\nHere the exponents multiply because the whole power is repeated.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
