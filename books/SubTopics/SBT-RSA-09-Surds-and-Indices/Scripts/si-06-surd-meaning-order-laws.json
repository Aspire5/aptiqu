    "recap": {
      "id": "recap",
      "type": "CONTENT",
      "content": {
        "text": "A surd is an irrational root of a rational number.\nThe small root number tells the order.\nRoots multiply and divide by combining radicands of the same order.\nAn nth root raised to the nth power returns the radicand.\nPerfect factors can come out of a root.\n\nGive one example of a written root that is not actually a surd because it simplifies to a rational number.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
