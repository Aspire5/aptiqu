    "concept_6": {
      "id": "concept_6",
      "type": "CONTENT",
      "content": {
        "text": "Decimal exponents still obey the normal index laws.\n\n16^0.25 × 16^0.75\n= 16^(0.25+0.75)\n= 16^1\n= 16.\n\nThe strange-looking decimals do not change the rule for multiplying same bases.",
        "avatarPersona": "TUTOR"
      },
