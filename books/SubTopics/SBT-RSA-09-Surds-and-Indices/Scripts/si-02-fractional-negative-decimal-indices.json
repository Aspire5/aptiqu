    "concept_3": {
      "id": "concept_3",
      "type": "CONTENT",
      "content": {
        "text": "A negative exponent does not make the value negative. It turns the power into a reciprocal.\n\na^(-n) = 1/a^n.\n\nSo 5^(-2) = 1/25.",
        "avatarPersona": "TUTOR"
