    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "√5 = ⁶√(5^3)=⁶√125\n∛4 = ⁶√(4^2)=⁶√16\n\n125>16, so √5 is larger. The roots never had to become decimals.",
        "avatarPersona": "TUTOR"
      },
