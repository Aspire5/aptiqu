    "concept_3": {
      "id": "concept_3",
      "type": "CONTENT",
      "content": {
        "text": "The conversion rule is systematic.\n\nTo turn √a into a sixth root, raise a to 3 because 6/2=3.\nTo turn ∛b into a sixth root, raise b to 2 because 6/3=2.\n\nThe value does not change; only its form changes.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
