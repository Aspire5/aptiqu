    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "A negative fractional power is a reciprocal, so its size may be obvious before detailed calculation.\n\n27^(−2/3)=1/27^(2/3)=1/9.",
