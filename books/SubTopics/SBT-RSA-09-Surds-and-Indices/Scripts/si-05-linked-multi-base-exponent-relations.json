    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "Rewrite in base 2:\n\n2^x=2^(2y)=2^(3z)\n\nTherefore x=2y=3z.\n\nThe exponents themselves carry the relation.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
