    },
    "teach_5_step": {
      "id": "teach_5_step",
      "type": "CONTENT",
      "content": {
        "text": "Because 2×3=6:\n\nk^(1/x+1/y)=k^(−1/z)\n\nSo 1/x+1/y+1/z=0.\n\nThe reciprocal exponents are what add.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_5"
        }
