    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "The chapter also links different bases through a common value.\n\nIf 2^x=3^y=6^(−z)=k, then 2=k^(1/x), 3=k^(1/y), 6=k^(−1/z).",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
