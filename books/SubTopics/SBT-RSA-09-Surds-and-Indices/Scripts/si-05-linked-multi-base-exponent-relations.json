    "recap": {
      "id": "recap",
      "type": "CONTENT",
      "content": {
        "text": "Linked exponent problems become simpler after translation.\n\nCommon base → linear exponent equation.\nA cycle of powers can force a product of exponents to equal 1.\nEqual powers reveal ratios between exponents.\nA base that is a product, such as 6=2×3, can connect reciprocal exponents.\n\nDescribe one place where the original exponential problem became an ordinary linear equation.",
        "avatarPersona": "TUTOR"
      },
