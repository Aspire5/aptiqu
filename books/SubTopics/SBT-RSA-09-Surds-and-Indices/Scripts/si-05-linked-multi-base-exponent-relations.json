    "concept_2": {
      "id": "concept_2",
      "type": "CONTENT",
      "content": {
        "text": "A cycle can cancel itself.\n\nIf x = y^a, y = z^b and z = x^c, substitute around the cycle:\n\nx = (x^c)^(ab) = x^(abc).\n\nFor the nontrivial positive values used in the chapter, this gives abc=1.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
