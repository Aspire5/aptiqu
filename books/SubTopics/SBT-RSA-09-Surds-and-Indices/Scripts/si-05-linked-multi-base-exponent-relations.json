    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "Substitute around the cycle:\n\nx=(z^b)^a=z^(ab)=(x^c)^(ab)=x^(abc)\n\nFor the non-trivial positive case used in these questions, the exponents must match: abc=1.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
