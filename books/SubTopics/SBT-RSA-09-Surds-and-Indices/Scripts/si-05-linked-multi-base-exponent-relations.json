    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Let's handle exponent problems where several bases and variables are tied together.\n\nThese can look complicated because there are many letters. The book's method is calmer: rewrite each base, compare exponents, and solve the ordinary equations that appear.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "concept_1"
        }
      ]
    },
    "concept_1": {
      "id": "concept_1",
      "type": "CONTENT",
      "content": {
        "text": "Suppose 8^x × 2^y = 2^9.\n\nBecause 8=2^3:\n2^(3x+y)=2^9.\n\nSo 3x+y=9.\n\nAn exponential equation has become an ordinary linear equation.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
    "q_1": {
