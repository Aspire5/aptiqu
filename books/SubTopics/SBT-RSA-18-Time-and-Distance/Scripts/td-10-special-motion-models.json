    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Sound questions are simple distance-speed-time questions with a very fast speed.\n\nIf sound travels at 300 m/s and is heard 5 seconds after it is produced:\nDistance = 300 × 5 = 1500 m.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "The delay tells how long the sound travelled.\n\nDistance from source = sound speed × hearing delay.\n\nKeep seconds with metres per second.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
