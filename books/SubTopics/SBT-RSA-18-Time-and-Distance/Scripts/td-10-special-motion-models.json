    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "An escalator is a relative-speed problem.\n\nA man walks up a moving-up escalator in 30 s. Walking down against the same escalator takes 90 s.\nLet one escalator length be 1.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "Up: man + escalator = 1/30.\nDown: man − escalator = 1/90.\nAdd:\n2 × man's rate = 1/30 + 1/90 = 4/90.\nMan's rate = 1/45.\n\nOn a stopped escalator he needs 45 s.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
