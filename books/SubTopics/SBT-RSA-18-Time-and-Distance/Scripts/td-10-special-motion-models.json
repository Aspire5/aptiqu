  "schemaVersion": "1.0",
  "scriptId": "td-10-special-motion-models",
  "sourceType": "MANUAL",
  "metadata": {
    "title": "Special Motion Models: Sound, Escalators, Leaps, and Puzzles",
    "description": "Translate unusual motion stories into ordinary rates, including climb-slip cycles, sound delays, escalators, leaps, pickup puzzles, and perpendicular motion.",
    "teachingApproach": "Open by telling the learner that unusual stories still reduce to rate × time or relative rate. Give each special pattern its own concrete model: final climb before a slip, sound-delay distance, max/min listener separation, escalator sum/difference rates, leap-frequency gains, pickup time-saving symmetry, mixed return-trip time algebra, and right-angle separation. Avoid memorizing unrelated tricks by naming the rate being tracked in each story.",
    "targetDurationMinutes": 30,
    "sourceScope": "R.S. Aggarwal, Quantitative Aptitude for Competitive Examinations, Chapter 18, Time and Distance. Approved scope: Cover special objective patterns from the chapter including climb-and-slip cycles, speed of sound and hearing delays, maximum/minimum separation from a sound source, moving escalators, leap-based pursuits, early-arrival pickup puzzles, mixed-mode return trips, and perpendicular-motion distance using Pythagoras."
  },
  "startNodeId": "start",
  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Some Time and Distance questions look nothing like a road journey.\n\nThe trick is to find the quantity that changes each minute or second. Once that rate is clear, the unusual story becomes ordinary motion.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "A monkey climbs 6 m in one minute, then slips 3 m in the next minute.\n\nEvery complete 2-minute cycle gains only 3 m.\nBut on the final climb, it reaches the top before any next slip happens.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "For a 60 m pole:\nAfter 18 full cycles = 36 min, height = 54 m.\nMinute 37: climbs 6 m to 60 m.\n\nAnswer = 37 min, not 40. The final slip never occurs.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
