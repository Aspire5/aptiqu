    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Two people hearing the same sound at different times can lie on the same side or opposite sides of the source.\n\nAt 300 m/s, delays of 5 s and 6 s mean distances 1500 m and 1800 m from the source.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "Minimum separation: same side → 1800 − 1500 = 300 m.\nMaximum separation: opposite sides → 1800 + 1500 = 3300 m.\n\nDifference for minimum, sum for maximum.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
