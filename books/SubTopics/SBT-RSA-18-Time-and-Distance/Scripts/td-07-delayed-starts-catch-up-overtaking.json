    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "The catch point can also be measured from the starting point.\n\nA walks at 4 km/hr. Three hours later B cycles after A at 10 km/hr.\nA's head start = 12 km.",
