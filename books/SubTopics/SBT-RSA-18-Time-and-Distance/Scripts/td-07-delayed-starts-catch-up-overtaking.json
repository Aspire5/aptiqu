    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "A goods-train question can be solved without naming the route length.\n\nSuppose a goods train starts 4 hours before an express. The express runs at 90 km/hr and catches it 2 hours after starting.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "At the catch point:\nGoods train has travelled 6 hours.\nExpress has travelled 2 hours = 180 km.\n\nSo goods speed = 180 ÷ 6 = 30 km/hr.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
