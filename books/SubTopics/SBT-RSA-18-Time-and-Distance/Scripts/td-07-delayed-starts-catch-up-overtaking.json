    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "In a chase, the catch time tells how far the person being chased runs too.\n\nA thief is 150 m ahead, running at 12 km/hr. Police run at 15 km/hr.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "Gap = 0.15 km.\nClosing speed = 3 km/hr.\nCatch time = 0.15/3 = 0.05 hr = 3 min.\n\nThief's distance in that time = 12 × 0.05 = 0.6 km = 600 m.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
