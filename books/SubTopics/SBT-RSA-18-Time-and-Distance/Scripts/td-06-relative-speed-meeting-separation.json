    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "When two travellers meet between two places, the distance each covers is proportional to speed because their meeting time is the same.\n\nSpeeds 60 : 40 = 3 : 2.\nSo the route is split 3 : 2 at the meeting point.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "For a 250 km route:\n\nFirst traveller covers 3/5 × 250 = 150 km.\nSecond covers 100 km.\n\nNo separate time calculation is needed.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
