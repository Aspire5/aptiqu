    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Relative speed also tells how fast two people separate.\n\nTwo walkers start together and move in opposite directions at 4 and 6 km/hr.\nAfter 1 hour they are 10 km apart.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "The separation grows at the sum of speeds.\n\nAfter t hours:\nSeparation = (u + v)t.\n\nThis is the same sum rule as moving toward each other — only the gap is growing instead of shrinking.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
