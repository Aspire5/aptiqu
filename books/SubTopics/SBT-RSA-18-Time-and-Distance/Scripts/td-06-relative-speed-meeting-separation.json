  "schemaVersion": "1.0",
  "scriptId": "td-06-relative-speed-meeting-separation",
  "sourceType": "MANUAL",
  "metadata": {
    "title": "Relative Speed: Meeting and Separation",
    "description": "Use sums or differences of speeds to track how fast a gap closes or grows, including simultaneous and staggered starts.",
    "teachingApproach": "Introduce relative speed as the rate at which the gap changes. Use opposite directions for addition and same direction for subtraction, then move to meeting-point ratios, staggered starts, and equations that combine same-direction and opposite-direction information. Keep the learner focused on the gap rather than two separate journeys whenever relative speed is enough.",
    "targetDurationMinutes": 30,
    "sourceScope": "R.S. Aggarwal, Quantitative Aptitude for Competitive Examinations, Chapter 18, Time and Distance. Approved scope: Teach relative speed for same and opposite directions, separation after time, meeting between two points, staggered opposite starts, same-direction gap closing, recovery of individual speeds from sum/difference conditions, and meeting-point distance ratios."
  },
  "startNodeId": "start",
  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Let's learn relative speed — the speed at which the gap between two movers changes.\n\nWhen they move toward each other, both help close the gap. When they move in the same direction, only the speed difference closes it.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "Two cyclists move toward each other at 18 km/hr and 22 km/hr.\n\nEvery hour, one removes 18 km of the gap and the other removes 22 km.\n\nGap closes at 18 + 22 = 40 km/hr.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "Opposite directions toward each other:\nRelative speed = sum of speeds.\n\nIf the starting gap is 120 km:\nMeeting time = 120 ÷ 40 = 3 hours.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
    "q_1": {
