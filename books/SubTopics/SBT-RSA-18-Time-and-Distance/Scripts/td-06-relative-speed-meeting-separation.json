    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Now put both movers in the same direction.\n\nA car at 70 km/hr follows a bus at 50 km/hr.\nEach hour the car gains only 20 km on the bus.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Same direction:\nRelative speed = faster − slower.\n\nIf the bus is 60 km ahead:\nCatch time = 60 ÷ 20 = 3 hr.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
