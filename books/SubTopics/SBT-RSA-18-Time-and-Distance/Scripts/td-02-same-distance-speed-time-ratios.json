    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "A time difference can reveal the actual times.\n\nSpeeds are 3 : 4, so times are 4 : 3.\nIf the slower person takes 20 minutes more, that difference is 1 ratio part.\n\nSo the times are 80 and 60 minutes.",
        "avatarPersona": "TUTOR"
