    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "The same idea works when speed is reduced.\n\nIf someone walks at 3/4 of the usual speed, the time becomes 4/3 of the usual time.\n\nA 60-minute trip becomes 60 × 4/3 = 80 minutes.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "The extra time is 20 minutes.\n\nThis is exactly the chapter pattern: reduced speed → reciprocal increase in time.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
