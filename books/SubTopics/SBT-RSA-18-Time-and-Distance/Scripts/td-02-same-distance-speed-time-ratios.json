    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "If distance is not the same, do not reverse the speed ratio blindly.\n\nDistance = speed × time.\nA travels at 65 km/hr for 8 hr → 520 km.\nB travels at 70 km/hr for 4 hr → 280 km.\n\nDistance ratio = 520 : 280 = 13 : 7.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
