    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "The inverse ratio also lets us find an actual time.\n\nA : B speed = 5 : 8.\nIf B takes 30 minutes, their time ratio is 8 : 5.\n\n5 parts = 30 min, so 1 part = 6 min.\nA takes 8 × 6 = 48 min.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "A quick check: A is slower than B, so A's time must be more than 30 minutes.\n\nThe answer 48 minutes passes that common-sense check.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
