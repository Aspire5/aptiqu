    "remedy_1": {
      "id": "remedy_1",
      "type": "CONTENT",
      "content": {
        "text": "Let's check this clue.\n\nSame distance means time is inversely proportional to speed.\n\nFor the same distance, speed × time is fixed. So times are in the inverse ratio 4 : 3.\n\nNow use that idea on a new question.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "retry_1"
        }
      ]
    },
