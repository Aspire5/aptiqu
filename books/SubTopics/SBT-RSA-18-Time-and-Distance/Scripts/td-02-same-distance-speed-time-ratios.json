    },
    "teach_6_step": {
      "id": "teach_6_step",
      "type": "CONTENT",
      "content": {
        "text": "The shortcut is:\n\nDistance ratio = speed ratio × time ratio\n\nBut multiply the matching speed and time for each traveller before simplifying.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
        }
      ]
