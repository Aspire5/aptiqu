    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Sometimes the distance is known and the speed change saves a fixed amount of time.\n\nFor a 240 km trip, increasing speed by 20 km/hr saves 1 hour.\nLet the old speed be x.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "Old time − new time = 1:\n\n240/x − 240/(x + 20) = 1\n\nThis becomes x² + 20x − 4800 = 0,\nso x = 60 km/hr.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
