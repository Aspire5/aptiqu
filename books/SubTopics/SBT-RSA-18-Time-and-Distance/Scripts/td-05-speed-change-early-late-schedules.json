    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "A late start shortens the time available, so the required speed must rise.\n\nA 300 km journey is planned at 60 km/hr.\nScheduled travel time = 5 hr.\nIf departure is 1 hr late, only 4 hr remain.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "Required speed = 300 ÷ 4 = 75 km/hr.\n\nThe important move is to reduce the available time first. Do not simply add the lost hour to the speed.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
