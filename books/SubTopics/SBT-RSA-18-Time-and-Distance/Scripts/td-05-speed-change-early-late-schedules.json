    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Two different speeds can give one late arrival and one early arrival.\n\nAt 30 km/hr a person is 20 min late; at 40 km/hr the same person is 10 min early.\n\nSo the two travel times differ by 30 minutes = 1/2 hour.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Let distance be D.\n\nD/30 − D/40 = 1/2\nD/120 = 1/2\nD = 60 km.\n\nEarly/late wording becomes a difference between travel times.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
