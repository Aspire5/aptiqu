    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "Exams often switch between km/hr and m/sec.\n\nUse the fact:\n1 km/hr = 5/18 m/sec.\n\nSo 72 km/hr = 72 × 5/18 = 20 m/sec.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "A fast mental route is to divide by 18 first, then multiply by 5.\n\n54 km/hr:\n54 ÷ 18 = 3\n3 × 5 = 15 m/sec.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
