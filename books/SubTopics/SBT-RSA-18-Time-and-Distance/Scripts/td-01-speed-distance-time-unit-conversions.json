    "teach_8": {
      "id": "teach_8",
      "type": "CONTENT",
      "content": {
        "text": "A fair speed comparison needs one common unit.\n\nSuppose A moves at 72 km/hr and B at 18 m/sec.\n\n72 km/hr = 20 m/sec, so A is faster by 2 m/sec.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
