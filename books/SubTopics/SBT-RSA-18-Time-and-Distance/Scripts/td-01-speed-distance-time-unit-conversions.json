    "teach_6_step": {
      "id": "teach_6_step",
      "type": "CONTENT",
      "content": {
        "text": "For mental calculation, turn minutes into a fraction of an hour:\n\n15 min = 1/4 hr\n20 min = 1/3 hr\n30 min = 1/2 hr\n40 min = 2/3 hr\n45 min = 3/4 hr.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
        }
      ]
    },
