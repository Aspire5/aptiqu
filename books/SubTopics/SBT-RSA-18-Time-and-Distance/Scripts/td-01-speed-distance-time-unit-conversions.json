    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "To go the other way, reverse the factor:\n\n1 m/sec = 18/5 km/hr.\n\nSo 15 m/sec = 15 × 18/5 = 54 km/hr.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_5_step"
        }
      ]
    },
    "teach_5_step": {
      "id": "teach_5_step",
      "type": "CONTENT",
      "content": {
        "text": "The conversion should make sense: one metre per second is more than 3 km/hr, so the number gets larger when m/sec becomes km/hr.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_5"
        }
      ]
    },
