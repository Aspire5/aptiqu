    "teach_7": {
      "id": "teach_7",
      "type": "CONTENT",
      "content": {
        "text": "Sometimes both distance and time are already in smaller units.\n\n900 metres in 3 minutes:\n\nSpeed = 900 ÷ 3 = 300 metres per minute.\n\nNo conversion is needed unless the answer asks for another unit.",
        "avatarPersona": "TUTOR"
