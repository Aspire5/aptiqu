    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Now reverse the question.\n\nA van covers 180 km at 60 km/hr.\n\nEach hour accounts for 60 km, so:\nTime = 180 ÷ 60 = 3 hours.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Think of time as: “How many speed-sized chunks fit into the distance?”\n\nIf the distance is 150 km and the speed is 60 km/hr:\n150 ÷ 60 = 2.5 hours = 2 hours 30 minutes.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
