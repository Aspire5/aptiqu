    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "Time conversion is often the hidden step.\n\n2 hr 15 min is not 2.15 hours.\n\n15 minutes = 15/60 = 0.25 hour, so the time is 2.25 hours.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
