    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Speed tells us how much distance is covered in one unit of time.\n\nA cyclist covers 180 km in 3 hours:\n\nSpeed = 180 ÷ 3 = 60 km/hr.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "The division has meaning:\n\n180 km shared equally across 3 hours gives 60 km in each hour.\n\nThat is why speed = distance ÷ time.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
