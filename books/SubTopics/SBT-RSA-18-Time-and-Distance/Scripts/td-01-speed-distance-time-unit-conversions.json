    },
    "teach_8_step": {
      "id": "teach_8_step",
      "type": "CONTENT",
      "content": {
        "text": "Do not compare the printed numbers 72 and 18. Their units are different.\n\nConvert first, compare second. This simple habit prevents many exam traps.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_8"
        }
      ]
    },
