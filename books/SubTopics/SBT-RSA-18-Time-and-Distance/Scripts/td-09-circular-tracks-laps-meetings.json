    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "Meeting somewhere is different from meeting again at the starting point.\n\nOn a 360 m track, runners at 6 and 9 m/s have lap times:\n360/6 = 60 sec\n360/9 = 40 sec.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
