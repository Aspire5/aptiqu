    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Meeting count comes from relative laps completed.\n\nTwo walkers go in opposite directions at 2 and 3 rounds per hour.\nRelative rate = 5 rounds per hour.",
        "avatarPersona": "TUTOR"
