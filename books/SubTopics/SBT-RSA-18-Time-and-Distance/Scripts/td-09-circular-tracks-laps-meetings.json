  "schemaVersion": "1.0",
  "scriptId": "td-09-circular-tracks-laps-meetings",
  "sourceType": "MANUAL",
  "metadata": {
    "title": "Circular Tracks, Laps, and Repeated Meetings",
    "description": "Apply relative speed on a circle, distinguish first meeting from first overtake, and use lap-time LCM for common returns.",
    "teachingApproach": "Map the circle to a gap measured in one circumference. Use the sum of speeds for opposite directions and the difference for same-direction overtaking, then count repeated meetings, handle opposite starting points, use LCM for returning to the start together, and recover speeds from same/opposite meeting intervals.",
    "targetDurationMinutes": 30,
    "sourceScope": "R.S. Aggarwal, Quantitative Aptitude for Competitive Examinations, Chapter 18, Time and Distance. Approved scope: Cover first meetings and overtakes on circular tracks, repeated meeting counts, common return to the starting point, opposite starting points, mixed units, lap rates, and recovery of individual speeds from opposite-direction and same-direction meeting intervals."
  },
  "startNodeId": "start",
  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Let's learn circular-track problems with one simple idea: a full lap is the gap that must be gained or closed.\n\nRelative speed still works — the road just wraps around.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "Two cyclists start from the same point on a 300 m track in opposite directions at 7 m/s and 8 m/s.\n\nThey move toward each other around the circle at 15 m/s.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "They meet when their combined distance equals one full circumference:\n\nTime = 300 ÷ 15 = 20 seconds.\n\nOpposite directions on a circle → circumference ÷ sum of speeds.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
    "q_1": {
