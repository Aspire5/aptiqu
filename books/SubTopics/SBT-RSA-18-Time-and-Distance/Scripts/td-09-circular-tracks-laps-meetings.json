      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "In 1.5 hours, relative laps = 5 × 1.5 = 7.5.\n\nThey have completed 7 full relative laps, so they cross 7 times after the start before 1.5 hours.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
