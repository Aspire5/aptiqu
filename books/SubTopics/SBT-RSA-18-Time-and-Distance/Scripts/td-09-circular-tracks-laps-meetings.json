    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "If both move in the same direction, the faster runner must gain one full lap.\n\nOn a 400 m track, speeds 6 and 4 m/s give a relative speed of 2 m/s.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Overtake time = 400 ÷ 2 = 200 seconds.\n\nSame direction on a circle → circumference ÷ speed difference.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
