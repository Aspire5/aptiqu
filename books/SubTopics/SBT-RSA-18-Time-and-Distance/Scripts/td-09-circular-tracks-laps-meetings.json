    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "They are both back at the start together after the least common multiple of 60 and 40:\n\nLCM = 120 sec.\n\nUse lap-time LCM for a shared return to the start.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
