    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "A journey can also be described by fractions of distance, with only the final distance given.\n\nSuppose 2/5 is by rail and 1/4 by bus.\nUsed fraction = 8/20 + 5/20 = 13/20.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "Remaining fraction = 7/20.\nIf that remaining part is 14 km:\n\n7/20 of total = 14\nTotal = 14 × 20/7 = 40 km.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
