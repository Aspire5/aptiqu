    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "A target average speed creates a target total time.\n\nFor 240 km at an overall average of 60 km/hr, total allowed time = 240/60 = 4 hr.",
        "avatarPersona": "TUTOR"
