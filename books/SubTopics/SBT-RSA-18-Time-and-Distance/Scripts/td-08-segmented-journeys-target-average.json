    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "Some journeys change speed in a regular pattern.\n\nA car moves for 6 hours, starting at 30 km/hr and increasing by 5 km/hr each hour.\nHourly speeds are 30, 35, 40, 45, 50, 55.",
