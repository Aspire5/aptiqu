    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Sometimes the total distance is unknown, but the fractions of the route are known.\n\nSuppose half the route is at 30 km/hr and half at 60 km/hr. Let total distance be D.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Time = D/2 ÷ 30 + D/2 ÷ 60\n= D/60 + D/120\n= D/40.\n\nIf total time is 3 hr, D/40 = 3, so D = 120 km.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
