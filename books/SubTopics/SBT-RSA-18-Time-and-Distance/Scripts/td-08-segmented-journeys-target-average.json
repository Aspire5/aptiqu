  "schemaVersion": "1.0",
  "scriptId": "td-08-segmented-journeys-target-average",
  "sourceType": "MANUAL",
  "metadata": {
    "title": "Segmented Journeys and Target Average Speed",
    "description": "Break multi-stage trips into clean pieces, recover unknown total distance, and find the speed needed for a target time or average.",
    "teachingApproach": "Treat each stage as its own distance-speed-time block, then combine only after each block is solved. Use route fractions, remaining-distance arithmetic, target average speed, regular hourly speed changes, accident slowdowns, and final-stage deadline recovery. Reuse the equal-distance average only when the route really is split into equal distances.",
    "targetDurationMinutes": 30,
    "sourceScope": "R.S. Aggarwal, Quantitative Aptitude for Competitive Examinations, Chapter 18, Time and Distance. Approved scope: Cover multi-stage journeys, route fractions, total distance from fractional-speed segments, target overall average speed, changing speed by regular intervals, accident/slowdown delays, equal-distance two-speed totals, and required speed for the remaining distance within a fixed total time."
  },
  "startNodeId": "start",
  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Let's learn to handle a journey that changes speed partway through.\n\nThe safest method is to treat each stage separately: find its distance or time, then add only after each stage is clear.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "A car covers 80 km at 40 km/hr, then 120 km at 60 km/hr.\n\nFirst stage time = 80/40 = 2 hr.\nSecond stage time = 120/60 = 2 hr.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "Total time = 4 hr and total distance = 200 km.\n\nA segmented journey is just several small distance-speed-time problems joined together.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
