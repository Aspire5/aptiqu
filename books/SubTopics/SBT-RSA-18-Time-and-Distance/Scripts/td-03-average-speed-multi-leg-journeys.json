    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "Three equal-distance legs use the same idea, but there is no simple two-speed shortcut.\n\nTake one equal distance d.\nAt 30, 45 and 90 km/hr, total time is:\nd/30 + d/45 + d/90 = d/15.\nTotal distance = 3d.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "Average speed = 3d ÷ (d/15) = 45 km/hr.\n\nThe method is reliable: choose an easy common distance or keep it as d, add the times, then divide total distance by total time.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
