    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "A journey can split by fractions instead of equal legs.\n\nSuppose half the distance is at 24 km/hr, one quarter at 30, and one quarter at 60.\nLet total distance be D.\n\nTime = D/48 + D/120 + D/240 = D/30.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_5_step"
        }
      ]
    },
    "teach_5_step": {
      "id": "teach_5_step",
      "type": "CONTENT",
      "content": {
        "text": "Average speed = D ÷ (D/30) = 30 km/hr.\n\nThe total distance cancels, so you can choose a convenient total such as 240 km if fractions feel easier with actual numbers.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_5"
        }
      ]
    },
