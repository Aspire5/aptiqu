    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Equal time is different.\n\nIf you travel 2 hours at 40 km/hr and 2 hours at 70 km/hr:\nDistance = 80 + 140 = 220 km.\nTime = 4 hr.\nAverage = 55 km/hr.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "When the times are equal, each speed gets the same weight.\n\nThen the arithmetic mean works:\n(40 + 70) ÷ 2 = 55.\n\nSo always ask: equal distance, or equal time?",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
