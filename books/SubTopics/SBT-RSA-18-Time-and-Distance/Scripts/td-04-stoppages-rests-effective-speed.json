  "schemaVersion": "1.0",
  "scriptId": "td-04-stoppages-rests-effective-speed",
  "sourceType": "MANUAL",
  "metadata": {
    "title": "Stoppages, Rests, and Effective Speed",
    "description": "Separate moving time from waiting time, count scheduled stops correctly, and connect running speed with whole-trip average speed.",
    "teachingApproach": "Use one elapsed hour to make running speed versus effective speed visible. Then count stops before the destination, handle rests after fixed distances, remove stoppage time when recovering running speed, and finish by combining moving time and stop time into a whole-trip average. Repeatedly call out the endpoint trap: there is no extra stop after arrival.",
    "targetDurationMinutes": 30,
    "sourceScope": "R.S. Aggarwal, Quantitative Aptitude for Competitive Examinations, Chapter 18, Time and Distance. Approved scope: Cover running speed versus speed including stoppages, fixed-duration halts, stops after fixed distances, rests after each kilometre, equal halts at junctions, recovering running speed from elapsed time, and whole-trip average speed including stops. Teach careful counting of stops before—not after—the destination."
  },
  "startNodeId": "start",
  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Let's learn why a vehicle can have two different speeds on the same route.\n\nIts running speed ignores stops. Its overall speed includes every minute spent waiting.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "A bus runs at 64 km/hr, but its overall speed including stops is 48 km/hr.\n\nIn one elapsed hour it covers 48 km.\nAt 64 km/hr, 48 km needs 48/64 = 3/4 hour = 45 minutes.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "So in each elapsed hour:\n\n45 minutes moving\n15 minutes stopped\n\nThe missing 15 minutes is the stoppage time.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
