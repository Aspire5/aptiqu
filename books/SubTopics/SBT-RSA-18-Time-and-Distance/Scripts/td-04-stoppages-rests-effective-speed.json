      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "At 10 km/hr, 5 km takes 30 minutes of walking.\nFour 5-minute rests add 20 minutes.\n\nTotal = 50 minutes.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
