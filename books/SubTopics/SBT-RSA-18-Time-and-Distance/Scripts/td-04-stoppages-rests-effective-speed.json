    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Rest-after-each-kilometre questions have the same counting trap.\n\nFor a 5 km walk, resting after every kilometre means rests after km 1, 2, 3 and 4.\n\nThere is no need to rest after the journey is over.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
