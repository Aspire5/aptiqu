    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "Sometimes the question gives the total trip time and the stops separately.\n\nA train covers 300 km in 5 hr 30 min, including 30 minutes of stops.\n\nActual moving time = 5 hours.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
