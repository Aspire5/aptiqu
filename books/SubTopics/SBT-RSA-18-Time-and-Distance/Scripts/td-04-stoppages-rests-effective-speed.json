    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Now suppose stops happen after fixed distances.\n\nA car covers 900 km at 90 km/hr and stops 10 minutes after every 180 km.\nDriving time = 10 hours.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Count only stops before the destination:\n180, 360, 540, 720 km → 4 stops.\n\nThere is no extra stop after arriving at 900 km.\nStop time = 40 min.\nTotal = 10 hr 40 min.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
