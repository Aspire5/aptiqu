{
  "schemaVersion": "1.0",
  "scriptId": "src-02-square-roots-prime-factorisation",
  "sourceType": "MANUAL",
  "metadata": {
    "title": "Square Roots by Prime Factorisation",
    "description": "Break a number into prime factors, pair equal factors, and take one factor from each pair to get an exact square root.",
    "teachingApproach": "Turn factorisation into a visual pairing habit: pairs first, then larger numbers, unpaired-factor diagnosis, fractions, decimals, exponent form, large products and a book-style capstone. Each step explains why even prime counts matter and every answer is checked by squaring.",
    "targetDurationMinutes": "Teach the factorisation method used in the chapter: resolve a number into primes, group equal prime factors in pairs, and take one factor from each pair. Explain why a perfect square has an even count of every prime factor. Build from small roots to larger integers, then fractions and terminating decimals written as fractions. Include exponent-form shortcuts and recognition of an unpaired factor that prevents an integer square root. Learners should check by squaring the extracted root. Do not yet repair an imperfect square by multiplying or dividing; that belongs to the perfect-square subtopic.",
    "sourceScope": "R.S. Aggarwal, Quantitative Aptitude for Competitive Examinations, Chapter 5, Square Roots and Cube Roots. Approved scope: 28"
  },
  "startNodeId": "start",
  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Let's learn a square-root method that does not depend on remembering the answer.\n\nIf a number is a perfect square, its prime factors arrive in pairs. Find the pairs, keep one from each, and the root appears.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "Prime factorisation turns a square root into a pairing game.\n\n144 = 2 × 2 × 2 × 2 × 3 × 3\n= 2⁴ × 3²",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "Pair equal primes:\n\n(2×2)(2×2)(3×3)\n\nTake one factor from each pair:\n2 × 2 × 3 = 12\n\nSo √144 = 12.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
    "q_1": {
