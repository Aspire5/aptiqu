    "concept_2": {
      "id": "concept_2",
      "type": "CONTENT",
      "content": {
        "text": "Exponent form makes the same idea shorter.\n\nIf N = 2⁶ × 3², then\n√N = 2³ × 3.\n\nFor an exact integer square root, every prime exponent must be even.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
