    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "Exponent form lets you see all the pairs at once.\n\nN = 2⁶ × 3⁴ × 5²\n\nTaking the square root simply halves every exponent.",
        "avatarPersona": "TUTOR"
