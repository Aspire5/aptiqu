    "recap": {
      "id": "recap",
      "type": "CONTENT",
      "content": {
        "text": "Prime-factor square roots are built from pairs.\n\nFactor the number, group identical primes in twos, and take one factor from every pair.\n\nIn exponent form, halve every even exponent.\n\nAn unpaired prime means the square root is not an integer.",
        "avatarPersona": "TUTOR"
      },
