    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "Fractions use the same pairs in the numerator and denominator.\n\n√(441/784)\n= √(3²×7²) / √(2⁴×7²)",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "Take one from each pair:\n\n= (3×7)/(2²×7)\n= 21/28\n= 3/4\n\nThe pairing idea has not changed; it just happens twice.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
