    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "What if one prime is left without a partner?\n\n450 = 2 × 3² × 5²\n\nThe 3s pair. The 5s pair. The single 2 does not.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "That tells us 450 is not a perfect square.\n\nIts root is not a whole number because one prime factor is unpaired.\n\nFor an integer square root, every prime count must be even.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
