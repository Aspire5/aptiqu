    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "The same pairing method handles larger roots.\n\n1764 = 2² × 3² × 7²\n\nEvery prime already arrives in a pair.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Take one from each pair:\n\n√1764 = 2 × 3 × 7 = 42\n\nCheck: 42² = 1764 ✓",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
