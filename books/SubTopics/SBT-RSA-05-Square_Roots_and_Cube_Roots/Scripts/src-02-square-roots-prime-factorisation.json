    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Let's learn square roots by prime factorisation with a small example.\n\nWe will build the method one step at a time and check each answer.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "concept_1"
        }
      ]
    },
    "concept_1": {
      "id": "concept_1",
      "type": "CONTENT",
      "content": {
        "text": "Prime factorisation turns a square root into pairs.\n\nExample: 900 = 2² × 3² × 5².\n\nTake one factor from each pair:\n√900 = 2 × 3 × 5 = 30.\n\nEvery pair contributes one factor outside the root.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
