    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Use identities to expand root expressions: (√a+√b)²=a+b+2√(ab), while (√a−√b)²=a+b−2√(ab). The cross-term sign follows the sign between the roots; for example (√7+√2)²=9+2√14.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
