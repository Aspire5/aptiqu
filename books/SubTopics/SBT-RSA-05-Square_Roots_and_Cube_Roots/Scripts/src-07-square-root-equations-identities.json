    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Squaring can introduce extraneous values. For √(2x−1)=x−2, the right side must first be non-negative, so x≥2. Squaring gives 2x−1=(x−2)²; solve, retain candidates meeting the domain, and check them in the unsquared equation.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
