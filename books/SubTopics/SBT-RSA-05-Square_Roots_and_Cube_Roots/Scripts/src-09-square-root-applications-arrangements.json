    "recap": {
      "id": "recap",
      "type": "CONTENT",
      "content": {
        "text": "Square-root applications are usually hidden n×n relationships.\n\nIf the total is n², take √total to get the side or number of members.\nIf n is given, square it to get the total.\nFor leftovers, use the largest complete square that does not exceed the total.",
        "avatarPersona": "TUTOR"
      },
