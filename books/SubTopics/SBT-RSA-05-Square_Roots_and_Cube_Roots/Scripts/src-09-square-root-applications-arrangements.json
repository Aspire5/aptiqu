    "concept_3": {
      "id": "concept_3",
      "type": "CONTENT",
      "content": {
        "text": "Some collection problems also create a square.\n\nIf a group has n members and each member contributes n paise, the total is n² paise.\n\nSo if the total collection is known, take its square root to get the number of members.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
