      "type": "CONTENT",
      "content": {
        "text": "Let's learn square-root applications and square arrangements with a small example.\n\nWe will build the method one step at a time and check each answer.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "concept_1"
        }
      ]
    },
    "concept_1": {
      "id": "concept_1",
      "type": "CONTENT",
      "content": {
        "text": "When a total is arranged in a square, the number of rows equals the number in each row.\n\nIf there are n rows and n items in each row, total=n².\n\nSo the side count is √(total).",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
