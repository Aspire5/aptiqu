    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "If the total is not a perfect square, the largest complete square uses the greatest square below it.\n\n36,581 soldiers: 191² = 36,481 and 192² is already too large.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "So 36,481 can stand in a solid square.\n\nLeft over:\n36,581 − 36,481 = 100 soldiers\n\nThe leftover is the gap above the largest square.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
