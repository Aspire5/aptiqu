    "concept_4": {
      "id": "concept_4",
      "type": "CONTENT",
      "content": {
        "text": "A story may mix a total with its square root.\n\nLet the herd be H. If twice the square root of the herd goes away, write that as 2√H.\n\nOften it is easier to let x=√H, so H=x². Then the story becomes an ordinary quadratic in x.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
