    "concept_6": {
      "id": "concept_6",
      "type": "CONTENT",
      "content": {
        "text": "Before solving a word problem, decide which quantity is the square and which is the root.\n\nSquare arrangement: total is the square.\nEqual contribution n paise from n members: money total is the square.\nA given side or member count: square it to get the total.\n\nAlways attach the unit at the end.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
        }
      ]
    },
