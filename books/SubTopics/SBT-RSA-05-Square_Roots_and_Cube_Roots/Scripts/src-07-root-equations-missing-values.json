    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "The unknown can sit beside a square inside the root.\n\n√(5 + x²) = 3\n\nSquare:\n5 + x² = 9",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "Then:\nx² = 4\n\nIn the chapter’s positive-value style, x = 2.\n\nCheck: √(5+4)=3.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
