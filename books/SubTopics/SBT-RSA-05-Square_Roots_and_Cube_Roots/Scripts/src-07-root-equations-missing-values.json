    "concept_3": {
      "id": "concept_3",
      "type": "CONTENT",
      "content": {
        "text": "A question may hide a square inside the radicand.\n\n√(5+x²)=3 gives 5+x²=9, so x²=4.\n\nIf the question asks for a positive missing number, x=2.\nIf signs are not restricted, x²=4 has two algebraic values, ±2.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
