    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "Sometimes the question mark is the radicand itself.\n\n√? + 14 = 51\n\nFirst isolate the root:\n√? = 37",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "Now square:\n\n? = 37² = 1369\n\nCheck: √1369 + 14 = 37+14 = 51.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
