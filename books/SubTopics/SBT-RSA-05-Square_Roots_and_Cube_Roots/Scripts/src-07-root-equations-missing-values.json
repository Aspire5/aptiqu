    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Now hide x in a denominator under the root.\n\n√(32.4/x) = 2\n\nSquare first:\n32.4/x = 4",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Now solve the ordinary equation:\n\n4x = 32.4\nx = 8.1\n\nCheck: 32.4÷8.1 = 4 and √4 = 2.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
