    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "A root can be only one part of a longer equation. The source example uses:\n\n√86.49 + √(5+x²) = 12.3\n\nThe first root is known: √86.49 = 9.3.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_6_step"
        }
      ]
    },
    "teach_6_step": {
      "id": "teach_6_step",
      "type": "CONTENT",
      "content": {
        "text": "So:\n√(5+x²) = 12.3−9.3 = 3\n\nSquare:\n5+x²=9\nx²=4\npositive x=2",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
        }
      ]
    },
