    "teach_8": {
      "id": "teach_8",
      "type": "CONTENT",
      "content": {
        "text": "Capstone: roots can sit inside ordinary BODMAS, but the order stays clean.\n\nIf √x + 6 = 25, isolate the root before squaring:\n√x = 19\nx = 361",
