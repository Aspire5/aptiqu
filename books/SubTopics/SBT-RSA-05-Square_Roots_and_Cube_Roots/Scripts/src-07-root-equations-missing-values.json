    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "Decimals under a root still obey the same equation steps.\n\n√(0.0169 × x) = 1.3\n\nSquare both sides:\n0.0169x = 1.69",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_5_step"
        }
      ]
    },
    "teach_5_step": {
      "id": "teach_5_step",
      "type": "CONTENT",
      "content": {
        "text": "Now notice 1.69 ÷ 0.0169 = 100.\n\nSo x = 100.\n\nCheck: 0.0169×100 = 1.69 and √1.69 = 1.3.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_5"
        }
      ]
    },
