      "content": {
        "text": "The check returns to the original line:\n√361 + 6 = 19+6 = 25 ✓\n\nDo not square the whole left side while the +6 is still attached.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_8"
        }
      ]
