    "concept_2": {
      "id": "concept_2",
      "type": "CONTENT",
      "content": {
        "text": "If the unknown is in a denominator under the root, first square the equation, then solve the ordinary fraction.\n\nExample: √(100/x)=5\n100/x=25\nx=4.",
        "avatarPersona": "TUTOR"
