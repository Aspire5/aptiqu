    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "At each stage, if R is the root already found and d is the next digit, the added square contribution is (10R+d)²−(10R)²=20Rd+d². That is why you select the largest d from 0 to 9 that keeps the trial product within the current dividend.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
