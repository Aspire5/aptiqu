    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "For long division, group digits in pairs from the right. For 2,025, write 20 | 25. The largest square not exceeding 20 is 4², so start with 4 and subtract 16. Bring down 25 to make 425; double 4 to get 8, then choose digit 5 because 85×5=425. The root is 45.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
