    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Only like radicals combine. In contrast, √9+√16=3+4=7, while √(9+16)=5. This small example disproves the tempting but false rule √a+√b=√(a+b). Addition and multiplication do not obey the same radical law.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
