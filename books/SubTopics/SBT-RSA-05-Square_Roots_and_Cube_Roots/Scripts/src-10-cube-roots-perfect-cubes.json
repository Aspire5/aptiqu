    "recap": {
      "id": "recap",
      "type": "CONTENT",
      "content": {
        "text": "Cube roots use triples of equal prime factors.\n\nA perfect cube has prime exponents divisible by 3.\nFor multiplication, complete each exponent up to the next multiple of 3; for division, remove the excess down to a multiple of 3.\n\nCheck a cube-root answer by cubing it.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "finish"
        }
      ]
