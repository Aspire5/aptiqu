    "concept_6": {
      "id": "concept_6",
      "type": "CONTENT",
      "content": {
        "text": "Cube identities help with some cube-root surd expressions.\n\nThe book already uses:\na³−b³=(a−b)(a²+ab+b²).\n\nSo if a cube-root expression has the matching second factor, the product can become a simple difference of cubes.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
        }
      ]
    },
