    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "A perfect cube needs prime exponents in multiples of three.\n\n864 = 2⁵ × 3³\n\nThe 3s already form a triple; the 2s leave two extra beyond one triple.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_5_step"
        }
      ]
    },
    "teach_5_step": {
      "id": "teach_5_step",
      "type": "CONTENT",
      "content": {
        "text": "To make a cube by multiplying, raise 2⁵ to the next multiple of 3: 2⁶.\n\nOne more factor 2 is enough.\n\nSo 864 × 2 is a perfect cube.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_5"
        }
      ]
    },
