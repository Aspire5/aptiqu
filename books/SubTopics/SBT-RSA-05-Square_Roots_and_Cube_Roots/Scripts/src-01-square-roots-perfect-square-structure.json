    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Integer squares can end only in 0, 1, 4, 5, 6, or 9. This is a quick rejection test, not proof that a candidate is square. Group digits in pairs from the units place; the number of groups tells you the number of digits in the integer root.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
