    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "An integer is a perfect square when it equals k² for an integer k. In prime factorization, every exponent must be even: 900=2²×3²×5², so √900=30. An odd exponent means the number is not an integer square, though its radical can still be simplified.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
