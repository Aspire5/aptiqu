    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "The conjugate works just as well when both terms are roots.\n\n1/(√5−√3)\n\nUse √5+√3.",
        "avatarPersona": "TUTOR"
