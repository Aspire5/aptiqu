    "concept_6": {
      "id": "concept_6",
      "type": "CONTENT",
      "content": {
        "text": "Some multi-term surd fractions become easy after rationalising each denominator.\n\nThe safe habit is one fraction at a time: choose a conjugate, simplify, then combine like radicals.\n\nDo not try to rationalise an entire long expression in one jump.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
        }
      ]
    },
