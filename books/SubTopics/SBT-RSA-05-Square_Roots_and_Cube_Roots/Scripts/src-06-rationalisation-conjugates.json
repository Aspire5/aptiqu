      "type": "CONTENT",
      "content": {
        "text": "Let's learn rationalisation and conjugate radical forms with a small example.\n\nWe will build the method one step at a time and check each answer.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "concept_1"
        }
      ]
    },
    "concept_1": {
      "id": "concept_1",
      "type": "CONTENT",
      "content": {
        "text": "Rationalising means removing a radical from the denominator.\n\nFor 1/√5, multiply top and bottom by √5:\n\n1/√5 = √5/5.\n\nWe multiply by √5/√5, which is 1, so the value does not change.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
