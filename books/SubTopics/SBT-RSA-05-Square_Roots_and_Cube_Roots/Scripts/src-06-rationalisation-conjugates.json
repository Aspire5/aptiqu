    "recap": {
      "id": "recap",
      "type": "CONTENT",
      "content": {
        "text": "Rationalisation changes the form, not the value.\n\nFor one surd in the denominator, multiply by that surd.\nFor two terms, use the conjugate.\n\nThe conjugate works because the denominator becomes a difference of squares.\n\nAfter that, simplify coefficients and combine like surds carefully.",
        "avatarPersona": "TUTOR"
      },
