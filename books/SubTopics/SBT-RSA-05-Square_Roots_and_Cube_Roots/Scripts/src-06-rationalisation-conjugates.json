    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "A ratio of conjugate surds can look harder than it is.\n\n(√5+√3)/(√5−√3)\n\nMultiply by the denominator’s conjugate √5+√3.",
        "avatarPersona": "TUTOR"
