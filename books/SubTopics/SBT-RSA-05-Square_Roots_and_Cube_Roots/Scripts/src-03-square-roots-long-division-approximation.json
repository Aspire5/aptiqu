    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "Decimals use the same periods, but the decimal point separates the integer and decimal pairs.\n\n1.5625 becomes:\n1 | 56 | 25",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_5_step"
        }
      ]
    },
    "teach_5_step": {
      "id": "teach_5_step",
      "type": "CONTENT",
      "content": {
        "text": "The root digits follow those periods:\n\n√1.5625 = 1.25\n\nCheck: 1.25² = 1.5625.\n\nThe decimal point in the root sits after the root of the integer-side periods.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_5"
        }
      ]
    },
