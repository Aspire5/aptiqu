          },
          {
            "id": "c",
            "label": "5 | 38 | 24"
          },
          {
            "id": "d",
            "label": "5 | 3 | 82 | 4"
          }
        ]
      },
      "content": {
        "text": "How should 53824 be grouped for the square-root long-division method?",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "condition": {
            "field": "isCorrect",
