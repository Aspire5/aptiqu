    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "A zero can appear inside the root. Look at √41209.\n\nPeriods: 4 | 12 | 09\nFirst digit: 2 because 2² = 4.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "Bring down 12. Doubling 2 gives a trial start of 4, but no positive next digit fits into 12.\n\nSo the next root digit is 0.\n\nBring down 09 → 1209. Double 20 → 40; 403 × 3 = 1209.\n\n√41209 = 203.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
