    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "Tiny decimals need leading zero periods to be kept.\n\n0.000441 has decimal pairs 00 | 04 | 41.\n\nThose leading pairs create leading zero digits in the root.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_6_step"
        }
      ]
    },
    "teach_6_step": {
      "id": "teach_6_step",
      "type": "CONTENT",
      "content": {
        "text": "The exact result is:\n\n√0.000441 = 0.021\n\nCheck: 0.021² = 0.000441.\n\nThis is why counting decimal places by sight is less reliable than reading them in pairs.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
        }
      ]
    },
