    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Let's learn square roots by long division and approximation with a small example.\n\nWe will build the method one step at a time and check each answer.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "concept_1"
        }
      ]
    },
    "concept_1": {
      "id": "concept_1",
      "type": "CONTENT",
      "content": {
        "text": "Long division begins by making periods of two digits from the right.\n\nFor 1471369, the chapter writes the periods as 1 | 47 | 13 | 69.\n\nEach period gives one digit of the square root.\n\nSo a 7-digit number has 4 periods and its square root can have 4 digits.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
