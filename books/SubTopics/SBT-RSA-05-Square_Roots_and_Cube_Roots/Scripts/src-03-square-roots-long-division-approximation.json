    "concept_2": {
      "id": "concept_2",
      "type": "CONTENT",
      "content": {
        "text": "After the first root digit, double the root found so far.\n\nIf the first digit is 2, the trial divisor starts with 4_.\n\nChoose the next digit d so that (40+d)×d does not exceed the current dividend.\n\nThat same digit d is appended to the root.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
    "q_2": {
      "id": "q_2",
