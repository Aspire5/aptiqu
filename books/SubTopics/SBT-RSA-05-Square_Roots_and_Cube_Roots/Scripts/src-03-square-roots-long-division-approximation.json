    "concept_3": {
      "id": "concept_3",
      "type": "CONTENT",
      "content": {
        "text": "When the chosen product is subtracted, bring down the next two-digit period and repeat.\n\nThe root grows one digit at a time.\n\nIf the final remainder becomes zero, you found an exact square root.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
