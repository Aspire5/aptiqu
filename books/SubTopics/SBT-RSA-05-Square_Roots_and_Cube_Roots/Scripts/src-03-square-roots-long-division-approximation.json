    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Now use the periods to build √2025.\n\nRead it as 20 | 25.\nThe largest square not above 20 is 4² = 16, so the first root digit is 4.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Remainder: 20 − 16 = 4. Bring in the next period: 425.\n\nDouble the root so far: 4 → 8.\nChoose the next digit 5 because 85 × 5 = 425.\n\nSo √2025 = 45.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
