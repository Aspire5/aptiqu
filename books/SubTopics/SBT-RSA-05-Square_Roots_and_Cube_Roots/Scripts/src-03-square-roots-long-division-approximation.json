    "recap": {
      "id": "recap",
      "type": "CONTENT",
      "content": {
        "text": "Long division is a digit-by-digit square-root method.\n\nPair digits from the right, choose the first square, double the root found so far, test the next digit, subtract, and bring down the next pair.\n\nFor decimals, work in pairs after the decimal point too.\n\nUse the digit-count rule as a quick size check.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "finish"
        }
      ]
