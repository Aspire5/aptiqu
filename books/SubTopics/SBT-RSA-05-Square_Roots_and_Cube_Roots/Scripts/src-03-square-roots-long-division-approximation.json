            "id": "c",
            "label": "3"
          },
          {
            "id": "d",
            "label": "4"
          }
        ]
      },
      "content": {
        "text": "For a step with current root 2 and current dividend 120, which next digit works?",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "condition": {
            "field": "isCorrect",
            "value": true,
            "operator": "EQUALS"
