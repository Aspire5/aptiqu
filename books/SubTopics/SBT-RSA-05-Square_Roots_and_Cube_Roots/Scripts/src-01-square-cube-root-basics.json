    "concept_6": {
      "id": "concept_6",
      "type": "CONTENT",
      "content": {
        "text": "Always check the operation that was undone.\n\nIf √N = r, then r² must equal N.\n\nIf ∛N = c, then c³ must equal N.\n\nThis catches many misplaced-decimal mistakes.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
