    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Cube roots reverse three equal factors.\n\n4 × 4 × 4 = 64\n\nSo ∛64 = 4.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "The check now uses a cube instead of a square:\n\n4³ = 64 ✓\n\nSquare root → two equal factors.\nCube root → three equal factors.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
