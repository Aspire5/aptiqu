    "recap": {
      "id": "recap",
      "type": "CONTENT",
      "content": {
        "text": "Square root undoes a square; cube root undoes a cube.\n\nUse √(ab)=√a√b and √(a/b)=√a/√b when the pieces are convenient.\n\nFor decimals, verify the decimal point by squaring.\n\nA fast final check is simple: square a square-root answer, cube a cube-root answer.",
        "avatarPersona": "TUTOR"
      },
