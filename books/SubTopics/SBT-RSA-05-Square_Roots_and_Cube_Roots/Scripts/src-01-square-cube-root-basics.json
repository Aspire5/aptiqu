    "concept_2": {
      "id": "concept_2",
      "type": "CONTENT",
      "content": {
        "text": "A cube root asks for a number used three times as a factor.\n\n4 × 4 × 4 = 64.\n\nSo ∛64 = 4.\n\nSquare root uses pairs. Cube root uses groups of three.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
