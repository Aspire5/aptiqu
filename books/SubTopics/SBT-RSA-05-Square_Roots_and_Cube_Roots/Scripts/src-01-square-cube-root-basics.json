    "q_1_remedy": {
      "id": "q_1_remedy",
      "type": "CONTENT",
      "content": {
        "text": "A common mistake is to divide by 2. A square root does not mean 'half'.\n\nAsk for a number that multiplies by itself to make the radicand.\n\nFor 144: 12 × 12 = 144.",
        "avatarPersona": "TUTOR"
