    "remedy_1": {
      "id": "remedy_1",
      "type": "CONTENT",
      "content": {
        "text": "A common slip is to choose any factor of 225. A square root needs two equal factors.\n\n15 × 15 = 225, so √225 = 15.\n\nNow use the same reverse-square idea with fresh numbers.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "retry_1"
        }
