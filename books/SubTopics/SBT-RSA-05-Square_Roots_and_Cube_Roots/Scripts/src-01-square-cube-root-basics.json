    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "A product under one square root can be split into easier roots.\n\n√(36 × 25)\n= √36 × √25\n= 6 × 5\n= 30",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "This is the chapter rule √(xy) = √x × √y.\n\nUse it when the pieces have friendly roots; it turns one large-looking root into small mental facts.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
