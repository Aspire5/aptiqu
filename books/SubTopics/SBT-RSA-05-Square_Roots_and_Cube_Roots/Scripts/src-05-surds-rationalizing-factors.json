    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "For two-term denominators, multiply by the conjugate. The conjugate of √5+√2 is √5−√2; their product is 5−2=3 by the difference-of-squares identity. Therefore 1/(√5+√2)=(√5−√2)/3. Keep the signs in the conjugate pair.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
