    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "The chapter also uses quick unit-digit clues. One useful warning is immediate:\n\nA perfect square cannot end in 8.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Another source pattern: if a square ends in 1, the original number must end in 1 or 9.\n\nThese are filters, not full proofs. A permitted last digit does not guarantee that the whole number is a square.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
