    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "To make a number a square by multiplying, repair the odd prime exponents.\n\n294 = 2 × 3 × 7²\n\nThe 2 and 3 are unpaired.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_5_step"
        }
      ]
    },
    "teach_5_step": {
      "id": "teach_5_step",
      "type": "CONTENT",
      "content": {
        "text": "Multiply by 2 × 3 = 6:\n\n294 × 6 = 2² × 3² × 7²\n\nNow every exponent is even, and 6 is the least multiplier because it supplies exactly the missing partners.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_5"
        }
      ]
    },
