    "concept_6": {
      "id": "concept_6",
      "type": "CONTENT",
      "content": {
        "text": "Decimals can also be perfect squares.\n\n0.09 = (0.3)², so it has a rational square root.\n\n0.4 does not have a terminating rational square root in the simple perfect-square form used here.\n\nA quick exact test is to write the decimal as a reduced fraction and see whether numerator and denominator are both perfect squares.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
        }
      ]
    },
