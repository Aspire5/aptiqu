    "concept_4": {
      "id": "concept_4",
      "type": "CONTENT",
      "content": {
        "text": "To make a number a perfect square by multiplication, repair every odd prime exponent.\n\n294 = 2×3×7².\n\nThe exponents of 2 and 3 are odd, so multiply by 2×3=6.\n\nThen every exponent is even.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
