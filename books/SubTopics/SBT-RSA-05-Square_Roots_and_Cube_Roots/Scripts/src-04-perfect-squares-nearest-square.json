    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "Boundary questions ask for the nearest square inside a digit limit.\n\nGreatest four-digit number: 9999.\nThe largest integer whose square stays below it is 99.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "So the greatest four-digit perfect square is:\n\n99² = 9801\n\nFor the least four-digit square, move upward from 1000: 31²=961 is too small, 32²=1024 works.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
