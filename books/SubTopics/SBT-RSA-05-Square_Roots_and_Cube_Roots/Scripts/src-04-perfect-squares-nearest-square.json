    "recap": {
      "id": "recap",
      "type": "CONTENT",
      "content": {
        "text": "Perfect-square questions are about even prime exponents and neighbouring squares.\n\nUse factor parity for multiply/divide repairs.\nUse the previous or next square for least subtraction/addition.\nUse integer roots to count squares in an interval.\nAnd remember: a last-digit rule can eliminate, but it cannot prove by itself.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
