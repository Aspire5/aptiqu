    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "To count perfect squares in an interval, count their integer roots.\n\nBetween 120 and 300:\n11² = 121\n17² = 289",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "So the squares are 11² through 17².\n\nCount the roots, not the squares one by one:\n17 − 11 + 1 = 7 perfect squares.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
