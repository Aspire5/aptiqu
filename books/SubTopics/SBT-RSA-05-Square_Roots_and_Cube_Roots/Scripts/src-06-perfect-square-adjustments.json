    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "For a least addition, find the next square above the number. Since 30²=900 and 31²=961, the least amount to add to 925 is 36. For subtraction, use the lower square. When a number is already square, zero is the least non-negative change unless a positive change is specifically required.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
