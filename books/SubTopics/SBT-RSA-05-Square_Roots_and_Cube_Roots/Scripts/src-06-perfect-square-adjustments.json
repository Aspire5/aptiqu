    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "If several numbers must divide the target square, first take their LCM and then correct its prime exponents. For example, LCM(6,10)=30=2×3×5; multiplying by 30 again gives 900=30², divisible by both inputs.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
