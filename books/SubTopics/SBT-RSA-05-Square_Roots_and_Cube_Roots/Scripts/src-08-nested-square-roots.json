    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Algebra gives candidates, not automatic answers. For x=√(a+x), require x≥0, solve x²−x−a=0, retain the admissible candidate, and substitute it back. This method depends on the expression truly repeating in the stated way.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
