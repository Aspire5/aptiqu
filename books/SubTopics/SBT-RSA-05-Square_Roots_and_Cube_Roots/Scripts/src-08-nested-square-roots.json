    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "An infinite notation alone does not prove convergence. Repeated approximations can support a limit, while the fixed-point equation identifies a compatible value. Use this shortcut only for a regular repeating pattern and always check the non-negative solution in the original relation.",
        "avatarPersona": "TUTOR"
      },
