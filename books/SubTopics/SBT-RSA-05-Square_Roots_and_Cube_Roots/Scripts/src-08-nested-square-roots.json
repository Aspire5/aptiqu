    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "For x=√(6+√(6+...)), the repeating tail has the same value x, so x=√(6+x). Since x is a principal root, x≥0. Squaring gives x²−x−6=0, with candidates 3 and −2; only 3 fits, and √9=3 confirms it.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
