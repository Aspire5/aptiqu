    "concept_3": {
      "id": "concept_3",
      "type": "CONTENT",
      "content": {
        "text": "A denominator like √(n+1)+√n has a very useful reciprocal.\n\n1/(√(n+1)+√n)\n= √(n+1)−√n,\n\nbecause the conjugate product is (n+1)−n=1.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
