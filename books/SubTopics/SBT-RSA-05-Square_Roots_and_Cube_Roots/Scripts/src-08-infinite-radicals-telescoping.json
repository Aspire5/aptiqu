    "recap": {
      "id": "recap",
      "type": "CONTENT",
      "content": {
        "text": "Infinite radicals are solved by self-similarity: call the whole expression x, replace the repeated tail by x, and solve.\n\nKeep the non-negative value that fits the radical.\n\nTelescoping root sums come from rationalising adjacent terms so the middle pieces cancel.",
        "avatarPersona": "TUTOR"
      },
