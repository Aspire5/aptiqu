    "concept_6": {
      "id": "concept_6",
      "type": "CONTENT",
      "content": {
        "text": "Pattern questions are safest when you expose the algebra.\n\nDo not guess an infinite radical from the first few numbers, and do not announce telescoping before you have rewritten the terms into a cancelling form.\n\nSelf-similarity gives an equation; conjugates give cancellation.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
        }
      ]
    },
