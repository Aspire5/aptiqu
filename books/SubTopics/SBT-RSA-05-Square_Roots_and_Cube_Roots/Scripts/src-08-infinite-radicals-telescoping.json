    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Some repeated radicals land on a whole number.\n\nx = √(2 + √(2 + …))\n\nSelf-similarity gives x = √(2+x).",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Square:\nx²−x−2=0\n(x−2)(x+1)=0\n\nA radical is positive, so x=2, not −1.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
