    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "The same rule handles a larger constant.\n\nLet x = √(12 + √(12 + …)).\n\nThen x²−x−12=0.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "Factor:\n(x−4)(x+3)=0\n\nOnly x=4 fits a positive radical.\n\nThe negative root belongs to the algebra, not to the value of the radical.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
