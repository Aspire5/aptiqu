    "concept_2": {
      "id": "concept_2",
      "type": "CONTENT",
      "content": {
        "text": "After solving the quadratic, keep the value that matches the radical.\n\nA square root is non-negative, so a negative algebraic root cannot be the value of the repeated radical.\n\nFor √(6+√(6+...)), the equation factors to (x−3)(x+2)=0. The radical equals 3, not −2.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
