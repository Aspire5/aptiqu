    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "If a decimal has an odd number of places, append a zero without changing its value. For 2.56, √2.56=1.6 since 1.6²=2.56. Likewise, √0.000064=0.008: six decimal places in the radicand become three in the root.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
