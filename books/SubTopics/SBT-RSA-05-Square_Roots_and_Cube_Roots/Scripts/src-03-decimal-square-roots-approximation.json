    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "A non-square root may not terminate. Since 1.73²=2.9929 and 1.74²=3.0276, √3 lies between 1.73 and 1.74; to three decimal places √3≈1.732. Use ≈ for a rounded display, because 1.732² is close to 3 but not equal to it.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
