    "concept_6": {
      "id": "concept_6",
      "type": "CONTENT",
      "content": {
        "text": "A useful identity inside radicals is (a+b)(a−b)=a²−b².\n\nExample: √[(7+3√5)(7−3√5)]\n= √(49−45)\n= √4\n= 2.\n\nConjugate factors can turn a messy radical into a simple square.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
        }
      ]
    },
