    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "Products and quotients can simplify before any decimal work.\n\n√(24×6) = √144 = 12\n\nOr split first: √24×√6 = 2√6×√6 = 12.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
