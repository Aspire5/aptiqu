    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Once surds are simplified, like surds combine just like like terms.\n\n√12 + √27\n= 2√3 + 3√3",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Now the root parts match, so add the coefficients:\n\n2√3 + 3√3 = 5√3\n\nIf the root parts are different, do not combine them yet.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
