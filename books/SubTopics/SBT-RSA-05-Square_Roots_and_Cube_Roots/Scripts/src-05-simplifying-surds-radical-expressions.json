      "type": "CONTENT",
      "content": {
        "text": "Coefficients outside the root join the same way.\n\n2√27 − √12\n= 2(3√3) − 2√3",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
