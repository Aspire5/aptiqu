    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "Given an approximate root, first rewrite every radical as a multiple of that same root.\n\n√192 = 8√3\n√48 = 4√3\n√75 = 5√3",
        "avatarPersona": "TUTOR"
