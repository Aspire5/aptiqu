    "recap": {
      "id": "recap",
      "type": "CONTENT",
      "content": {
        "text": "Simplify a radical before doing anything complicated.\n\nPull out perfect-square factors, combine only like surds, and work from the deepest root outward.\n\nFor products, use √a√b=√(ab).\n\nFor conjugate factors, use the difference-of-squares identity.",
        "avatarPersona": "TUTOR"
      },
