    "teach_6_step": {
      "id": "teach_6_step",
      "type": "CONTENT",
      "content": {
        "text": "So the chapter expression\n√192 − ½√48 − √75\nbecomes:\n\n8√3 − 2√3 − 5√3 = √3\n\nIf √3 ≈ 1.732, the whole expression is ≈ 1.732.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
        }
      ]
