      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "The same rule works for a quotient.\n\n√(72/2) = √36 = 6\n\nLook for a perfect-square result before expanding anything.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
