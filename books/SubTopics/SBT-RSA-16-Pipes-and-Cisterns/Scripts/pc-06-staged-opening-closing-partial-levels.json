    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Sometimes the total finish time is fixed and you must find when one pipe was closed.\n\nA fills in 24 min and B in 32 min. The tank must be full in 18 min. Let B run for x min; A runs all 18.",
        "avatarPersona": "TUTOR"
