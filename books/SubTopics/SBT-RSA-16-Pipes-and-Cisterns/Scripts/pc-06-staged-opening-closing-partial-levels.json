    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "An outlet may be active only during the early stage.\n\nA fills in 6 h, B in 12 h, C empties in 8 h. C is closed 2 h before the tank becomes full. Let total time be t.",
        "avatarPersona": "TUTOR"
