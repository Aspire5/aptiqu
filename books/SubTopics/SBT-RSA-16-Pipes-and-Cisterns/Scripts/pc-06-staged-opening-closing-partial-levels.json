    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "A pipe question changes completely when one pipe opens late or closes early.\n\nThe tank does not restart at that moment.\n\nWhatever water has already entered stays in the story. So we split the process into stages and carry the water level forward.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "A fills in 12 min and B in 18 min. Both run for 3 min, then A closes.\n\nTogether rate = 5/36 tank/min. In 3 min they fill 15/36 = 5/12.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "Remaining = 7/12.\nB alone fills at 1/18, so additional time = 7/12 × 18 = 10.5 min.\nThe first 3 minutes are already finished; do not count them again.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
