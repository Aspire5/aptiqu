    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "A and B run t hours; C runs t−2.\nt/6 + t/12 − (t−2)/8 = 1.\nMultiply by 24: 4t+2t−3t+6=24 → t=6 h.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
