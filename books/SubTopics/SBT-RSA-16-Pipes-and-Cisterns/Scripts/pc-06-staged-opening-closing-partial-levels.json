    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "A contributes 18/24 = 3/4.\nSo B must supply the remaining 1/4.\nx/32 = 1/4 → x = 8 min.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
