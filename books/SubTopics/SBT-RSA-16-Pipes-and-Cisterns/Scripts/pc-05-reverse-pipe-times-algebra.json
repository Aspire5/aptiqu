{
  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "So far the pipe times were given.\n\nNow the question may give only the together-time and a clue such as 'B takes 5 hours longer than A.'\n\nThe safe move is to name the unknown time, turn it into a reciprocal rate, and let the rates add.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "If A fills in 12 h and A+B together fill in 8 h, B's rate is the missing part:\n1/8 − 1/12 = 1/24.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "So B alone takes 24 h.\nThis is the simplest reverse pipe problem: combined rate minus known rate.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
    "q_1": {
      "id": "q_1",
      "type": "CHOICE",
      "content": {
        "text": "A fills in 10 h. A and B together fill in 6 h. How long does B alone take?",
