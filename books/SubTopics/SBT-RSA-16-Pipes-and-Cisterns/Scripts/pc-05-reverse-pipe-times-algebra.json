    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Now suppose B takes 5 hours longer than A, and together they fill in 6 hours.\nLet A take x hours; B takes x+5.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Rate equation:\n1/x + 1/(x+5) = 1/6.\nThis becomes x² − 7x − 30 = 0 = (x−10)(x+3).\nTime cannot be negative, so A=10 h and B=15 h.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
