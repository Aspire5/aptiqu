    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "Pairwise rates can reveal the all-pipe rate.\n\nIf A+B, B+C and A+C rates are known, add them. Each individual pipe appears twice.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_5_step"
        }
      ]
    },
    "teach_5_step": {
      "id": "teach_5_step",
      "type": "CONTENT",
      "content": {
        "text": "So 2(A+B+C) = (A+B)+(B+C)+(A+C).\nAll-three rate is half the sum of the three pair rates.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_5"
        }
      ]
    },
