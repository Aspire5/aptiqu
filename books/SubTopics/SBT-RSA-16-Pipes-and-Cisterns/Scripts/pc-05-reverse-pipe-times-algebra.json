    "teach_8": {
      "id": "teach_8",
      "type": "CONTENT",
      "content": {
        "text": "Capstone: reverse problems become manageable when every clue is translated into rate language before algebra begins.\n\n'Together in 4 h' means rates sum to 1/4.\n'6 h longer' means times differ by 6.\n'Twice as fast' means rates differ by a factor of 2.",
        "avatarPersona": "TUTOR"
