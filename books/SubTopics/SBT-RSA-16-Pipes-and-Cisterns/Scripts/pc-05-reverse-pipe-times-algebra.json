    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "Sometimes the unknown is a flow capacity rather than a time.\n\nA 2400 m³ tank is filled at x m³/min and emptied at x+10 m³/min. Emptying takes 8 min less than filling.",
