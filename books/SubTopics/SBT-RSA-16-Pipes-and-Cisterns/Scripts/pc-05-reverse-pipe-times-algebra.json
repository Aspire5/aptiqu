    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "'Three times as fast' is a rate ratio, not a time ratio.\n\nIf fast:slow rates = 3:1, together = 4 parts. If together time is 36 min, one rate-part is 1/144 tank/min.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
