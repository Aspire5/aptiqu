    "teach_7": {
      "id": "teach_7",
      "type": "CONTENT",
      "content": {
        "text": "Three-statement questions may contain a direct answer among indirect clues.\n\nIf the question asks for capacity and one statement directly gives capacity, that statement is sufficient by itself even if other flow-rate statements could also be combined.",
        "avatarPersona": "TUTOR"
