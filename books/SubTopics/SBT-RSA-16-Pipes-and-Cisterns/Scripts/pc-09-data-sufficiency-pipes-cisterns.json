    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Sometimes either statement independently determines the answer.\n\nQuestion: A+B together fill in 6 h. How long does A alone take?\nI. B takes 5 h longer than A.\nII. A:B time ratio is 2:3.",
        "avatarPersona": "TUTOR"
