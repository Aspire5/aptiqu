        "avatarPersona": "TUTOR"
      },
      "input": {
        "type": "CHOICE",
        "options": [
          {
            "id": "a",
            "label": "I alone"
          },
          {
            "id": "b",
            "label": "II alone"
          },
          {
            "id": "c",
            "label": "Neither even together"
          },
          {
            "id": "d",
            "label": "Both together only"
          }
        ]
      },
      "questionReference": {
