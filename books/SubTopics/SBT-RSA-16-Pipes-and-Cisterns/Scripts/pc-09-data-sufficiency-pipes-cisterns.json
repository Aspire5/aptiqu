    "teach_8": {
      "id": "teach_8",
      "type": "CONTENT",
      "content": {
        "text": "Capstone: the fastest DS check is to name the unknown rate information.\n\nIf the question asks a together-time, you need enough to determine the component rates. If it asks capacity from L/min flows, you need a net flow and a duration. Extra litres or percentages may be decoration.",
        "avatarPersona": "TUTOR"
