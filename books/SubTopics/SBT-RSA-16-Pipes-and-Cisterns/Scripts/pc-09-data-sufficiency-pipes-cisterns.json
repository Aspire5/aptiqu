    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "Equivalent statements do not create extra information.\n\nI. Nikita's pipe is 150% as fast as Shalini's.\nII. Shalini's pipe is two-thirds as fast as Nikita's.\nThese are the same rate ratio written two ways.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_6_step"
        }
      ]
    },
    "teach_6_step": {
      "id": "teach_6_step",
      "type": "CONTENT",
      "content": {
        "text": "If either one, together with the question stem, is enough to answer, then the other is redundant. Data Sufficiency tests independence, not word count.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
        }
      ]
    },
