    "teach_8_step": {
      "id": "teach_8_step",
      "type": "CONTENT",
      "content": {
        "text": "Do only enough arithmetic to prove uniqueness. Once the answer is fixed, stop. That is the skill Data Sufficiency is testing.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_8"
        }
      ]
