    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "Staggered starts can be solved without cycles if each pipe opens once and then stays open.\n\nPipes fill in 10, 15 and 20 h. The first starts now, second after x h, third after 2x h. The tank is full 5 h after the first starts.",
        "avatarPersona": "TUTOR"
