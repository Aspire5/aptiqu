      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Alternating pipes look messy only if you track every hour one by one.\n\nInstead, bundle one full repeat into a cycle.\n\nFind what one cycle does. Repeat that safely. Then handle the final leftover part in the exact turn order.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "A fills in 6 h and B in 4 h. They open alternately for 1 h each, A first.\n\nOne 2-hour cycle fills 1/6 + 1/4 = 5/12.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "Two full cycles fill 10/12 = 5/6 in 4 h. A goes next and fills the remaining 1/6 in exactly 1 h.\nTotal = 5 h.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
