    "teach_5_step": {
      "id": "teach_5_step",
      "type": "CONTENT",
      "content": {
        "text": "5/10 +(5−x)/15 +(5−2x)/20 = 1.\nMultiply by 60:\n30 + 20−4x +15−6x =60\n5 =10x → x=0.5 h = 30 min.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
