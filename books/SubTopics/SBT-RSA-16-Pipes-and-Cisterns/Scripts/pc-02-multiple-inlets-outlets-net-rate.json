    "teach_7": {
      "id": "teach_7",
      "type": "CONTENT",
      "content": {
        "text": "Sometimes pipes are given in litres per minute instead of tank fractions.\n\nIf a tank holds T litres, an inlet adds x L/min and an outlet removes y L/min, then net flow is x−y L/min.\nFill time = T/(x−y), provided x>y.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_7_step"
        }
      ]
    },
