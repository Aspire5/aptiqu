    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "Pairwise information can reveal another pair without solving every pipe separately.\n\nLet rates be a, b, c.\nIf a+b+c = S, b+c = U, and a+c = V, then\na+b = 2S − U − V.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_6_step"
        }
      ]
    },
    "teach_6_step": {
      "id": "teach_6_step",
      "type": "CONTENT",
      "content": {
        "text": "Why?\n2(a+b+c) − (b+c) − (a+c) leaves exactly a+b.\nThis is a fast rate identity, not a new pipe formula.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
        }
      ]
    },
