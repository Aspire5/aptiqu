    "teach_8": {
      "id": "teach_8",
      "type": "CONTENT",
      "content": {
        "text": "Capstone: a system of pipes is one signed sum.\n\nFor four pipes, you do not need four separate tricks. Convert each to a rate, attach + or −, add, then invert the net rate if a whole tank must change.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
