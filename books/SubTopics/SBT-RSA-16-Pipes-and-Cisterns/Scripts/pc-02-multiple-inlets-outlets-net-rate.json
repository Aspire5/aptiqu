    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "When several inlets carry different liquids, their shares are proportional to their rates.\n\nP, Q, R fill alone in 30, 20, 10 min. Their rates are 1/30 : 1/20 : 1/10 = 2 : 3 : 6.\nSo R contributes 6/11 of whatever mixture has entered.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_5_step"
