    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Add inlets, subtract outlets.\n\nA fills in 8 hours and B fills in 12 hours. C empties in 24 hours.\nNet rate = 1/8 + 1/12 − 1/24 = 1/6.\nSo the tank fills in 6 hours.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "The sign is part of the story. A waste pipe simply contributes a negative rate.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
