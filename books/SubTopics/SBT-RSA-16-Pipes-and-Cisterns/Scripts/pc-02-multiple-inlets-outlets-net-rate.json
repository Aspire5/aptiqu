    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Now more than one pipe is open.\n\nDo not combine their times. Combine their rates.\n\nA pipe filling in 6 hours adds 1/6 tank each hour. Another filling in 3 hours adds 1/3. Together they add 1/2 tank per hour, so the tank fills in 2 hours.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "Two inlets work together by adding rates.\n\nA fills in 12 hours: 1/12 per hour.\nB fills in 18 hours: 1/18 per hour.\nTogether: 1/12 + 1/18 = 5/36.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "If 5/36 of the tank is filled each hour, the whole tank takes 36/5 = 7.2 hours.\n\nThe combined time must be less than 12 hours, the faster individual pipe.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
