    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Sometimes the outlet wins.\n\nAn inlet fills in 10 hours, but an outlet empties in 6 hours.\nNet rate = 1/10 − 1/6 = −1/15.\nThe negative sign means the water level falls at 1/15 tank per hour.",
        "avatarPersona": "TUTOR"
