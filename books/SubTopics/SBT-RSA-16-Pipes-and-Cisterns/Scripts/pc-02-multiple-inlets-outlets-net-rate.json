          "targetNodeId": "teach_8_step"
        }
      ]
    },
    "teach_8_step": {
      "id": "teach_8_step",
      "type": "CONTENT",
      "content": {
        "text": "Direction is your safety check. If the final rate is positive, the water rises. If it is negative, the water falls. If it is zero, the level never changes.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_8"
        }
      ]
    },
