    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Efficiency can form a chain.\n\nC is twice B, and B is twice A. If A's rate is r, then B=2r and C=4r. Together = 7r.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
