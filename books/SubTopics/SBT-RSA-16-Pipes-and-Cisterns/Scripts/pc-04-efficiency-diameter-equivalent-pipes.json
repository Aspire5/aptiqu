    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "If all three together fill in 5 h, 7r = 1/5, so r = 1/35.\nA alone takes 35 h, B 17.5 h, C 8.75 h.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
