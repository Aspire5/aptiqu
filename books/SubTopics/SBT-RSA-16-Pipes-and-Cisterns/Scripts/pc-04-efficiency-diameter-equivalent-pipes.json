{
  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Two pipes may not be described by their times at all.\n\nYou may be told that one pipe is twice as efficient as another.\n\nEfficiency is really rate. Twice the efficiency means twice the water per hour — and therefore half the time for one full tank.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "If A is twice as efficient as B, A's rate is 2r while B's rate is r.\n\nSo if B needs 18 hours, A needs only 9 hours.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "Efficiency and time move opposite ways:\nrate doubles → time halves.\nrate triples → time becomes one-third.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
    "q_1": {
