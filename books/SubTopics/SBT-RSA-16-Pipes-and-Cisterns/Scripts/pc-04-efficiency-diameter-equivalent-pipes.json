      "type": "CONTENT",
      "content": {
        "text": "If P alone needs 60 trips, the drum holds 60×3 = 180 small-capacity parts. P+Q move 4 parts per paired trip, so they need 45 trips.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_8"
        }
