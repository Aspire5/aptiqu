    "teach_8": {
      "id": "teach_8",
      "type": "CONTENT",
      "content": {
        "text": "Buckets follow the same rate idea. A larger bucket is like a faster pipe.\n\nIf bucket P has three times Q's capacity, their rates per trip are 3 parts and 1 part. Together each paired trip moves 4 parts.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
