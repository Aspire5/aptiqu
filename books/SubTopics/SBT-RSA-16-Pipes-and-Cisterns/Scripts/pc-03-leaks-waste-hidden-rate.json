    "teach_8": {
      "id": "teach_8",
      "type": "CONTENT",
      "content": {
        "text": "Capstone: leak questions are difference-of-rates questions.\n\nKnown system rate − observed net rate = hidden loss rate.\nOr, if the tank is draining, observed drain rate − known inlet rate can reveal the hidden outlet.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_8_step"
        }
      ]
    },
    "teach_8_step": {
      "id": "teach_8_step",
      "type": "CONTENT",
      "content": {
        "text": "Do not compare the times by subtraction. A 4-hour pipe and a 5-hour observed fill do not imply a 1-hour leak. Convert both to rates first.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_8"
        }
      ]
    },
