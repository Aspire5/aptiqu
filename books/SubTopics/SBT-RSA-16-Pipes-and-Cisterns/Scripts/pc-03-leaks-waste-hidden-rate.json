    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "A waste pipe can be found when two inlets and the combined time are known.\n\nInlets fill in 12 h and 18 h, so together they add 5/36 per hour. If all pipes together fill in 9 h, net rate is 1/9 = 4/36.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "The missing 1/36 must be leaving through the waste pipe.\nSo the waste pipe alone empties the tank in 36 hours.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
