    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Suppose that same 6-hour pipe runs for only 4 hours.\n\nFilled = 4 × 1/6 = 2/3.\n\nA pipe rate tells you exactly how much of the tank changes over any time interval.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Use:\namount changed = rate × time.\n\nIf you know the amount and rate instead, turn it around:\ntime = amount ÷ rate.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
