{
  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Let's make pipe questions feel small.\n\nPretend the whole tank is exactly 1.\n\nIf one pipe fills it in 5 hours, then every hour that pipe adds 1/5 of the tank. Once that idea is clear, most pipe questions become simple fraction work.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "A pipe fills a tank in 6 hours. Think of the tank as six equal slices.\n\nEach hour the pipe adds one slice, so its rate is 1/6 tank per hour.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "Time and rate are reciprocals:\n\n6 hours for 1 tank → 1/6 tank each hour.\n\nIf the pipe runs for 3 hours, it fills 3 × 1/6 = 1/2 of the tank.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
    "q_1": {
      "id": "q_1",
      "type": "CHOICE",
      "content": {
        "text": "A pipe fills a tank in 8 hours. What fraction does it fill in 1 hour?",
        "avatarPersona": "TUTOR"
      },
      "input": {
        "type": "CHOICE",
        "options": [
          {
            "id": "a",
            "label": "8"
          },
          {
            "id": "b",
            "label": "1/4"
          },
          {
            "id": "c",
            "label": "1/16"
          },
          {
            "id": "d",
            "label": "1/8"
          }
        ]
      },
      "questionReference": {
