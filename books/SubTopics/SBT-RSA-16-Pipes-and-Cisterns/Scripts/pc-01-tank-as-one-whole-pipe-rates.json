    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Now start with a partly filled tank.\n\nA tank is already 3/5 full. Only 2/5 is missing.\nIf a pipe fills 1/10 tank per hour, time needed is\n(2/5) ÷ (1/10) = 4 hours.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "The common trap is to use the whole tank time even when the whole tank is not empty.\n\nAlways ask first: what fraction still needs to change?",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
