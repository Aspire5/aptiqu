    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "Outlets use the same fraction idea, but water leaves the tank.\n\nIf an outlet empties a full tank in 8 hours, its rate is −1/8 tank per hour.\n\nTo empty only half the tank, it needs 1/2 ÷ 1/8 = 4 hours.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "The minus sign tells direction. For a time question, use the size of the rate after you have decided whether the tank is filling or emptying.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
