    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "Sometimes the rate is given directly in litres.\n\nA 600-litre tank receives 25 litres each minute.\nTime = 600 ÷ 25 = 24 minutes.\n\nThis is the same model: amount ÷ rate.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_5_step"
        }
      ]
    },
    "teach_5_step": {
      "id": "teach_5_step",
      "type": "CONTENT",
      "content": {
        "text": "Fraction rates and litre rates are two versions of the same idea.\n\n1 tank ÷ tanks/hour\nor\nlitres ÷ litres/minute.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_5"
        }
      ]
    },
