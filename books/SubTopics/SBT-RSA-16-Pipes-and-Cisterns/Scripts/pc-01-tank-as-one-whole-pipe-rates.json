    "remedy_1": {
      "id": "remedy_1",
      "type": "CONTENT",
      "content": {
        "text": "Let's check the exact rate idea.\n\nTake the reciprocal of the full-tank time.\n\nThe rate is 1 ÷ 8 = 1/8 tank per hour.\n\nNow use the same relationship with fresh values.",
