    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "A ratio can feed a later distance calculation.\n\nStill-water speed = 5 × current.\nIf 13.2 km downstream takes 1.1 h, downstream speed = 12 km/hr.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_5_step"
        }
      ]
    },
    "teach_5_step": {
      "id": "teach_5_step",
      "type": "CONTENT",
      "content": {
        "text": "But downstream = 6 × current.\nSo current = 2 and upstream = 8 km/hr.\n\nIn 312 minutes = 5.2 h, upstream distance = 8×5.2 = 41.6 km.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_5"
        }
      ]
    },
