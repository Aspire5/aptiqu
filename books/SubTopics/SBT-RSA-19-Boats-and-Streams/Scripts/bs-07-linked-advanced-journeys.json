    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Three equally spaced towns can hide a speed ratio.\n\nP, Q, R lie downstream in that order with PQ=QR=x.\nP→R downstream takes 4 h, so 2x/a=4 and x=2a.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "If P→Q→P takes 10 h:\nx/a + x/b = 10\n2 + 2a/b = 10\na/b = 4.\n\nSo still water : current = (4+1):(4−1) = 5:3.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
