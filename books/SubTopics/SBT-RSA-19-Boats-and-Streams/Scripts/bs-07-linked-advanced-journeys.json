    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "A tougher source pattern changes the boat's own rowing rate.\n\nAt the usual rate, a 12-mile upstream trip takes 6 hours longer than the same downstream trip. If the rowing rate were doubled, the time gap would shrink to 1 hour.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_6_step"
        }
      ]
    },
    "teach_6_step": {
      "id": "teach_6_step",
      "type": "CONTENT",
      "content": {
        "text": "Let still-water speed=u and current=v.\nUsual gap: 12/(u−v) − 12/(u+v) = 6, so u²−v² = 4v.\nDoubled rowing rate: 12/(2u−v) − 12/(2u+v) = 1, so 4u²−v² = 24v.\nSubstitute the first into the second: 3v² = 8v, hence v = 8/3 mph.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
        }
      ]
    },
