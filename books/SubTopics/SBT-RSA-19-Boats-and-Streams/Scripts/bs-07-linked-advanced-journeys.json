    "teach_7": {
      "id": "teach_7",
      "type": "CONTENT",
      "content": {
        "text": "Same-time distance conditions are often faster than full time equations.\n\nA boat in still water moves at 10 km/hr. It covers 26 km downstream in the same time as 14 km upstream.",
        "avatarPersona": "TUTOR"
