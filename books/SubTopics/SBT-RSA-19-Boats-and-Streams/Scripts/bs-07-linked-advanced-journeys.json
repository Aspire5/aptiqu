    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "Two boats on one river share the same current.\n\nBoat B still water = 10 km/hr. Boat A still-water speed equals B's upstream speed.\nIf B upstream = 8, the current is 2 and A still water = 8.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "Notice a neat cancellation: A downstream speed = (10−s)+s = 10 km/hr.\nSo A can travel downstream at B's still-water speed, even though A itself is slower in still water.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
