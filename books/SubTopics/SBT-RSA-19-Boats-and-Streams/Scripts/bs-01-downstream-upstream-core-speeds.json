    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "A useful check: downstream must be faster than upstream.\n\nIf the two observed speeds are 8 and 4 km/hr, the midpoint is 6 and the half-gap is 2.\n\nSo the boat moves at 6 km/hr in still water and the current is 2 km/hr.",
        "avatarPersona": "TUTOR"
