    "teach_5_step": {
      "id": "teach_5_step",
      "type": "CONTENT",
      "content": {
        "text": "Keep the roles separate:\n\nstill water is the middle value,\ndownstream is above it by v,\nupstream is below it by v.\n\nSo still water is always the midpoint of the two river speeds.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
