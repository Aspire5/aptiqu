    "teach_6_step": {
      "id": "teach_6_step",
      "type": "CONTENT",
      "content": {
        "text": "The current is never the full gap between downstream and upstream.\n\nWhy?\nDownstream contains +v and upstream contains −v.\nThe gap is therefore 2v.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
        }
      ]
    },
