    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Sometimes the speeds are hidden inside journeys.\n\nA boat covers 24 km downstream in 2 hours: 24 ÷ 2 = 12 km/hr.\nIt covers 8 km upstream in 1 hour: 8 ÷ 1 = 8 km/hr.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "Now the river part is visible:\n\nCurrent = (12 − 8) ÷ 2 = 2 km/hr.\n\nAlways turn each distance-time pair into a speed first. Then use half-sum or half-difference.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
