    "teach_7": {
      "id": "teach_7",
      "type": "CONTENT",
      "content": {
        "text": "Watch how units can hide the same idea.\n\nA boat covers 1 km downstream in 5 minutes. That is 12 km/hr.\nIt covers 6 km upstream in 1 hour. That is 6 km/hr.",
