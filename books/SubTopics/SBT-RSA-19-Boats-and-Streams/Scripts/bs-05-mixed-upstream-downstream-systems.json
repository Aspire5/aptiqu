    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "After solving a system, always translate back to the two physical speeds.\n\nIf p=1/5 and q=1/11, then U=5 and D=11 — not 1/5 and 1/11 km/hr.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
