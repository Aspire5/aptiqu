    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "Then:\nStill water = (11+5)/2 = 8\nCurrent = (11−5)/2 = 3 km/hr.\n\nThis reciprocal-to-speed step is an easy place to lose the meaning of the variables.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
