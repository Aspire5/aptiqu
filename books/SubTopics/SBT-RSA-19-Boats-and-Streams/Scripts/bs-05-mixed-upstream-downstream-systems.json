    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "Now link three towns. P, Q and R lie on the same river, with PQ = QR = x.\n\nP→Q and back takes 10 h. P→R downstream takes 4 h.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_5_step"
        }
      ]
    },
    "teach_5_step": {
      "id": "teach_5_step",
      "type": "CONTENT",
      "content": {
        "text": "Let downstream speed=a, upstream=b.\nP→R is 2x, so 2x/a=4 ⇒ x=2a.\nRound trip P↔Q:\nx/a + x/b = 10\n2 + 2a/b = 10 ⇒ a/b=4.\nStill water : current = (4+1):(4−1)=5:3.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_5"
        }
      ]
    },
