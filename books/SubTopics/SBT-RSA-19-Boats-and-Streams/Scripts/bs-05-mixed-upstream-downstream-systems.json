    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "Two boats can share the same current.\n\nBoat B moves at 10 km/hr in still water. Boat A's still-water speed equals B's upstream speed.\nBoat A travels 20 km downstream in 2 h.",
        "avatarPersona": "TUTOR"
