      "id": "teach_6_step",
      "type": "CONTENT",
      "content": {
        "text": "Boat A downstream speed = 10 km/hr.\nBut A still water = 10−s, so A downstream = (10−s)+s = 10.\nNow if B travels 40 km upstream in 5 h, B upstream = 8, so current s=2 and A still water=8 km/hr.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
        }
      ]
    },
