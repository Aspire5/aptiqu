    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Let's see a clean elimination.\n\n20/U + 30/D = 7\n15/U + 20/D = 5.\n\nUse p=1/U and q=1/D.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "That becomes:\n20p + 30q = 7\n15p + 20q = 5.\n\nEliminate one variable in the usual way. The solution is p=1/5 and q=1/10.\nSo U=5 and D=10 km/hr.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
