    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "The same relation can find the width.\n\nA swimmer moves across at 6 km/hr and takes 20 minutes.\n20 minutes = 1/3 hour.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
