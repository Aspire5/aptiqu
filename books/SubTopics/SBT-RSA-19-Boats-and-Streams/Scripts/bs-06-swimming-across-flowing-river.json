    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "Now change the goal: land directly opposite.\n\nIn still water, crossing a 100 m river takes 4 minutes, so swimming speed = 25 m/min.\nWith current, the directly-opposite crossing takes 5 minutes, so the across component is 20 m/min.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "The swimmer aims upstream so one component cancels the current. The speeds form a right triangle:\n\n25² = 20² + current²\ncurrent² = 225\ncurrent = 15 m/min.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
