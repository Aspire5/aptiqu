      "type": "CONTENT",
      "content": {
        "text": "Downstream : upstream speed\n= upstream time : downstream time\n= (44/5) : 4\n= 11 : 5.\n\nStill water : current = (11+5):(11−5) = 16:6 = 8:3.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
