    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Suppose downstream : upstream speed = 2 : 1.\n\nCall them 2x and x.\nStill water is their midpoint: 3x/2.\nCurrent is half their gap: x/2.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "So still water : current\n= (3x/2) : (x/2)\n= 3 : 1.\n\nThis half-sum / half-difference trick works for any downstream:upstream ratio.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
