      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "Let the speeds be 4x and 3x. Their difference is x, but downstream − upstream = 2 × current.\n\nIf current = 4 km/hr, x = 8.\nStill water = (4x + 3x)/2 = 28 km/hr.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
