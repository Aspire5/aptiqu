    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "Ratios can also give the return time directly.\n\nBoat : current = 36 : 5.\nDownstream speed = 41 parts; upstream = 31 parts.\n\nFor the same distance, upstream time / downstream time = 41/31.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
