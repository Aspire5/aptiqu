    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "Same time means distance follows speed directly.\n\nSuppose in one hour a swimmer goes twice as far downstream as upstream.\nThen downstream : upstream speed = 2 : 1.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
