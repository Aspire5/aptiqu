    "teach_7": {
      "id": "teach_7",
      "type": "CONTENT",
      "content": {
        "text": "A useful equal-time equation comes straight from distance ÷ speed.\n\nA boat moves at 10 km/hr in still water. It covers 26 km downstream in the same time as 14 km upstream.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_7_step"
        }
      ]
    },
    "teach_7_step": {
      "id": "teach_7_step",
      "type": "CONTENT",
      "content": {
        "text": "Let current = v. Equal times give:\n\n26/(10+v) = 14/(10−v)\n26(10−v) = 14(10+v)\n120 = 40v\nv = 3 km/hr.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_7"
        }
      ]
    },
