    "teach_8": {
      "id": "teach_8",
      "type": "CONTENT",
      "content": {
        "text": "Long time ratios can look ugly but simplify cleanly.\n\nSuppose the same distance takes 8 h 48 min upstream and 4 h downstream.\n8 h 48 min = 8.8 h = 44/5 h.",
        "avatarPersona": "TUTOR"
      },
