      "id": "teach_5_step",
      "type": "CONTENT",
      "content": {
        "text": "If the downstream trip takes 5 h 10 min = 31/6 h:\n\nUpstream time = (31/6) × (41/31)\n= 41/6 h\n= 6 h 50 min.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_5"
        }
      ]
    },
