    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "Upstream speed = 56/1.75 = 32 km/hr.\nSo current = 36−32 = 4 km/hr.\nDownstream speed = 40 km/hr.\n\nThe same 56 km downstream takes 56/40 = 1.4 h = 1 h 24 min.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
