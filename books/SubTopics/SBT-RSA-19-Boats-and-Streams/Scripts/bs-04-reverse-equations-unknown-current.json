    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "A different wording gives a time multiple instead of a difference.\n\nA man rows at 6 km/hr in still water. Upstream takes twice as long as downstream for the same distance.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Twice the time means half the speed:\n\nDownstream : upstream = 2 : 1.\nLet upstream = x and downstream = 2x.\nTheir midpoint is 6, so 3x/2 = 6 and x=4.\nCurrent = (8−4)/2 = 2 km/hr.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
