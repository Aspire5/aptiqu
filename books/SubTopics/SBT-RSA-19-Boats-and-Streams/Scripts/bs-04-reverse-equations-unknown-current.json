    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "A round-trip total can hide the boat speed instead of the current.\n\nCurrent = 1 km/hr. One-way distance = 48 km. Total time = 14 hours.",
