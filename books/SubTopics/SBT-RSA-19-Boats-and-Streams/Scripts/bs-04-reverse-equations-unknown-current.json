    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Equal times create a different equation.\n\nStill-water speed = 10 km/hr.\n26 km downstream takes the same time as 14 km upstream.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "Let current = v:\n26/(10+v) = 14/(10−v).\n\n26(10−v) = 14(10+v)\n120 = 40v\nv = 3 km/hr.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
