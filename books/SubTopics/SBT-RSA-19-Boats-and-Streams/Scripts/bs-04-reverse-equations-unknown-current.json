    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "Sometimes one river leg reveals the current before you touch the other leg.\n\nStill-water speed = 36 km/hr.\n56 km upstream takes 1 h 45 min = 1.75 h.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
