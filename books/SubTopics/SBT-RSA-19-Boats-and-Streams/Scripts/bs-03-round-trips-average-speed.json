    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "A chapter example uses 7.5 km/hr in still water and 1.5 km/hr current.\n\nSo downstream = 9 and upstream = 6 km/hr.\nThe full out-and-back time is 50 minutes = 5/6 hour.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Let one-way distance be x:\n\nx/9 + x/6 = 5/6\n(2x + 3x)/18 = 5/6\n5x/18 = 5/6\nx = 3 km.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
