    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Average speed is not the simple average of downstream and upstream speeds.\n\nIf the two equal-distance speeds are 60 and 40 km/hr, the slow leg lasts longer.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "Use total distance ÷ total time. For equal distances, this becomes:\n\nAverage = 2xy/(x+y)\n= 2×60×40/100\n= 48 km/hr.\n\nNot 50.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
