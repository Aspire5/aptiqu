    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "Equal profit can come from unequal money and unequal time.\n\nA: ₹4,000 for 12 months → 48,000 points.\nB: ₹6,000 for 8 months → 48,000 points.\n\nSame capital-time product means same profit.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
