    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "With three partners, keep one common finish line.\n\nA starts now with ₹4,000. B joins after 3 months with ₹6,000. C joins after 6 months with ₹8,000.\n\nMonths: 12, 9, 6.\nWeights: 48,000 : 54,000 : 48,000 = 8 : 9 : 8.",
