    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "A fast check: the later someone joins, the larger the capital must be to catch up.\n\nHere C invests twice A's money but only half A's time, so their weights are equal.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
