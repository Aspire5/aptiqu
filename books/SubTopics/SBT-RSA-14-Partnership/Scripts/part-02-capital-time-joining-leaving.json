    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Leaving early is the mirror image.\n\nA invests ₹7,000 but leaves after 8 months. B invests ₹4,000 for all 12 months.\n\nWeights: 7000×8 : 4000×12 = 56 : 48 = 7 : 6.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "For someone who leaves after x months, use x months directly.\n\nFor someone who joins after x months, use total − x.\n\nSame timeline, opposite reading.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
