    "remedy_1": {
      "id": "remedy_1",
      "type": "CONTENT",
      "content": {
        "text": "Let’s unpack the exact clue.\n\nThe capitals cancel because they are equal.\n\n9000×10 : 9000×6 = 10 : 6 = 5 : 3.\n\nNow use the same idea on fresh numbers.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "retry_1"
        }
      ]
    },
