{
  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "In a compound partnership, money is only half the story.\n\n₹10,000 kept in for 12 months has more earning power than ₹10,000 kept in for 4 months.\n\nThe clean mental model is one number: capital × time.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "A and B both invest ₹6,000, but A stays 12 months and B stays 8.\n\nTheir capital is equal, so time decides the ratio:\n6000 × 12 : 6000 × 8 = 12 : 8 = 3 : 2.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "Think of one rupee for one month as one earning point.\n\nA earns 72,000 capital-month points; B earns 48,000.\nProfit follows those points, not the starting money alone.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
    "q_1": {
      "id": "q_1",
      "type": "CHOICE",
      "content": {
        "text": "A and B each invest ₹9,000. A stays 10 months and B stays 6 months. What is their profit ratio?",
        "avatarPersona": "TUTOR"
      },
      "input": {
        "type": "CHOICE",
        "options": [
          {
            "id": "a",
            "label": "3 : 5"
          },
          {
            "id": "b",
            "label": "10 : 9"
          },
          {
            "id": "c",
            "label": "1 : 1"
          },
          {
            "id": "d",
            "label": "5 : 3"
          }
        ]
      },
      "questionReference": {
