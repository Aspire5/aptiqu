    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Now one partner joins late.\n\nA starts with ₹5,000 for the full 12 months. B joins after 4 months with ₹8,000.\n\nB is present for 12 − 4 = 8 months.\nWeights: 5000×12 : 8000×8 = 60 : 64 = 15 : 16.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "The phrase 'after 4 months' gives the waiting time, not the investment time.\n\nIn a one-year business:\nmonths invested = 12 − joining month.\n\nThat translation is the main trap.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
