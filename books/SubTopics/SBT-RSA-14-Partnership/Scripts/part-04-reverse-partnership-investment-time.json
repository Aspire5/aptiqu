    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "A profit difference can become an equation.\n\nSuppose A:B weight ratio is 7:5 and A receives ₹1,200 more.\nThe difference is 2 ratio-parts, so 2 parts = ₹1,200.\nOne part = ₹600.\nTotal profit = 12 parts = ₹7,200.",
        "avatarPersona": "TUTOR"
