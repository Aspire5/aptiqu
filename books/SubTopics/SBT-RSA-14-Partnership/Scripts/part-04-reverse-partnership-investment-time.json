          "targetNodeId": "teach_5_step"
        }
      ]
    },
    "teach_5_step": {
      "id": "teach_5_step",
      "type": "CONTENT",
      "content": {
        "text": "The difference between shares is the difference between ratio-parts.\n\nThis avoids solving for both shares separately.",
        "avatarPersona": "TUTOR"
