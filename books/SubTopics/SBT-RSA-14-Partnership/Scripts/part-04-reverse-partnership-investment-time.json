    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "Equal profit can help recover a missing capital even when time differs.\n\nA has ₹12,000 for 10 months. B stays 8 months.\nEqual profit means 12,000×10 = B×8, so B = ₹15,000.",
