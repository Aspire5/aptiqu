    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "A joining-month question is really an unknown-time question.\n\nA invests ₹21,000 for 12 months. B invests ₹36,000 and profits are equal.\nSo B's time t satisfies 21,000×12 = 36,000×t.\nt = 7 months.\nB joined after 12 − 7 = 5 months.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "Notice the final conversion.\n\nThe equation gives months invested, not the joining month.\nJoining month = total business months − invested months.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
