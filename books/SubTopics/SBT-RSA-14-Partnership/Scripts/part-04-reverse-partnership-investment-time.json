    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "A known profit share can reveal an unknown capital.\n\nA invests ₹16,000 for 8 months. B stays 4 months and receives 2/7 of total profit.\nSo A:B profit = 5:2.\n16,000×8 : B×4 = 5 : 2.\nSolve to get B = ₹12,800.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
