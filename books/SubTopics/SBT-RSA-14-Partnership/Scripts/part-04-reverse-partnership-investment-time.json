    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Now reverse for time.\n\nA : B capital = 3 : 2, but profit = 3 : 4.\nTime ratio = (profit/capital):\nA : B = 3/3 : 4/2 = 1 : 2.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Profit ∝ capital×time also means time ∝ profit ÷ capital.\n\nIf a smaller investor earns more profit, that investor must have stayed longer.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
