    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Adding capital works the same way.\n\nB invests ₹8,000 for 5 months, then adds ₹4,000.\nFor the last 7 months B has ₹12,000.\nWeight = 8,000×5 + 12,000×7 = 124,000.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Do not add the extra money as if it existed for the earlier months.\n\nThe extra ₹4,000 earns only for the final 7 months.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
