    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Now let both partners change at the same milestone.\n\nA: ₹10,000 for 6 months, then ₹8,000 for 6.\nB: ₹8,000 for 6 months, then ₹12,000 for 6.\n\nWeights: A = 108k; B = 120k → 9 : 10.",
