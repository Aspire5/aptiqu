    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "This gives the same result as splitting the rent stage by stage, but it is faster.\n\nFor equal occupants, count how many months each person actually lived there.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
