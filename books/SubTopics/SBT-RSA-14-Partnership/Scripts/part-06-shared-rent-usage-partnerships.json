    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "Now combine conversion with time.\n\nIf 1 horse = 2 cow-units, then 5 horses for 4 months create 5×2×4 = 40 cow-month units.\nTen cows for 4 months also create 40.\nThey pay equal rent.",
