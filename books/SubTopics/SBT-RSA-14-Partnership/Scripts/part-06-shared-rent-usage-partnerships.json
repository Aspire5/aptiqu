{
  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Partnership is really a fairness rule: share a common result according to each person's contribution.\n\nThat same idea can split rent. For a pasture, contribution is animal-use × time. For a shared house, it is people × months.\n\nMoney-time becomes usage-time.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "Four farmers rent one pasture. If A grazes 20 cows for 3 months and B grazes 10 cows for 6 months, both use 60 cow-months.\n\nSo they should pay equal rent, even though A has more cows.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "For equal kinds of animals, cost weight = number × time.\n\nMore animals for less time can balance fewer animals for more time.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
