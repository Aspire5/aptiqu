    "teach_8": {
      "id": "teach_8",
      "type": "CONTENT",
      "content": {
        "text": "Capstone: staged occupancy and unequal usage can coexist.\n\nImagine A uses 2 units for 12 months. B uses 3 units for 8 months. C uses 4 units for 6 months.\nAll three weights are 24.\nEqual cost can come from very different usage stories.",
        "avatarPersona": "TUTOR"
