    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "House rent can change when people leave.\n\nA, B and C share a house for 4 months. Then C leaves. Five months later B leaves, and A stays for the final 3 months.\n\nEach person's occupancy-months:\nA=12, B=9, C=4.\nRent ratio = 12:9:4.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
