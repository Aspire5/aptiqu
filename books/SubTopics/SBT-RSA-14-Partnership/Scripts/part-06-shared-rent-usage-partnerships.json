    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Usage can be measured in hours instead of months.\n\nThree friends rent equipment for 6, 9 and 15 hours.\nRent ratio = 6:9:15 = 2:3:5.\n\nIf rent is ₹2,000, their shares are ₹400, ₹600 and ₹1,000.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "When every user consumes at the same rate, time alone is enough.\n\nThe unit may be hours, days or months — ratios do not care, as long as everyone uses the same unit.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
