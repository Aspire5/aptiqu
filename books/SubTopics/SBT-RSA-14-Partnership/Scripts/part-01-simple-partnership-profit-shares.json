    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "A profit ratio can also split a known total capital.\n\nIf all partners stay equally long and profits are 5 : 7 : 8, then capitals are 5 : 7 : 8 too.\nThe total is 20 parts.\n\nSo a ₹40,000 total capital would mean ₹10,000, ₹14,000 and ₹16,000.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_6_step"
        }
      ]
    },
    "teach_6_step": {
      "id": "teach_6_step",
      "type": "CONTENT",
      "content": {
        "text": "This is the same ratio used in reverse.\n\nKnown profit ratio → capital ratio.\nKnown total capital → value of one part.\nThen recover each investment.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
        }
      ]
    },
