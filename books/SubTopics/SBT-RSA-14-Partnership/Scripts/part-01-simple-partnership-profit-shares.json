    "teach_7": {
      "id": "teach_7",
      "type": "CONTENT",
      "content": {
        "text": "A loss is shared by the same rule as a profit.\n\nIf A and B invested in the ratio 4 : 3 and the business loses ₹3,500, the loss is not split equally.\nA bears 4/7 = ₹2,000; B bears 3/7 = ₹1,500.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_7_step"
        }
      ]
    },
    "teach_7_step": {
      "id": "teach_7_step",
      "type": "CONTENT",
      "content": {
        "text": "The direction changes — money goes out instead of in — but the ratio does not.\n\nCapital carries both reward and risk.\nSo use the same partnership ratio for total loss.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_7"
        }
      ]
    },
