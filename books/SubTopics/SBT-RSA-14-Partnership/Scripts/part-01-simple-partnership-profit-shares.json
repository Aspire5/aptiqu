    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "A known share can reveal the whole profit.\n\nIf A : B : C = 2 : 3 : 5 and B receives ₹2,400, then 3 parts = ₹2,400.\nOne part = ₹800.\nTotal 10 parts = ₹8,000.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "Do not jump from one partner's money straight to the total.\n\nFirst ask: how many ratio-parts does that partner own?\nThen find one part.\nThen rebuild the whole.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
