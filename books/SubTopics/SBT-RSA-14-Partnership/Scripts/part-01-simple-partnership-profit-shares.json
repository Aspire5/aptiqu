{
  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Two friends keep their money in the same business for the whole year. One puts in twice as much as the other.\n\nShould they split the profit equally? No — the money at risk is different.\n\nThis lesson turns that idea into a fast ratio method.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "A puts ₹3,000 into a business and B puts ₹5,000. Both stay for the full year.\n\nBecause their time is identical, the only difference is capital.\n\nProfit ratio = 3000 : 5000 = 3 : 5.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "Think of the total profit as 8 equal parts. A owns 3 parts and B owns 5.\n\nIf the profit were ₹8,000, A would get ₹3,000 and B ₹5,000.\n\nSame time → compare money only.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
    "q_1": {
      "id": "q_1",
      "type": "CHOICE",
      "content": {
        "text": "A invests ₹4,000 and B invests ₹6,000 for the same year. The profit is ₹2,500. What is A's share?",
        "avatarPersona": "TUTOR"
      },
      "input": {
        "type": "CHOICE",
        "options": [
          {
            "id": "a",
            "label": "₹1,500"
          },
          {
            "id": "b",
            "label": "₹625"
          },
          {
            "id": "c",
            "label": "₹2,000"
          },
          {
            "id": "d",
            "label": "₹1,000"
          }
        ]
      },
      "questionReference": {
        "mode": "INLINE",
        "inlineData": {
          "questionType": "PRACTICE",
          "prompt": "A invests ₹4,000 and B invests ₹6,000 for the same year. The profit is ₹2,500. What is A's share?",
