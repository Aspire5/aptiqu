    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "Capital relations can be turned into a ratio before any profit is split.\n\nSuppose A invests twice B, and C invests three times B.\nLet B = 1 part. Then A = 2 and C = 3.\n\nA : B : C = 2 : 1 : 3.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "The trick is to choose the simplest reference.\n\nIf several statements compare everyone to B, make B = 1 part.\nThen translate every sentence into parts before touching the profit.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
