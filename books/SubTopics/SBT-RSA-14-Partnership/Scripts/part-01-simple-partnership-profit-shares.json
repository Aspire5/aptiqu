    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "If time is the same, equal profits force equal capitals.\n\nWhy? Profit ratio = capital ratio.\nSo a profit ratio of 1 : 1 means a capital ratio of 1 : 1.\n\nThere is no hidden inverse rule here — the two ratios point in the same direction.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_5_step"
        }
      ]
    },
    "teach_5_step": {
      "id": "teach_5_step",
      "type": "CONTENT",
      "content": {
        "text": "This also works backward for any ratio.\n\nIf two partners receive profit in the ratio 7 : 5 and both stayed the whole year, their capitals were also 7 : 5.\n\nSame time makes profit a mirror of capital.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_5"
        }
      ]
    },
