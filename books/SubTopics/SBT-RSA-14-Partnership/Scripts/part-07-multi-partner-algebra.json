    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "A total-capital clue fixes the scale.\n\nIf A = B+₹4,000 and B = C+₹5,000 and total is ₹50,000, let C=x.\nThen B=x+5,000 and A=x+9,000.\n3x+14,000=50,000 → x=₹12,000.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Relations tell you the shape; the total tells you the size.\n\nKeep those jobs separate.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
