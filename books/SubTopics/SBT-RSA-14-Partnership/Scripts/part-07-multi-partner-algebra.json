    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "Later changes can determine the initial capital.\n\nSuppose A:B:C begin in ratio 3:5:7. After a year, A withdraws ₹6,000 and C adds ₹14,000. If the new ratio is known, let initial capitals be 3x,5x,7x and use the new relation to solve x.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "Do not mix the initial ratio with the later ratio.\n\nThey describe two different snapshots connected by the stated changes.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
