    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Profit shares can recover investments when time is equal.\n\nIf total capital is ₹14,000 and profit shares are ₹337.50, ₹1,125 and ₹637.50, the profit ratio simplifies to 9:30:17.\nThe same ratio is the capital ratio.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "The actual profit amounts may look messy, but ratios often simplify beautifully.\n\nAlways reduce before scaling to the total capital.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
