  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Hard partnership questions usually are not hard because of multiplication. They are hard because the relationships are hidden in sentences.\n\nThe cure is translation: every sentence becomes either a capital relation or a capital-time expression.\n\nOnce the story is translated, the algebra is small.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "A invests three times B. B invests two-thirds of C.\n\nLet C = 3 parts. Then B = 2 parts. A = 3×2 = 6 parts.\nSo A:B:C = 6:2:3.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "Choose the variable that removes fractions.\n\nIf B = 2/3 of C, making C = 3 parts makes B an integer immediately.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
    "q_1": {
