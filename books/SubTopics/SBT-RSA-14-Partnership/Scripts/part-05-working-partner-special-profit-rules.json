    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "The ordinary split can itself use capital-time.\n\nProfit = ₹20,000. A gets 10% as manager. A invested ₹10k for 12 months; B ₹15k for 8 months.\nThe weights are equal.\nRemainder ₹18,000 splits ₹9,000 each.\nA total = ₹11,000.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Special rule first. Partnership rule second.\n\nOnly after removing the manager amount do you calculate the ordinary shares.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
