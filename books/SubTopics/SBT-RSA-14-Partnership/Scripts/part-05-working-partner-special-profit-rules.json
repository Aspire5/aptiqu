{
  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Some partnership profits are split in two layers.\n\nA working partner may get a manager's cut first. A charity amount may leave first. Or part of the profit may be split equally before the rest follows capital.\n\nThe order matters more than the arithmetic.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "A is the working partner. Total profit = ₹10,000. A gets 20% for managing. The remaining profit is shared by capital A:B = 3:2.\n\nManager cut = ₹2,000.\nRemainder = ₹8,000.\nA's ordinary share = 3/5×8000 = ₹4,800.\nA total = ₹6,800.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "The working partner does not disappear from the ordinary split.\n\nUnless the question says otherwise, A gets:\nmanager amount + capital-based share of the remainder.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
