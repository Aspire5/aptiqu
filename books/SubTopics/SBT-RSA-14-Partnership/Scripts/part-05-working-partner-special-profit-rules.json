    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "Sometimes part of the profit is split equally, and the rest follows capital.\n\nProfit ₹800. Half is shared equally, so each gets ₹200.\nOther half ₹400 follows capital 3:5: first gets ₹150, second ₹250.\nTotals = ₹350 and ₹450.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "Treat the two pools separately.\n\nEqual pool ignores capital.\nCapital pool ignores the equal split.\nOnly add the two partner amounts at the end.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
