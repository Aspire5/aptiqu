    "teach_8": {
      "id": "teach_8",
      "type": "CONTENT",
      "content": {
        "text": "Capstone: use the share difference to recover the total profit.\n\nSuppose A gets 30% as manager. The remaining 70% is split A:B:C = 5:6:3.\nA's total fraction = 30% + 5/14 of 70% = 55%.\nB + C together = 45%.\nSo A exceeds B+C by 10% of total profit.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_8_step"
        }
      ]
    },
    "teach_8_step": {
      "id": "teach_8_step",
      "type": "CONTENT",
      "content": {
        "text": "If that excess is ₹200, then 10% of total = ₹200, so total profit = ₹2,000.\n\nThis is exactly the kind of layered algebra the chapter uses for a working partner.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_8"
        }
      ]
    },
