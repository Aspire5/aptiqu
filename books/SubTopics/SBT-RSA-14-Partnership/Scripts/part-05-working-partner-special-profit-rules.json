    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Charity works like a deduction before sharing.\n\nProfit ₹10,000; 5% goes to charity. A:B capital = 3:2.\nCharity = ₹500.\nRemainder = ₹9,500.\nA = 3/5×9500 = ₹5,700.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "A common trap is to calculate A's share from the full ₹10,000 and then subtract charity from A.\n\nWrong person. Charity comes out of the total first.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
