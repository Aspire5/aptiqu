    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "Now let the amount of work change.\n\nIf one job needs 600 worker-hours, a job twice as large needs 1200 worker-hours at the same efficiency.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
