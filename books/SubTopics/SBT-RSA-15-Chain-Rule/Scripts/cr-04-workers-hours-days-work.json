    "complete": {
      "id": "complete",
      "type": "CONTENT",
      "content": {
        "text": "You can now compress three moving quantities into one work budget.\n\nFor equal-efficiency workers:\nwork ∝ workers × hours/day × days.\n\nSame work means those products are equal. More work means the product must grow in the same factor.\n\nNext, not every worker will be equally efficient — so we will convert them into a common effort unit first.",
        "avatarPersona": "TUTOR"
      },
      "transitions": []
    }
