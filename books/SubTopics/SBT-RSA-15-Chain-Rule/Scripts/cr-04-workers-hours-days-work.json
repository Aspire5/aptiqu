    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "Work amount is direct with the work budget.\n\nMore work is not a reason to flip a ratio; it is a reason to scale the required worker-hours upward.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
