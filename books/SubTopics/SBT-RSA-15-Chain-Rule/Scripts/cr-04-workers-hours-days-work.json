    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "To find hours per day, divide total work by workers × days.\n\n6 workers at 8 hours/day for 15 days give 720 worker-hours. If 10 workers must finish in 9 days, hours/day = 720/(10×9)=8.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "This is useful when an exam asks for a longer shift instead of more people.\n\nThe work budget stays the same; only the missing factor changes.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
