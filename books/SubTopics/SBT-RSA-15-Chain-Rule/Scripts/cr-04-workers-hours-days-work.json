  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "A worker count alone does not tell us how much work gets done. A day length alone does not either.\n\nFor equal-efficiency workers, the useful unit is total worker-hours:\nworkers × hours per day × days.\n\nThink of it as the work budget.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "8 workers work 6 hours/day for 10 days. Their work budget is 8×6×10 = 480 worker-hours.\n\nIf 12 workers work 5 hours/day, days d must satisfy 12×5×d = 480.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "So d = 8 days.\n\nThis method avoids juggling several separate proportions. Everything becomes one effort total.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
    "q_1": {
