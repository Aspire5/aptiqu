    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "To find workers, keep the work budget fixed and divide by the new hours and days.\n\n18 workers × 6 h × 20 d = 2160 worker-hours.\nFor 12 days at 9 h/day: workers = 2160/(12×9) = 20.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "The answer can rise or fall depending on both changes. A shorter deadline asks for more workers; a longer daily shift asks for fewer. The product decides the balance.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
