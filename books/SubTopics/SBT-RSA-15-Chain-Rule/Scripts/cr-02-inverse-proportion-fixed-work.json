    "teach_8": {
      "id": "teach_8",
      "type": "CONTENT",
      "content": {
        "text": "Capstone: the safest inverse method is to name the invariant.\n\nInstead of memorising which way to flip a ratio, ask what product must stay unchanged. That turns a word problem into one equation.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_8_step"
        }
      ]
    },
    "teach_8_step": {
      "id": "teach_8_step",
      "type": "CONTENT",
      "content": {
        "text": "If the product should stay constant, doubling one factor halves the other. Tripling one factor makes the other one-third.\n\nThat is inverse proportion in one sentence.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_8"
        }
      ]
    },
