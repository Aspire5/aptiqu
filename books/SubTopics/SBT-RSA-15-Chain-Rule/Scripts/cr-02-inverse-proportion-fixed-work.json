    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "Meshed gears hide the same constant-product idea.\n\nIf a 12-tooth gear makes 20 turns, the contact count is 12×20 = 240 tooth-passes. A 30-tooth gear meshed with it makes 240/30 = 8 turns.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
