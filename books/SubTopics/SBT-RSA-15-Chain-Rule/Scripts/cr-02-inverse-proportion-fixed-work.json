    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "The same inverse rule works if time is measured in hours.\n\n12 pumps empty a reservoir in 10 hours. 15 identical pumps would take 12×10/15 = 8 hours.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "The unit does not matter. Minutes, hours, or days all behave the same as long as the job and worker efficiency stay fixed.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
