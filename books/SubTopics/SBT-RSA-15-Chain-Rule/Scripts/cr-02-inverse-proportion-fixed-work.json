    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Inverse proportion can reveal an original workforce.\n\nSuppose a job was planned for 18 days, but 4 workers were absent and the remaining team needed 21 days. Let the planned team be x.\nThen x×18 = (x−4)×21.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "The algebra comes from one fixed amount of work.\n\n18x = 21x − 84, so 3x = 84 and x = 28.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
