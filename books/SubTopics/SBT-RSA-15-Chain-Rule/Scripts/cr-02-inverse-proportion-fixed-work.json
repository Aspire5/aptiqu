    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "Speed and time are inverse when distance is fixed.\n\nA trip takes 6 hours at 60 km/h. The distance is 360 km. At 90 km/h, time = 360 ÷ 90 = 4 hours.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
