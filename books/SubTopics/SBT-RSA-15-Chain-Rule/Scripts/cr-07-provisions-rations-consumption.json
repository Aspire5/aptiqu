    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Reinforcements do the opposite.\n\n500 people have food for 27 days. After 3 days, 300 more arrive. Remaining stock = 500×24 = 12,000 person-days. New group = 800, so food lasts 15 more days.",
