      "id": "teach_8_step",
      "type": "CONTENT",
      "content": {
        "text": "Let original duration be y days. After 10 days, full group would have stock for y−10 days. The reduced group is 4/5 of original and lasts y days from that point in the book-style setup: x(y−10)=4x/5·y. Solve the timeline exactly as stated.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_8"
        }
      ]
    },
