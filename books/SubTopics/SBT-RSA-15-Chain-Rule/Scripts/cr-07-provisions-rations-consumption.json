    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "Medicine supply is the same model.\n\nIf each patient takes t tablets/day, p patients for d days consume tpd tablets.\nIf dosage rises 20% and patients fall by one-third, new daily use factor = 1.2 × 2/3 = 0.8.",
