    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "When people leave after some days, subtract the food already eaten first.\n\n400 people have food for 50 days. After 10 days, 320 remain. The stock left equals 400×40 person-days = 16,000.\nNow 320 people get 16,000/320 = 50 more days.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "The original 50 days includes the first 10 days already used.\n\nDo not multiply the smaller group by all 50 days.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
