{
  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "A food store is like a battery. Every person drains some amount each day.\n\nIf ration per person stays fixed, total stock can be measured in person-days:\npeople × days.\n\nIf ration changes too, use people × ration × days.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "500 people have food for 24 days. With no ration change, stock = 500×24 = 12,000 person-days.\n\nIf only 400 people remain, days = 12,000/400 = 30.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "The food amount stays fixed, so people and days are inverse.\n\nFewer consumers make the same stock last longer.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
    "q_1": {
