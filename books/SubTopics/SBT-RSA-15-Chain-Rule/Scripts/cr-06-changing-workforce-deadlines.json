    "complete": {
      "id": "complete",
      "type": "CONTENT",
      "content": {
        "text": "You can now handle mid-job changes without mixing the stages.\n\nCompute what stage 1 actually completes. Subtract from one whole job. Then size stage 2 for only the remainder.\n\nThis is the key to deadline-recovery and join/leave problems.\n\nNext, we use the same stage logic for food, rations, medicine and other consumable stocks.",
        "avatarPersona": "TUTOR"
      },
