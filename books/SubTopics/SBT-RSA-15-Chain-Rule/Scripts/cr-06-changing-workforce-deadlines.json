    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "Finishing early can reveal how much faster the team actually worked.\n\nA 360-piece job planned for x days is finished in x−1 days because 4 extra pieces are made per day.\nPlanned rate = 360/x; actual rate = 360/(x−1).",
        "avatarPersona": "TUTOR"
