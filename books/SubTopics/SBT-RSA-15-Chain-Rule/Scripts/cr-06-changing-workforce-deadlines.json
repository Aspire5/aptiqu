    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Now a true two-stage case.\n\n20 workers can finish a job in 30 days, so the job is 600 worker-days. After 10 days, they have done 200 worker-days; 400 remain.",
        "avatarPersona": "TUTOR"
