    "teach_8": {
      "id": "teach_8",
      "type": "CONTENT",
      "content": {
        "text": "Capstone: every stage should add to exactly one whole job.\n\nThat check catches the most common error — accidentally applying the second team to the full job instead of only the remainder.",
        "avatarPersona": "TUTOR"
