    "teach_6_step": {
      "id": "teach_6_step",
      "type": "CONTENT",
      "content": {
        "text": "The difference of rates is 4.\n360/(x−1) − 360/x = 4.\nThis becomes x² − x − 90 = 0, so x=10 and actual time=9 days.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_6"
        }
      ]
    },
