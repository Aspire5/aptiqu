      "id": "teach_8_step",
      "type": "CONTENT",
      "content": {
        "text": "When possible, express stage work as fractions of the original total. If stage 1 does 40%, stage 2 must account for exactly 60% — no more, no less.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_8"
        }
      ]
