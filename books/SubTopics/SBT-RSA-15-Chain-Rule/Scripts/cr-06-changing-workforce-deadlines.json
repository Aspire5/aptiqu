  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "A workforce change in the middle of a job breaks one long proportion into stages.\n\nThe first team has already done some work. The second team should never be asked to do the full job again.\n\nStage 1 → work done. Stage 2 → work remaining.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "A team of 30 workers is meant to finish in 20 days. If 5 are absent from the start, daily capacity falls from 30 to 25.\n\nTime becomes 20×30/25 = 24 days — a 4-day delay.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "This is still one stage because the absence exists from day 1.\n\nIf the workforce changes later, we must split the timeline.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
