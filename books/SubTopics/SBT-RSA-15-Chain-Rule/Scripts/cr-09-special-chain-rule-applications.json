    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Similar shadows give a height-to-shadow constant.\n\nA 12 m pole casts an 8 m shadow. At the same moment, height/shadow = 12/8 = 3/2. A 20 m shadow belongs to a 30 m object.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "The 'same time of day' clue keeps the sun angle fixed.\n\nThat makes height directly proportional to shadow length.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
