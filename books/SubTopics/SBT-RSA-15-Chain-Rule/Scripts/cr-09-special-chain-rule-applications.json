    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "Gears are inverse because tooth contact is the invariant.\n\nA 10-tooth gear making 30 turns creates 300 tooth-passes. A 25-tooth gear makes 300/25 = 12 turns.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
