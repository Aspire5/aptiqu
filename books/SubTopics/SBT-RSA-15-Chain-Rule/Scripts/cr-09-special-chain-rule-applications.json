    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "A scale written as 1:n needs matching units.\n\nIf 1 cm represents 250 km, convert 250 km to centimetres: 250 × 100,000 = 25,000,000 cm.\nScale = 1 : 25,000,000.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "The large number is not a new formula — it comes from unit conversion.\n\n1 km = 100,000 cm.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
