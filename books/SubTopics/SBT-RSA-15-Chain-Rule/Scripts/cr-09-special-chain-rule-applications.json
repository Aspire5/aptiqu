    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "Photo enlargement is another fixed shape ratio.\n\nIf a 3-inch side becomes 5 inches, every matching side is multiplied by 5/3. A 6-inch side becomes 10 inches.",
        "avatarPersona": "TUTOR"
