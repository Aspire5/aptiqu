    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "Recipes combine direct scaling with unit conversion.\n\nIf 4 servings need 1.5 teaspoons, then 12 servings need 4.5 teaspoons. If 3 teaspoons = 1 tablespoon, that is 1.5 tablespoons.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_5_step"
        }
      ]
    },
    "teach_5_step": {
      "id": "teach_5_step",
      "type": "CONTENT",
      "content": {
        "text": "Keep the proportion and the unit conversion as two separate thoughts.\n\nFirst scale the amount; then convert units.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_5"
        }
      ]
    },
