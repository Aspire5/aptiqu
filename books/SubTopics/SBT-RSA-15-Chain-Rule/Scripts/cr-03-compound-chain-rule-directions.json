    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Now target = days.\n\n12 workers working 8 hours/day need 15 days. If workers rise to 18 but hours/day fall to 6:\nMore workers → fewer days: inverse.\nFewer hours/day → more days: inverse.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Days = 15 × 12/18 × 8/6 = 13⅓.\n\nNotice both changes pull in opposite numerical directions, so we decide each relationship separately.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
