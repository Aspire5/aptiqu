    "teach_7": {
      "id": "teach_7",
      "type": "CONTENT",
      "content": {
        "text": "Two completed-job statements can reveal the conversion.\n\nSuppose 2 men + 7 boys finish in 14 days, while 3 men + 8 boys finish in 11 days. Because the work is equal, their daily rates satisfy 14(2m+7b)=11(3m+8b).",
        "avatarPersona": "TUTOR"
