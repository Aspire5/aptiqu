    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Now mix the groups.\n\nSuppose 3 men = 5 women. Then 6 men = 10 women.\nSo 6 men + 8 women = 18 women-equivalents.",
        "avatarPersona": "TUTOR"
