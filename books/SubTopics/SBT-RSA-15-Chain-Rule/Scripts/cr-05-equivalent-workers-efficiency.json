    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Mixed groups and time now become simple.\n\nIf 4 men = 6 women, then 8 men + 6 women = 18 women-equivalents. If 12 women alone need 15 days, 18 equivalent women need 12×15/18 = 10 days.",
        "avatarPersona": "TUTOR"
