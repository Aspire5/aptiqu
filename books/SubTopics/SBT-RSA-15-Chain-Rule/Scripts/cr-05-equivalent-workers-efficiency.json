    "teach_6_step": {
      "id": "teach_6_step",
      "type": "CONTENT",
      "content": {
        "text": "Faster worker = smaller time = larger rate.\n\nAlways invert times before turning them into efficiency ratios.",
        "avatarPersona": "TUTOR"
