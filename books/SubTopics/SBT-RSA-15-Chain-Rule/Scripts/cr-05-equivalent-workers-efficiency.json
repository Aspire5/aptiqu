    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "Efficiency can be hidden in time statements.\n\nIf one woman needs 8 hours for the work that one man needs 6 hours for, rate is inverse to time.\nMan : woman rate = 1/6 : 1/8 = 4 : 3.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
