    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Efficiency acts like an extra output multiplier.\n\nTwo machines at 90% efficiency are equivalent to 1.8 perfect-machine units. Three at 80% are equivalent to 2.4 perfect-machine units.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "For the same output, lower efficiency requires more machine-hours.\nFor output itself, efficiency is direct.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
