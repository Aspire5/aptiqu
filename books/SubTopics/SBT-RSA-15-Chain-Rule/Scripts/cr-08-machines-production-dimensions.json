  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Machines and construction problems often look crowded because both sides have several factors.\n\nThe cure is compression:\nresource capacity = machines or workers × time × efficiency.\njob size = output units or physical dimensions.\n\nCompare those two packages.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "6 identical machines produce 180 bottles per hour. Per machine, that is 30 bottles/hour.\n\n15 machines at the same rate produce 15×30 = 450 bottles/hour. In half an hour, they produce 225 bottles.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "Machine count and operating time are both direct with output.\n\nIf one rises and the other falls, multiply both scale factors.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
    "q_1": {
      "id": "q_1",
