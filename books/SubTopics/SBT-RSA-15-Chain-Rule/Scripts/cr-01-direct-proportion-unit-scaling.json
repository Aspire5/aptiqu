    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "Sometimes an entire bundle is scaled, not its individual parts.\n\nIf 4 fans and 6 lamps together cost ₹8,000, then 8 fans and 12 lamps are exactly twice the bundle. Cost = ₹16,000.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_5_step"
        }
      ]
    },
    "teach_5_step": {
      "id": "teach_5_step",
      "type": "CONTENT",
      "content": {
        "text": "You do not need the separate price of a fan or a lamp when every component is multiplied by the same factor.\n\nSpot the common multiplier first.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_5"
        }
      ]
    },
    "q_5": {
