    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "Direct proportion can scale a part of a job too.\n\nIf a worker completes 3/5 of a job in 12 days at a steady rate, then 1/5 takes 4 days. The remaining 2/5 takes 8 more days.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "The fraction of work and the time move together when the rate stays fixed.\n\nDo not restart from the full job. Scale only the part still left.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
