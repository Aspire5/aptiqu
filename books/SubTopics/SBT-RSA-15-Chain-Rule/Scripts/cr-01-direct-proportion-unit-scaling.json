    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Dozens are only a unit conversion hiding inside the proportion.\n\n3.5 dozen eggs means 3.5 × 12 = 42 eggs. If 42 eggs cost ₹252, then each egg costs ₹6.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Always make the units match before comparing quantities.\n\nDozen with dozen is fine.\nDozen with individual pieces is not.\nConvert first; scale second.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
