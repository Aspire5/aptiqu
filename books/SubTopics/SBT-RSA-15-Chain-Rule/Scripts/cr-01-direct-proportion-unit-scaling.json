    "teach_6": {
      "id": "teach_6",
      "type": "CONTENT",
      "content": {
        "text": "With several direct factors, every increase pushes the output up.\n\nIf 5 workers collect 60 kg in 3 days, then 10 workers in 6 days have twice the workers and twice the days. Output becomes 2 × 2 = 4 times: 240 kg.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
