    "teach_8": {
      "id": "teach_8",
      "type": "CONTENT",
      "content": {
        "text": "Capstone: predict first, calculate second.\n\nA factory's output is directly proportional to both machines and operating time. If both rise, output must rise. If one is halved while the other doubles, they cancel.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_8_step"
        }
      ]
    },
    "teach_8_step": {
      "id": "teach_8_step",
      "type": "CONTENT",
      "content": {
        "text": "This prediction is a powerful error check.\n\nIf your final number moves opposite to the combined scale factors, inspect the setup before accepting it.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_8"
        }
      ]
    },
