    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "Length and weight can also share a constant rate.\n\nIf 9 m of uniform wire weighs 27 kg, then each metre weighs 3 kg.\nSo 14 m weighs 42 kg.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "Uniform is the key word. It tells us every metre behaves like every other metre.\n\nMore length → more weight, in the same factor.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
