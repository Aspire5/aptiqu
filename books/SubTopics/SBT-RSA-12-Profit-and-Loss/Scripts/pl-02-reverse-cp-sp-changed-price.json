    "remedy_1": {
      "id": "remedy_1",
      "type": "CONTENT",
      "content": {
        "text": "Let's repair this one.\n\nA common slip is to subtract another 15% from the selling price. The loss already happened; ₹1360 is the 85% amount left.\n\nC.P. = 1360 × 100/85 = ₹1600.\n\nNow use the same idea with fresh values.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "retry_1"
        }
