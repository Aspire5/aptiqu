    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "A fixed rupee gap can reveal the cost immediately when it changes one percentage outcome into another. The rupee gap equals the percentage-point gap of the same C.P.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "At 20% loss, S.P. = 80% of C.P.\nAt 5% profit, S.P. = 105% of C.P.\nThe gap is 25% of C.P.\nIf the price gap is ₹100, C.P. = 100/0.25 = ₹400.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
