{
  "schemaVersion": 1,
  "scriptId": "pl-11-false-weights-measures-adulteration",
  "sourceType": "MANUAL",
  "metadata": {
    "title": "False Weights, Measures and Adulteration",
    "description": "See how short weights, false scales and free adulterants change the trader’s real cost per delivered unit.",
    "teachingApproach": "Start with the actual quantity delivered and actual cost rather than memorized dishonest-dealer formulas. Move from short weight to false length, nominal profit/loss plus short measure, cheating on both sides, and free-water adulteration.",
    "targetDurationMinutes": 28,
    "sourceScope": "R.S. Aggarwal, Quantitative Aptitude for Competitive Examinations, Chapter 12, Profit and Loss. Approved scope: Teach dishonest-dealer questions from first principles before shortcuts. If a trader charges for 1 kg but delivers 960 g, compare money received for 1 kg with the cost of only 960 g. Cover false metre scales, nominal profit or loss combined with short weight, cheating while both buying and selling, and milk/water adulteration where water has zero cost. Show the book’s shortcut formulas only after the 100-unit model makes them intuitive. Check all gains against actual cost delivered."
  },
  "startNodeId": "start",
  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Let's learn false weights, measures and adulteration.\n\nA dealer charges for 1 kg but hands over only 900 g. Even if the quoted price is ‘cost price’, the dealer still makes a profit because the quantity delivered cost less.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "A false-weight dealer may charge for 1 kg but deliver less. The customer pays the price of 1 kg; the dealer pays the cost of only what was actually delivered.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "Let true C.P. of 1 kg be ₹100. Dealer charges ₹100 but gives 800 g.\nCost of 800 g = ₹80.\nProfit = ₹20 on ₹80 → 25%.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
    "q_1": {
      "id": "q_1",
      "type": "CHOICE",
      "content": {
        "text": "A dealer sells at cost price but gives 900 g as 1 kg. What is the gain percent?",
        "avatarPersona": "TUTOR"
      },
      "input": {
        "type": "CHOICE",
        "options": [
          {
            "id": "a",
            "label": "10%"
          },
          {
            "id": "b",
            "label": "9%"
          },
          {
            "id": "c",
            "label": "11.11%"
          },
          {
            "id": "d",
            "label": "12.5%"
          }
        ]
      },
      "questionReference": {
        "mode": "INLINE",
        "inlineData": {
          "questionType": "PRACTICE",
          "prompt": "A dealer sells at cost price but gives 900 g as 1 kg. What is the gain percent?",
          "options": [
            {
              "id": "a",
