    "remedy_1": {
      "id": "remedy_1",
      "type": "CONTENT",
      "content": {
        "text": "Let's repair this one.\n\nA common trap is saying 10% because the weight is short by 10%. Profit percentage is measured on the ₹90 cost actually delivered.\n\nGain % = 10/90 × 100 = 11.11%.\n\nNow use the same idea with fresh values.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "retry_1"
        }
      ]
    },
