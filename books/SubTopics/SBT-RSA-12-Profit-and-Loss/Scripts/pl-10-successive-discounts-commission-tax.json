{
  "schemaVersion": 1,
  "scriptId": "pl-10-successive-discounts-commission-tax",
  "sourceType": "MANUAL",
  "metadata": {
    "title": "Successive Discounts, Commission, Tax and Net Price",
    "description": "Handle several price layers such as two discounts, commission, sales tax/VAT and extra charges without mixing their bases.",
    "teachingApproach": "Extend the price ladder to several layers without mixing their bases. Build successive discounts, missing discounts, commission and tax/VAT, then combine the multipliers in capstones while keeping commercial profit separate from tax.",
    "targetDurationMinutes": 28,
    "sourceScope": "R.S. Aggarwal, Quantitative Aptitude for Competitive Examinations, Chapter 12, Profit and Loss. Approved scope: Teach successive discounts as multipliers rather than addition, find the single equivalent discount, recover one missing discount, and combine markup with trade/cash discount. Add commission as a deduction from retail price when the source uses it, and sales tax/VAT as a layer on the selling price where applicable. Cover final bill versus pre-tax S.P., and questions asking what profit would have been without a discount. Keep each percentage attached to its own base and use a price ladder to prevent base confusion."
  },
  "startNodeId": "start",
  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Let's learn successive discounts, commission, tax and net price.\n\nA shop offers 20% off and then another 25% off. The total discount is not 45%, because the second cut is taken from an already smaller price.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "Two discounts are taken one after the other. The second discount acts on the already reduced price, so percentages multiply rather than add.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "M.P. ₹1000.\n10% off → ₹900.\nThen 20% off → ₹720.\nEquivalent discount = 28%, not 30%.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
