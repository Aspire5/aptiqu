{
  "schemaVersion": 1,
  "scriptId": "pl-05-combined-lots-partial-sales",
  "sourceType": "MANUAL",
  "metadata": {
    "title": "Combined Lots and Partial Sales",
    "description": "Find overall profit or loss when different parts of the same stock are sold at different rates or percentages.",
    "teachingApproach": "Replace percentage averaging with rupee contributions. Begin with two unequal-cost items, then cost fractions, unknown cost splits, remaining-stock targets and multi-part capstones. The learner repeatedly totals cost, totals sales and only then forms the overall percentage.",
    "targetDurationMinutes": 28,
    "sourceScope": "R.S. Aggarwal, Quantitative Aptitude for Competitive Examinations, Chapter 12, Profit and Loss. Approved scope: Teach that overall profit is based on total cost, not the average of percentage labels unless the cost bases are equal. Cover two goods with different cost prices and gain/loss rates, a fraction of a consignment sold at one rate and the rest at another, finding an unknown cost split from overall profit, and finding what rate the remaining stock must fetch to reach a target overall profit. Include same-total-cost and unequal-cost cases, plus damaged or leftover stock where appropriate. Use contribution tables mentally: cost part → selling multiplier → sale amount → total."
  },
  "startNodeId": "start",
  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Let's learn combined lots and partial sales.\n\nOne product earns 25% profit while another loses 10%. Can we simply average those percentages? Only if the money invested in both is the same.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "When two items have different costs, do not average their profit percentages. Convert each percentage into rupees, then combine.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "Item A: C.P. ₹1000, gain 20% → S.P. ₹1200.\nItem B: C.P. ₹2000, loss 10% → S.P. ₹1800.\nTotal C.P. ₹3000, total S.P. ₹3000 → no gain, no loss.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
    "q_1": {
      "id": "q_1",
      "type": "CHOICE",
      "content": {
        "text": "A costs ₹800 and is sold at 25% profit. B costs ₹1200 and is sold at 10% loss. Overall result?",
