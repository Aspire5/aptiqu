    },
    "remedy_1": {
      "id": "remedy_1",
      "type": "CONTENT",
      "content": {
        "text": "Let's repair this one.\n\nA common slip is to use the selling price itself as the profit. Profit is only the difference between S.P. and C.P.\n\nS.P. is higher, so profit = 575 − 500 = ₹75.\n\nNow use the same idea with fresh values.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "retry_1"
        }
      ]
    },
