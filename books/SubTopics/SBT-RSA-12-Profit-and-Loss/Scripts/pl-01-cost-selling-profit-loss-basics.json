    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "Now reverse the direction. A trader pays ₹720 and sells for ₹630. Money came back below the cost, so the difference is a loss.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "Loss = C.P. − S.P.\n= 720 − 630\n= ₹90\n\nUse this subtraction only when S.P. is lower than C.P.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
