    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "A ₹60 profit means something different on a ₹300 item and a ₹1200 item. So profit percentage compares the profit with the cost that created it.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
    },
    "teach_3_step": {
      "id": "teach_3_step",
      "type": "CONTENT",
      "content": {
        "text": "If C.P. = ₹300 and profit = ₹60:\n\nProfit % = 60/300 × 100\n= 20%\n\nThe base is C.P., not S.P.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
        }
      ]
    },
