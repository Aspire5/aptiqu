    "teach_5": {
      "id": "teach_5",
      "type": "CONTENT",
      "content": {
        "text": "Some questions make the numerical profit percentage equal to the rupee C.P. This creates a small equation, not a new formula.",
        "avatarPersona": "TUTOR"
      },
