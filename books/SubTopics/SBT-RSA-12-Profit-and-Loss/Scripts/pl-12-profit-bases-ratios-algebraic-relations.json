    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "If selling price is doubled, profit does not double in the same way because C.P. stays fixed. Translate both profits as distances from C.P.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "Original S.P. = S, C.P. = C. Profit = S−C.\nIf 2S makes profit three times: 2S−C = 3(S−C).\nSolving gives S = 2C, so original profit = 100%.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
