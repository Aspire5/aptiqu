    "remedy_1": {
      "id": "remedy_1",
      "type": "CONTENT",
      "content": {
        "text": "Let's repair this one.\n\nA common mistake is repeating 25%. The statement's 25% uses S.P. as base, but standard profit % uses C.P.\n\nProfit % on C.P. = 25/75 ×100 = 33⅓%.\n\nNow use the same idea with fresh values.",
        "avatarPersona": "TUTOR"
