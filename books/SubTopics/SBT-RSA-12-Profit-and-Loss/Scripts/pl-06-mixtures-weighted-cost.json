    "teach_3": {
      "id": "teach_3",
      "type": "CONTENT",
      "content": {
        "text": "For a ratio mixture, convert the ratio into cost contributions. Three parts of a costly item count three times as much quantity as one part.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_3_step"
        }
      ]
