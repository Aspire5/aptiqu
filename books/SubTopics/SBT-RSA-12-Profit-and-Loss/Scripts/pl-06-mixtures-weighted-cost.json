      "type": "CONTENT",
      "content": {
        "text": "Tea A ₹100/kg, tea B ₹60/kg in ratio 3:2.\nCost of 5 kg model = 3×100 + 2×60 = ₹420.\nMean = 420/5 = ₹84/kg.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_3"
