{
  "schemaVersion": 1,
  "scriptId": "pl-13-data-sufficiency-profit-loss",
  "sourceType": "MANUAL",
  "metadata": {
    "title": "Data Sufficiency for Profit and Loss",
    "description": "Decide whether one statement, the other, both, or neither give enough information to determine a profit-and-loss answer.",
    "teachingApproach": "Teach sufficiency as a uniqueness test: I alone, reset, II alone, then combine only when needed. Include either-alone, redundant, insufficient, marked-price and three-statement patterns, with the smallest sufficient information set as the goal.",
    "targetDurationMinutes": 30,
    "sourceScope": "R.S. Aggarwal, Quantitative Aptitude for Competitive Examinations, Chapter 12, Profit and Loss. Approved scope: Teach data sufficiency as a uniqueness test, not a full-calculation contest. Use C.P./S.P./profit questions, ratios, marked price and discount, mixture selling price, quantity equivalences, and three-statement variants shaped like the chapter’s separate data-sufficiency exercise. Learners should test statement I alone, reset, test statement II alone, then combine only if needed. Include cases where a statement is merely a consequence of another, where either statement alone works, where both are required, and where even all supplied data are insufficient."
  },
  "startNodeId": "start",
  "nodes": {
    "start": {
      "id": "start",
      "type": "CONTENT",
      "content": {
        "text": "Let's learn data sufficiency for profit and loss.\n\nA data-sufficiency question is not asking you to calculate as much as possible. It asks one thing: do the given facts force one unique answer?",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1"
        }
      ]
    },
    "teach_1": {
      "id": "teach_1",
      "type": "CONTENT",
      "content": {
        "text": "Data sufficiency asks a different question: can the answer be determined uniquely? Do not rush to solve everything. Test each statement by itself.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_1_step"
        }
      ]
    },
    "teach_1_step": {
      "id": "teach_1_step",
      "type": "CONTENT",
      "content": {
        "text": "Question: What is profit %?\nI. C.P. = ₹200.\nII. S.P. = ₹240.\nI alone cannot compare cost with sale. II alone cannot either. Together they give 20% profit.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_1"
        }
      ]
    },
    "q_1": {
      "id": "q_1",
      "type": "CHOICE",
      "content": {
        "text": "What is the profit percent? I. C.P. = ₹500. II. S.P. = ₹600. Which data are sufficient?",
        "avatarPersona": "TUTOR"
      },
      "input": {
        "type": "CHOICE",
        "options": [
          {
            "id": "a",
            "label": "I alone"
          },
          {
            "id": "b",
            "label": "II alone"
          },
          {
            "id": "c",
            "label": "Neither even together"
          },
          {
            "id": "d",
            "label": "Both together only"
          }
        ]
      },
      "questionReference": {
        "mode": "INLINE",
        "inlineData": {
          "questionType": "PRACTICE",
          "prompt": "What is the profit percent? I. C.P. = ₹500. II. S.P. = ₹600. Which data are sufficient?",
          "options": [
