    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "If C.P. of one quantity equals S.P. of another, pretend each cost unit is ₹1. Then the item counts themselves create the ratio.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "C.P. of 20 articles = S.P. of 16 articles.\nLet C.P. each = ₹1.\nC.P. of 20 = ₹20, so S.P. each = 20/16 = ₹1.25.\nProfit = 25%.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
