    "teach_4": {
      "id": "teach_4",
      "type": "CONTENT",
      "content": {
        "text": "Some questions say the profit on many items equals the selling price of a few items. Move that ‘profit part’ away from total S.P. to uncover total C.P.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_4_step"
        }
      ]
    },
    "teach_4_step": {
      "id": "teach_4_step",
      "type": "CONTENT",
      "content": {
        "text": "S.P. of 30 m − C.P. of 30 m = S.P. of 10 m.\nSo C.P. of 30 m = S.P. of 20 m.\nThus S.P.:C.P. per metre = 30:20 = 3:2 → 50% profit.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_4"
        }
      ]
    },
