    "remedy_1": {
      "id": "remedy_1",
      "type": "CONTENT",
      "content": {
        "text": "Let's repair this one.\n\nA common slip is comparing the item counts directly. Convert both rates to the same number of items first.\n\nFor 20 oranges, C.P. = ₹48 and S.P. = ₹60. Profit = ₹12 = 25% of ₹48.\n\nNow use the same idea with fresh values.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "retry_1"
        }
      ]
    },
