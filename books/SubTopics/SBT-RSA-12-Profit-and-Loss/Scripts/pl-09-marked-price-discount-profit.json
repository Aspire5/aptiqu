    "remedy_1": {
      "id": "remedy_1",
      "type": "CONTENT",
      "content": {
        "text": "Let's repair this one.\n\nA common slip is comparing the discount percentage directly with the profit percentage. They use different bases.\n\nS.P. = ₹960. Profit = ₹160 on ₹800 = 20%.\n\nNow use the same idea with fresh values.",
        "avatarPersona": "TUTOR"
