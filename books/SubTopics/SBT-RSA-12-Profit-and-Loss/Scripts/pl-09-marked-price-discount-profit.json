    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "If M.P. is a percentage above C.P., use a price ladder. Start from C.P. = 100, mark it up, then discount the marked amount.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "teach_2_step"
        }
      ]
    },
    "teach_2_step": {
      "id": "teach_2_step",
      "type": "CONTENT",
      "content": {
        "text": "C.P. ₹100. Marked 50% above → ₹150. Discount 20% → S.P. ₹120.\nSo actual profit = 20%.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
        {
          "targetNodeId": "q_2"
        }
      ]
    },
