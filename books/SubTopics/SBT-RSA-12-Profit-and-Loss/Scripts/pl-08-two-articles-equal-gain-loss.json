    "teach_2": {
      "id": "teach_2",
      "type": "CONTENT",
      "content": {
        "text": "For equal selling prices and equal opposite rates x%, the book gives a shortcut: loss % = x²/100. The 100-based model explains why.",
        "avatarPersona": "TUTOR"
      },
