      "type": "CONTENT",
      "content": {
        "text": "At ±10% with equal S.P., loss = 10²/100 = 1%.\nAt ±25%, loss = 25²/100 = 6.25%.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
