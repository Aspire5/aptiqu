    "hcf_after_check": {
      "id": "hcf_after_check",
      "type": "CONTENT",
      "content": {
        "text": "Notice something useful: the numerator H.C.F. became smaller, while the denominator L.C.M. became larger.\n\nThat is exactly what the book's H.C.F. formula asks us to do.\n\nNow let's make sure the same rule works when there are four fractions with a different set of values.",
        "avatarPersona": "TUTOR"
      },
      "transitions": [
